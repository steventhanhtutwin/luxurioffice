<% const format=v=>v==null?'—':Number(v).toLocaleString('en-US',{maximumFractionDigits:3}),productTypes=[['finished-goods','Finished Goods'],['raw-oil','Raw Oil'],['raw-materials','Raw Materials'],['operational-supplies','Operational Supplies']],unitChoices=[...new Set(['pcs','kg','g','box','pack','roll','pair','set','ml','L',item.unit])]; %>
<div class="iid-topbar"><a class="iid-back" href="<%= returnUrl %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h13"/></svg> Inventory Items</a><span>Item Details</span></div>
<article class="iid-product" data-ii-product>
<header class="iid-header"><div class="iid-identity"><div class="iid-badges"><span class="ii-type <%= item.type_id %>"><%= item.type_name %></span><span class="ii-code"><%= item.code %></span></div><p class="iid-eyebrow">PRODUCT</p><h1><%= item.name %></h1><p class="iid-category"><%= item.category||'—' %><% if(item.size_label){ %><span> · <%= item.size_label %></span><% } %></p></div><div class="iid-metrics"><div class="iid-stock"><span>On Hand</span><strong><%= format(item.closing_qty) %><small><%= item.unit %></small></strong><p>Main Warehouse</p></div><div class="iid-metric"><span class="iid-metric-icon" aria-hidden="true">↻</span><div><span>Reordering Rules</span><strong>—</strong></div></div><div class="iid-metric iid-flow"><span class="iid-metric-icon" aria-hidden="true">⇄</span><div><span>In / Out</span><p><span>In</span><strong><%= format(item.stock_in) %> <small><%= item.unit %></small></strong></p><p><span>Out</span><strong><%= format(item.stock_out) %> <small><%= item.unit %></small></strong></p></div></div></div></header>
<section class="iid-channels" aria-label="Sales channels"><div class="iid-channel-options"><label class="iid-channel"><input type="checkbox" data-ii-channel="online"><span class="iid-channel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/></svg></span><span><strong>Online</strong><small>Online sales channels</small></span><span class="iid-channel-check" aria-hidden="true">✓</span></label><label class="iid-channel"><input type="checkbox" data-ii-channel="pos"><span class="iid-channel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 4h18v12H3zM8 21h8M12 16v5M6 7h12"/></svg></span><span><strong>Point of Sale</strong><small>Retail shop sales</small></span><span class="iid-channel-check" aria-hidden="true">✓</span></label></div></section>
<div class="iid-tabs" role="tablist" aria-label="Item information"><button type="button" role="tab" id="iid-tab-general" aria-controls="iid-panel-general" aria-selected="true" data-ii-tab="general">General Information</button><button type="button" role="tab" id="iid-tab-sales" aria-controls="iid-panel-sales" aria-selected="false" tabindex="-1" data-ii-tab="sales">Sales Channels</button><button type="button" role="tab" id="iid-tab-inventory" aria-controls="iid-panel-inventory" aria-selected="false" tabindex="-1" data-ii-tab="inventory">Inventory</button></div>
<section class="iid-panel" id="iid-panel-general" role="tabpanel" aria-labelledby="iid-tab-general" data-ii-panel="general"><div class="iid-form-columns"><div class="iid-form-section"><h2>General Information</h2><fieldset class="iid-product-types"><legend>Product Type</legend><% for(const [value,label] of productTypes){ %><label><input type="radio" name="product_type" value="<%= value %>" <%= item.type_id===value?'checked':'' %>><span><%= label %></span></label><% } %></fieldset><dl class="iid-fields iid-single"><div><dt>Quantity On Hand</dt><dd><%= format(item.closing_qty) %> <%= item.unit %></dd></div><div><dt>Size</dt><dd><%= item.size_label||'—' %></dd></div></dl></div><div class="iid-form-section"><h2>Pricing &amp; Taxes</h2><div class="iid-input-rows"><label for="iid-sales-price">Sales Price</label><div class="iid-input-unit"><input id="iid-sales-price" name="sales_price" type="number" min="0" step="0.01" placeholder="0.00"><span>MMK</span></div><label for="iid-sales-taxes">Sales Taxes</label><div class="iid-input-unit"><input id="iid-sales-taxes" name="sales_taxes" type="number" min="0" max="100" step="0.01" placeholder="0"><span>%</span></div><label for="iid-cost">Cost</label><div class="iid-input-unit"><input id="iid-cost" name="cost" type="number" min="0" step="0.01" placeholder="0.00"><span>MMK</span></div><label for="iid-purchase-taxes">Purchase Taxes</label><div class="iid-input-unit"><input id="iid-purchase-taxes" name="purchase_taxes" type="number" min="0" max="100" step="0.01" placeholder="0"><span>%</span></div><label for="iid-category">Category</label><select id="iid-category" name="category"><option value="">Select Category</option><% for(const [value,label] of productTypes){ %><option value="<%= value %>" <%= item.type_id===value?'selected':'' %>><%= label %></option><% } %></select></div></div></div><div class="iid-notes"><label for="iid-internal-note">Internal Notes</label><textarea id="iid-internal-note" name="internal_note" rows="3" placeholder="Internal notes for your team…"><%= item.note||'' %></textarea></div></section>
<section class="iid-panel" id="iid-panel-sales" role="tabpanel" aria-labelledby="iid-tab-sales" data-ii-panel="sales" hidden><div class="iid-form-columns"><div><section class="iid-form-section"><h2 class="iid-section-rule">Point of Sale</h2><div class="iid-input-rows"><label for="iid-pos-category">Category</label><select id="iid-pos-category" name="pos_category"><option value="">Select POS Category</option><% if(item.category){ %><option><%= item.category %></option><% } %></select><label for="iid-pos-color">Color</label><div class="iid-color-field"><input id="iid-pos-color" name="pos_color" type="color" value="#ffffff" aria-label="POS Color"></div></div></section><section class="iid-form-section iid-upsell"><h2 class="iid-section-rule">Upsell &amp; Cross-sell</h2><div class="iid-input-rows"><label for="iid-optional-products">POS Optional Products</label><select id="iid-optional-products" name="pos_optional_products"><option value="">Recommend when adding to cart</option></select></div></section></div><section class="iid-form-section"><h2 class="iid-section-rule"><label for="iid-description">Description</label></h2><textarea class="iid-description" id="iid-description" name="description" rows="8" placeholder="Information about your product."></textarea></section></div></section>
<section class="iid-panel" id="iid-panel-inventory" role="tabpanel" aria-labelledby="iid-tab-inventory" data-ii-panel="inventory" hidden><h2>Inventory</h2><dl class="iid-fields"><% for(const [label,value] of [['Warehouse','Main Warehouse'],['Opening',format(item.opening_qty)],['Stock In',format(item.stock_in)],['Stock Out',format(item.stock_out)],['On Hand',format(item.closing_qty)],['Reorder Qty',format(item.reorder_qty)],['Stock Status',item.status]]){ %><div><dt><%= label %></dt><dd><%= value %></dd></div><% } %></dl><section class="iid-logistics"><h2 class="iid-section-rule">Logistics</h2><div class="iid-form-columns"><div class="iid-input-rows"><label for="iid-responsible">Responsible</label><select id="iid-responsible" name="responsible"><option value="">Select Responsible</option></select><label for="iid-unit">Unit</label><select id="iid-unit" name="unit"><% for(const unit of unitChoices){ %><option value="<%= unit %>" <%= item.unit===unit?'selected':'' %>><%= String(unit).toUpperCase() %></option><% } %></select><label for="iid-weight">Weight</label><div class="iid-input-unit"><input id="iid-weight" name="weight" type="number" min="0" step="0.001" placeholder="0.000"><span>KG</span></div></div><div class="iid-input-rows"><label for="iid-customer-lead">Customer Lead Time</label><div class="iid-input-unit"><input id="iid-customer-lead" name="customer_lead_days" type="number" min="0" step="1" placeholder="0"><span>Days</span></div><label for="iid-reorder-lead">Reorder Lead Time</label><div class="iid-input-unit"><input id="iid-reorder-lead" name="reorder_lead_days" type="number" min="0" step="1" placeholder="0"><span>Days</span></div></div></div></section></section>
<footer class="iid-footer"><a class="ii-source" href="<%= item.sourceHref %>"><%= item.sourceAction %> →</a><a class="iid-back" href="<%= returnUrl %>">Back to Inventory Items</a></footer>
</article>
