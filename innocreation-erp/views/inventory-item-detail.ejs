<% const format=v=>v==null?'—':Number(v).toLocaleString('en-US',{maximumFractionDigits:3}),productTypes=[['finished-goods','Finished Goods'],['raw-oil','Raw Oil'],['raw-materials','Raw Materials'],['operational-supplies','Operational Supplies']],unitChoices=[...new Set(['pcs','kg','g','box','pack','roll','pair','set','ml','L',item.unit])]; %>
<% const paths={box:'<path d="m12 3 8 4v10l-8 4-8-4V7zM4 7l8 4 8-4M12 11v10"/>',doc:'<path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6"/>',cart:'<path d="M3 4h3l2 12h11l2-9H7M10 20h.01M18 20h.01"/>',globe:'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/>',monitor:'<path d="M3 4h18v12H3zM8 21h8M12 16v5"/>',refresh:'<path d="M20 10a8 8 0 1 0 0 5M20 4v6h-6"/>',move:'<path d="M4 8h15l-4-4M20 16H5l4 4"/>',note:'<path d="M4 4h16v12H9l-5 4z"/>',copy:'<path d="M9 9h11v12H9zM5 16H3V3h11v3"/>'};const icon=name=>'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+(paths[name]||paths.box)+'</svg>';const typeHelp={'finished-goods':'Ready-to-sell retail item','raw-oil':'Bulk base oil ingredient','raw-materials':'Production components','operational-supplies':'Office & production supplies'}; %>
<% const isNew=!!item.isNew,settings=item.settings||{},draft=item.openDialog?'':item.formDraft,val=(key,fallback='')=>draft&&typeof draft[key]==='string'?draft[key]:settings[key]??fallback,base=isNew?'/inventory/items':('/inventory/items/detail/'+item.type_id+'/'+item.id),query=returnUrl.includes('?')?returnUrl.slice(returnUrl.indexOf('?')):'',rule=item.rule,ruleActive=!!rule?.active,effectiveMin=ruleActive?rule.min_qty:item.reorder_qty,formDraft=item.formDraft||{},csrfToken=inventoryItems.csrf||csrf; %>
<div class="iid-topbar"><a class="iid-back" href="<%= returnUrl %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h13"/></svg> Inventory Items</a><span><%= isNew?'New Inventory Item':'Item Details' %></span></div>
<% if(item.formError&&!item.openDialog){ %><p class="ii-error" role="alert"><%= item.formError %></p><% } %><% if(inventoryItems.saved){ %><p class="ii-notice" role="status">သိမ်းဆည်းပြီးပါပြီ။</p><% } %><form id="iid-settings-form" method="post" action="<%= isNew?'/inventory/items/new':base+'/settings'+query %>" data-new-item="<%= isNew?'1':'0' %>" data-live-settings data-can-edit="<%= item.canEdit?'1':'0' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= settings.revision||0 %>"><% if(!isNew){ %><input type="hidden" name="unit" value="<%= item.unit %>"><% }else{ %><input type="hidden" name="request_key" value="<%= inventoryItems.newRequestKey %>"><input type="hidden" name="initial_reorder_qty" value="<%= val('initial_reorder_qty') %>"><input type="hidden" name="initial_target_qty" value="<%= val('initial_target_qty') %>"><% } %><input type="hidden" name="online_enabled" value="<%= val('online_enabled','0') %>"><input type="hidden" name="pos_enabled" value="<%= val('pos_enabled','0') %>"><input type="hidden" name="addons" value="<%= JSON.stringify((item.addons||[]).map(a=>({type:a.addon_type,id:String(a.addon_id)}))) %>" data-live-addons-value><article class="iid-product iid-modern" data-ii-product>
<header class="iid-header"><div class="iid-identity"><span class="im-product-icon"><%- icon('box') %></span><div class="im-product-heading"><div class="iid-badges"><span class="ii-type <%= item.product_type||item.type_id %>"><%= isNew?'New Item':'● '+item.type_name %></span><% if(!isNew){ %><button type="button" class="im-code" data-im-copy="<%= item.code %>" aria-label="Copy item code"><%= item.code %><%- icon('copy') %></button><% }else{ %><span class="im-code">Auto-generated on save</span><% } %><% if(!isNew){ %><span class="im-category"><%= item.category||'Uncategorized' %></span><% } %></div><% if(isNew){ %><label class="ii-sr-only" for="new-product-name">Product Name</label><input id="new-product-name" name="name" class="new-product-name" value="<%= val('name') %>" maxlength="200" required placeholder="Product Name"><% }else{ %><h1><%= item.name %></h1><% } %><span class="im-copy-status" role="status" data-im-copy-status></span></div></div><div class="iid-metrics"><div class="im-stat <%= item.status==='Low Stock'?'im-status-low':item.closing_qty==null?'im-status-pending':'' %>"><div class="im-stat-label">On Hand<span class="im-dot"></span></div><strong><%= format(item.closing_qty) %> <small><%= item.unit %></small></strong><p>Main Warehouse<% if(item.status!=='—'){ %> · <span><%= item.status %></span><% } %></p></div><div class="im-stat" data-rule-card><div class="im-stat-label">Reordering<%- icon('refresh') %></div><div class="reorder-pair"><div><span>Reorder Qty</span><strong data-reorder-min><%= format(effectiveMin) %><small><%= item.unit %></small></strong></div><div><span>Target Stock Qty<small class="target-stock-mm">(ပြန်ဖြည့်ထားလိုသည့် လက်ကျန်ပမာဏ)</small></span><strong data-reorder-max><%= ruleActive?format(rule.max_qty):'—' %><small><%= item.unit %></small></strong></div></div><button class="im-configure" type="button" data-rule-open <%= !item.canEdit?'disabled':'' %>><%= ruleActive?'Edit rule':'+ Configure rule' %></button></div><% if(!isNew){ %><a class="im-stat im-movement im-movement-link" href="<%= base %>/movements"><% }else{ %><div class="im-stat im-movement"><% } %><div class="im-stat-label">Movement<%- icon('move') %></div><div class="im-movement-values"><span>↑ <%= format(item.stock_in) %> <small><%= item.unit %></small></span><span>↓ <%= format(item.stock_out) %> <small><%= item.unit %></small></span></div><p><%= isNew?'In / Out Summary':'View movement history →' %></p><% if(!isNew){ %></a><% }else{ %></div><% } %></div></header>
<section class="iid-channels" aria-label="Sales channels"><div class="iid-channel-options"><% for(const [key,title,subtitle,ico] of [['online','Online','Online sales channels & web storefront','globe'],['pos','Point of Sale','Retail shop sales & counter registers','monitor']]){ %><label class="iid-channel"><input type="checkbox" role="switch" aria-label="<%= title %>" data-ii-channel="<%= key %>" <%= String(val(key==='online'?'online_enabled':'pos_enabled','0'))==='1'?'checked':'' %>><span class="iid-channel-icon"><%- icon(ico) %></span><span class="im-channel-text"><span class="im-channel-heading"><strong><%= title %></strong><span class="im-badge" data-im-channel-badge="<%= key %>">Inactive</span></span><small><%= subtitle %></small></span><span class="im-switch" aria-hidden="true"></span></label><% } %></div></section>
<div class="iid-tabs" role="tablist" aria-label="Item information"><button type="button" role="tab" id="iid-tab-general" aria-controls="iid-panel-general" aria-selected="true" data-ii-tab="general"><span class="im-tab-icon"><%- icon('doc') %></span>General Information</button><button type="button" role="tab" id="iid-tab-sales" aria-controls="iid-panel-sales" aria-selected="false" tabindex="-1" data-ii-tab="sales"><span class="im-tab-icon"><%- icon('cart') %></span>Sales Channels <span class="im-tab-count" data-im-channel-count>0</span></button><button type="button" role="tab" id="iid-tab-inventory" aria-controls="iid-panel-inventory" aria-selected="false" tabindex="-1" data-ii-tab="inventory"><span class="im-tab-icon"><%- icon('box') %></span>Inventory</button></div>
<section class="iid-panel" id="iid-panel-general" role="tabpanel" aria-labelledby="iid-tab-general" data-ii-panel="general"><div class="iid-form-columns"><div class="iid-form-section im-card"><header class="im-card-heading"><div><h2>Product Classification &amp; Specs</h2><p>Inventory type and physical attributes</p></div></header><fieldset class="iid-product-types"><legend>Product Type</legend><% for(const [value,label] of productTypes){ %><label><input type="radio" name="product_type" value="<%= value %>" required <%= String(val('product_type',item.product_type||item.type_id))===value?'checked':'' %>><span><strong><%= label %></strong><small><%= typeHelp[value] %></small></span></label><% } %></fieldset><dl class="iid-fields iid-single"><div><dt>Quantity On Hand</dt><dd><%= format(item.closing_qty) %> <%= item.unit %></dd></div><div><dt><label for="iid-net-weight">Net Weight</label></dt><dd><div class="iid-input-unit"><input id="iid-net-weight" name="net_weight_kg" value="<%= val('net_weight_kg') %>" type="number" min="0" step="0.001" placeholder="0.00"><span>kg</span></div></dd></div><div class="iid-dimensions-row"><dt>Size (Dimensions)<small>Length × Width × Height</small></dt><dd><div class="iid-dimensions"><% for(const [key,label] of [['length_cm','Length'],['width_cm','Width'],['height_cm','Height']]){ %><label><span class="dimension-label"><%= label %></span><div class="dimension-control"><input name="<%= key %>" aria-label="<%= label %> (cm)" value="<%= val(key) %>" type="number" min="0" step="0.001" placeholder="0.00"><span class="dimension-unit">cm</span></div></label><% } %></div></dd></div></dl></div><div class="iid-form-section im-card"><header class="im-card-heading"><div><h2>Pricing &amp; Taxes</h2><p>Retail price, unit cost, and tax rates</p></div><span class="im-badge">Margin: <strong data-im-margin>—</strong></span></header><div class="iid-input-rows"><label for="iid-sales-price">Sales Price</label><div class="iid-input-unit"><input id="iid-sales-price" name="sales_price" value="<%= val('sales_price') %>" type="number" min="0" step="0.0001" placeholder="0.00"><span>MMK</span></div><label for="iid-sales-taxes">Sales Taxes</label><div class="iid-input-unit"><input id="iid-sales-taxes" name="sales_taxes" value="<%= val('sales_taxes') %>" type="number" min="0" max="100" step="0.0001" placeholder="0"><span>%</span></div><label for="iid-cost">Cost</label><div class="iid-input-unit"><input id="iid-cost" name="cost" value="<%= val('cost') %>" type="number" min="0" step="0.0001" placeholder="0.00"><span>MMK</span></div><label for="iid-purchase-taxes">Purchase Taxes</label><div class="iid-input-unit"><input id="iid-purchase-taxes" name="purchase_taxes" value="<%= val('purchase_taxes') %>" type="number" min="0" max="100" step="0.0001" placeholder="0"><span>%</span></div><label for="iid-category">Category</label><select id="iid-category" name="category" required><option value="">Select Category</option><% for(const [value,label] of productTypes){ %><option value="<%= value %>" <%= String(val('category',settings.general_category||item.type_id))===value?'selected':'' %>><%= label %></option><% } %></select></div></div></div><div class="iid-notes im-card"><div class="im-notes-heading"><label for="iid-internal-note"><%- icon('note') %> Internal Notes</label><span data-im-counter="iid-internal-note">0 / 1000</span></div><textarea id="iid-internal-note" name="internal_note" maxlength="1000" rows="3" placeholder="Internal notes for your team…"><%= val('internal_note',item.note||'') %></textarea></div></section>
<section class="iid-panel" id="iid-panel-sales" role="tabpanel" aria-labelledby="iid-tab-sales" data-ii-panel="sales" hidden><div class="iid-form-columns im-sales-columns"><div class="im-sales-left"><section class="iid-form-section im-card"><header class="im-card-heading"><div><h2>Point of Sale</h2><p>Configure retail register category</p></div><span class="im-badge" data-im-pos-status>● POS Inactive</span></header><div class="iid-input-rows"><label for="iid-pos-category">Category</label><select id="iid-pos-category" name="pos_category"><option value="">Select POS Category</option><% if(val('pos_category')&&val('pos_category')!==item.category){ %><option selected><%= val('pos_category') %></option><% } %><% if(item.category){ %><option <%= val('pos_category')===item.category?'selected':'' %>><%= item.category %></option><% } %></select></div></section><section class="iid-form-section im-card"><header class="im-card-heading"><div><h2>Upsell &amp; Cross-sell</h2><p>Suggest complementary items during POS checkout</p></div></header><div class="iid-input-rows"><label for="iid-optional-products">POS Optional Products</label><select id="iid-optional-products" name="pos_optional_products"><option value="">Recommend when adding to cart</option></select><span class="im-field-label">Linked Add-ons</span><div><div class="im-addon-tags" data-im-addon-tags><small data-im-empty-addons <%= item.addons?.length?'hidden':'' %>>No linked add-ons</small><% for(const a of item.addons||[]){const target=item.catalogue.find(t=>t.source_type===a.addon_type&&String(t.id)===String(a.addon_id));if(target){ %><span class="im-addon-tag" data-addon-type="<%= a.addon_type %>" data-addon-id="<%= a.addon_id %>"><span><%= target.name %> · <%= target.code %></span><button type="button" aria-label="Remove add-on">×</button></span><% }} %></div><div class="im-addon-entry"><select aria-label="Complementary item" data-im-addon-name><option value="">Select complementary item…</option><% for(const target of item.catalogue||[]){if(target.source_type===item.type_id&&String(target.id)===String(item.id))continue; %><option value="<%= target.source_type %>:<%= target.id %>"><%= target.name %> · <%= target.code %></option><% } %></select><button type="button" data-im-addon-add>Add</button></div></div></div></section></div><section class="iid-form-section im-card im-description-card"><header class="im-card-heading"><div><h2><label for="iid-description">Description</label></h2><p>Product copy for POS &amp; Online channels</p></div><div class="im-description-tools"><button type="button" data-im-insert="list">• List</button><button type="button" data-im-insert="benefits">+ Benefits</button></div></header><textarea class="iid-description" id="iid-description" name="description" maxlength="2000" rows="10" placeholder="Information about your product."><%= val('description') %></textarea><div class="im-description-footer"><span>For Online Storefront &amp; POS</span><span data-im-counter="iid-description">0 / 2000</span></div></section></div></section>
<section class="iid-panel" id="iid-panel-inventory" role="tabpanel" aria-labelledby="iid-tab-inventory" data-ii-panel="inventory" hidden><section class="im-card"><header class="im-card-heading"><div><h2>Inventory</h2><p>Live balance formula: <code>Opening + Stock In − Stock Out = On Hand</code></p></div><% if(!isNew&&item.canMove&&item.closing_qty==null&&item.type_id==='operational-supplies'){ %><div class="live-stock-actions"><button type="button" data-stock-open="OPENING">Set Opening Stock</button></div><% } %></header><dl class="iid-fields"><% for(const [label,value] of [['Warehouse','Main Warehouse'],['Opening',format(item.opening_qty)],['Stock In',format(item.stock_in)],['Stock Out',format(item.stock_out)],['On Hand',format(item.closing_qty)+' '+item.unit],['Reorder Qty',format(item.reorder_qty)],['Stock Status',item.status],['Target Stock Qty (ပြန်ဖြည့်ထားလိုသည့် လက်ကျန်ပမာဏ)',ruleActive?format(rule.max_qty)+' '+item.unit:'—']]){ %><div><dt><%= label %></dt><dd><%= value %></dd></div><% } %></dl><% if(item.suggestedQty!==null&&item.suggestedQty!==undefined){ %><p class="iid-help">Suggested Reorder: <strong><%= format(item.suggestedQty) %> <%= item.unit %></strong> · Target: Target Stock Qty (ပြန်ဖြည့်ထားလိုသည့် လက်ကျန်ပမာဏ)</p><% } %></section><section class="im-card live-logistics"><header class="im-card-heading"><div><h2>Logistics</h2><p>Unit of measure, physical weight, and lead times</p></div></header><div class="iid-form-columns"><div class="iid-input-rows"><label for="iid-unit">Unit</label><% if(isNew){ %><select id="iid-unit" name="unit" required><option value="">Select Unit</option><% for(const unit of unitChoices.filter(Boolean)){ %><option value="<%= unit %>" <%= val('unit')===unit?'selected':'' %>><%= String(unit).toUpperCase() %></option><% } %></select><% }else{ %><select id="iid-unit" name="unit_preview" disabled><option><%= String(item.unit).toUpperCase() %></option></select><% } %><label for="iid-weight">Weight</label><div class="iid-input-unit"><input id="iid-weight" name="weight" value="<%= val('weight',settings.weight_kg??'') %>" type="number" min="0" step="0.001" placeholder="0.000"><span>KG</span></div></div><div class="iid-input-rows"><label for="iid-origin">Origin of Goods</label><select id="iid-origin" name="origin_of_goods"><option value="">Origin of Goods ကို ရွေးချယ်ပါ</option><% for(const origin of ['Myanmar','Singapore','Thailand','China','Europe','USA','Canada','Malaysia','Indonesia']){ %><option value="<%= origin %>" <%= val('origin_of_goods')===origin?'selected':'' %>><%= origin %></option><% } %></select><label for="iid-customer-lead">Customer Lead Time</label><div class="iid-input-unit"><input id="iid-customer-lead" name="customer_lead_days" value="<%= val('customer_lead_days') %>" type="number" min="0" max="3650" step="1" placeholder="0"><span>Days</span></div><label for="iid-reorder-lead">Reorder Lead Time</label><div class="iid-input-unit"><input id="iid-reorder-lead" name="reorder_lead_days" value="<%= val('reorder_lead_days') %>" type="number" min="0" max="3650" step="1" placeholder="0"><span>Days</span></div></div></div></section><% if(item.history?.length){ %><section class="im-card live-logistics"><h2>Recent Stock Movements</h2><div class="ii-table-wrap"><table><thead><tr><th>Date</th><th>Type</th><th>Qty</th><th>On Hand</th><th>Remark</th><th>By</th></tr></thead><tbody><% for(const h of item.history){ %><tr><td><%= h.created_at %></td><td><%= h.direction %></td><td><%= format(h.qty) %> <%= item.unit %></td><td><%= format(h.balance_after) %></td><td><%= h.remark %></td><td><%= h.actor_name||h.actor_id %></td></tr><% } %></tbody></table></div></section><% } %></section>
<footer class="iid-footer"><% if(item.canEdit){ %><button type="submit" class="live-save"><%= isNew?'Save New Inventory Item':'Save Item Changes' %></button><% } %><% if(!isNew){ %><a class="ii-source" href="<%= item.sourceHref %>"><%= item.sourceAction %> →</a><% } %><a class="iid-back" href="<%= returnUrl %>">Back to Inventory Items</a></footer>
</article></form>
<dialog class="live-rule-dialog" data-rule-dialog <%- item.openDialog==='rule'?'data-open-on-load':'' %>><form method="post" action="<%= base %>/reordering<%= query %>" <%- isNew?'data-draft-rule':'' %>><header><div><h2>Configure Reordering Rule</h2><p>Main Warehouse · <%= isNew?'New Inventory Item':item.code %></p></div><button type="button" data-rule-close aria-label="Close reordering rule">×</button></header><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule?.revision||0 %>"><% if(item.openDialog==='rule'&&item.formError){ %><p class="ii-error" role="alert"><%= item.formError %></p><% } %><div class="live-rule-fields"><label>Reorder Qty (<span data-rule-unit><%= item.unit||'—' %></span>)<input name="min_qty" type="number" min="0" max="999999999.999" step="<%= item.unit==='pcs'?'1':'0.001' %>" required value="<%= item.openDialog==='rule'?formDraft.min_qty??'':effectiveMin??'' %>" placeholder="e.g. 500"></label><label>Target Stock Qty (ပြန်ဖြည့်ထားလိုသည့် လက်ကျန်ပမာဏ) · <span data-rule-unit><%= item.unit||'—' %></span><input name="max_qty" type="number" min="<%= item.unit==='pcs'?'1':'0.001' %>" max="999999999.999" step="<%= item.unit==='pcs'?'1':'0.001' %>" required value="<%= item.openDialog==='rule'?formDraft.max_qty??'':ruleActive?rule.max_qty:'' %>" placeholder="e.g. 3000"></label></div><footer><button class="live-reset" name="action" value="reset" formnovalidate>Reset Rule</button><button type="button" data-rule-close>Cancel</button><button class="live-save" name="action" value="apply">Apply Rule</button></footer></form></dialog>
<% if(item.canMove&&['raw-materials','operational-supplies'].includes(item.type_id)){ %><dialog class="live-rule-dialog" data-stock-dialog <%- item.openDialog==='movement'?'data-open-on-load':'' %>><form method="post" action="<%= base %>/movement<%= query %>"><header><div><h2 data-stock-title>Record Stock</h2><p><%= item.name %> · Main Warehouse</p></div><button type="button" data-stock-close aria-label="Close stock entry">×</button></header><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="request_key" value="<%= inventoryItems.movementKey %>"><input type="hidden" name="direction" value="<%= item.openDialog==='movement'?formDraft.direction:'IN' %>"><% if(item.openDialog==='movement'&&item.formError){ %><p class="ii-error" role="alert"><%= item.formError %></p><% } %><div class="live-movement-fields"><label>Quantity (<%= item.unit %>)<input name="qty" type="number" min="0" max="999999999.999" step="<%= item.unit==='pcs'?'1':'0.001' %>" required value="<%= item.openDialog==='movement'?formDraft.qty??'':'' %>"></label><label>Remark <textarea name="remark" maxlength="500" rows="3" required><%= item.openDialog==='movement'?formDraft.remark??'':'' %></textarea></label></div><footer><button type="button" data-stock-close>Cancel</button><button class="live-save">Record Stock</button></footer></form></dialog><% } %>
