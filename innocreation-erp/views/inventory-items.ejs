<% const ii=inventoryItems,qty=v=>v==null?'—':Number(v).toLocaleString('en-US',{maximumFractionDigits:3}),qs=patch=>{const p=new URLSearchParams({q:ii.f?.q||'',type:ii.f?.type||'',category:ii.f?.category||'',...patch});return '/inventory/items?'+p.toString();}; %>
<% if(ii.product){ %><%- include('inventory-item-detail',{item:ii.product,returnUrl:ii.returnUrl}) %><% }else{ %>
<section class="ii-heading"><div><h1>Inventory Items</h1><p>Finished Goods၊ Raw Oil၊ Raw Materials နှင့် Operational Supplies</p><small>Main Warehouse · ပမာဏများကို Item ၏ Unit အလိုက် ဖော်ပြထားပါသည်။</small></div><% if(ii.canCreate){ %><a class="ii-button" href="/inventory/items/new">＋ Add Products Inventory Items</a><% } %></section>
<% if(ii.created){ %><p class="ii-notice" role="status">Operational Supply ကို သိမ်းဆည်းပြီးပါပြီ။</p><% } %>
<% if(ii.detail){const d=ii.detail; %><a class="ii-back" href="/inventory/items?type=operational-supplies">← Operational Supplies</a><section class="ii-detail"><span class="ii-type operational-supplies">Operational Supplies</span><h2><%= d.name %></h2><p><strong><%= d.code %></strong></p><dl><% for(const [label,value] of [['Category',d.category],['Unit',d.unit],['Opening',qty(d.opening_qty)],['Closing',qty(d.stock_qty)],['Reorder Qty',qty(d.reorder_qty)]]){ %><div><dt><%= label %></dt><dd><%= value %></dd></div><% } %></dl><% if(d.note){ %><p class="ii-preserve"><%= d.note %></p><% } %><p class="ii-note">ဤအဆင့်တွင် ပစ္စည်းနှင့် ကနဦးလက်ကျန်ကို မှတ်တမ်းတင်ထားပါသည်။</p></section>
<% }else{ %>
<nav class="ii-type-tabs" aria-label="Product types"><a class="<%= !ii.f.type?'active':'' %>" href="<%= qs({type:'',category:'',p:'1'}) %>" <%- !ii.f.type?'aria-current="page"':'' %>>All Items</a><% for(const t of ii.types){ %><a class="<%= ii.f.type===t.id?'active':'' %>" href="<%= qs({type:t.id,category:'',p:'1'}) %>" <%- ii.f.type===t.id?'aria-current="page"':'' %>><%= t.name %></a><% } %></nav>
<div class="ii-toolbar"><form method="get" action="/inventory/items" class="ii-search"><label class="ii-sr-only" for="ii-search">Search item code or name</label><input id="ii-search" name="q" value="<%= ii.f.q %>" placeholder="Search Item Code / Item Name…"><input type="hidden" name="type" value="<%= ii.f.type %>"><label class="ii-sr-only" for="ii-category">Category</label><select id="ii-category" name="category"><option value="">All Categories</option><% for(const c of ii.categories){if(c.category){ %><option value="<%= c.category %>" <%= ii.f.category===c.category?'selected':'' %>><%= c.category %></option><% }} %></select><button class="ii-button">Search</button><a href="/inventory/items">Reset</a></form><details class="ii-columns"><summary aria-label="Choose visible columns"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16M8 3v6M16 9v6M10 15v6"/></svg> Columns</summary><div class="ii-column-panel"><strong>Show Columns</strong><% for(const c of ii.columns){ %><label><input type="checkbox" data-ii-column-toggle="<%= c.id %>" <%= c.show?'checked':'' %> <%= c.required?'disabled':'' %>><span><%= c.name %></span><% if(c.required){ %><small>Required</small><% } %></label><% } %><button type="button" class="ii-reset-columns" data-ii-reset>Reset Columns</button></div></details></div>
<p class="ii-result-count"><%= ii.total.toLocaleString('en-US') %> items<% if(ii.f.q){ %> · Search: <%= ii.f.q %><% } %></p>
<div class="ii-table-wrap" data-ii-table data-ii-user="<%= user.id %>"><table><caption class="ii-sr-only">Inventory Items — Main Warehouse</caption><thead><tr><% for(const c of ii.columns){ %><th scope="col" data-ii-column="<%= c.id %>" <%= !c.show?'hidden':'' %>><%= c.name %></th><% } %></tr></thead><tbody><% if(!ii.rows.length){ %><tr><td colspan="13" class="ii-empty">ကိုက်ညီသော ပစ္စည်း မရှိသေးပါ။<% if(ii.f.type==='operational-supplies'&&ii.canCreate){ %> Add Products Inventory Items မှ ပစ္စည်းအသစ် ထည့်နိုင်ပါသည်။<% } %></td></tr><% } %><% for(const item of ii.rows){const detailUrl=item.href+'?'+new URLSearchParams({q:ii.f.q,type:ii.f.type,category:ii.f.category,p:String(ii.page)}).toString(); %><tr class="ii-clickable-row" data-ii-row-href="<%= detailUrl %>" tabindex="0" aria-label="Open <%= item.name %>"><% for(const c of ii.columns){ %><td data-ii-column="<%= c.id %>" <%= !c.show?'hidden':'' %> class="<%= ['opening_qty','stock_in','stock_out','closing_qty','reorder_qty'].includes(c.id)?'ii-number':'' %>"><% if(c.id==='type_name'){ %><span class="ii-type <%= item.product_type||item.type_id %>"><%= item.type_name %></span><% }else if(c.id==='name'){ %><a class="ii-item-name" href="<%= detailUrl %>"><strong><%= item.name %></strong></a><% }else if(c.id==='code'){ %><span class="ii-code"><%= item.code %></span><% }else if(c.id==='status'){ %><span class="ii-status <%= item.status==='Low Stock'?'low':item.status==='In Stock'?'in-stock':'pending' %>"><%= item.status %></span><% }else if(c.id==='action'){ %><a class="ii-source" href="<%= detailUrl %>"><%= item.action %> →</a><% }else if(['opening_qty','stock_in','stock_out','closing_qty','reorder_qty'].includes(c.id)){ %><%= qty(item[c.id]) %><% }else{ %><%= item[c.id]||'—' %><% } %></td><% } %></tr><% } %></tbody></table></div>
<footer class="ii-pagination"><span>Page <%= ii.page %> of <%= Math.max(1,Math.ceil(ii.total/50)) %> · 50 items per page</span><nav aria-label="Pages"><% if(ii.page>1){ %><a href="<%= qs({p:String(ii.page-1)}) %>">← Previous</a><% } %><% if(ii.page*50<ii.total){ %><a href="<%= qs({p:String(ii.page+1)}) %>">Next →</a><% } %></nav></footer>
<% } %>
<% if(ii.canCreate){ %><dialog class="ii-dialog" data-ii-dialog <%- ii.openCreate?'data-open-on-load':'' %>><form method="post" action="/inventory/items/operational-supplies"><header><div><h2>Add Operational Supply</h2><p>HR၊ Office၊ Production နှင့် အခြားဌာနသုံး ပစ္စည်းများ</p></div><button type="button" class="ii-close" data-ii-close aria-label="Close">×</button></header><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= ii.requestKey %>"><% if(ii.error){ %><p class="ii-error" role="alert"><%= ii.error %></p><% } %><div class="ii-form-grid"><label class="ii-wide">Item Name <span>*</span><input name="name" maxlength="255" required value="<%= ii.draft.name||'' %>" placeholder="e.g. Tissue / File Folder / Measuring Cup"></label><label>Item Code<input value="Auto-generated on save" disabled></label><label>Category <span>*</span><input name="category" maxlength="150" required value="<%= ii.draft.category||'' %>" placeholder="e.g. Office & Stationery"></label><label>Unit <span>*</span><select name="unit" required><% for(const u of ii.units){ %><option <%= (ii.draft.unit||'pcs')===u?'selected':'' %>><%= u %></option><% } %></select></label><label>Opening Qty <small>(Optional)</small><input type="number" name="opening" min="0" max="999999999.999" step="0.001" value="<%= ii.draft.opening??'' %>" placeholder="Blank = not yet verified"></label><label>Reorder Qty <small>(Optional)</small><input type="number" name="reorder" min="0" max="999999999.999" step="0.001" value="<%= ii.draft.reorder??'' %>"></label><label class="ii-wide">Note <small>(Optional)</small><textarea name="note" maxlength="500" rows="3"><%= ii.draft.note||'' %></textarea></label></div><p class="ii-note">Opening Qty ဖြည့်ထားပါက ကနဦး Closing Qty အဖြစ် သတ်မှတ်ပါမည်။ မစစ်ဆေးရသေးလျှင် အလွတ်ထားနိုင်ပါသည်။</p><footer><button type="button" class="ii-cancel" data-ii-close>Cancel</button><button class="ii-button">Save Operational Supply</button></footer></form></dialog><% } %>

<% } %>
