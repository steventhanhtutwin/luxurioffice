<% const num=v=>{const [w,f='']=String(v??'0').split('.');const tail=f.replace(/0+$/,'');return w.replace(/\B(?=(\d{3})+(?!\d))/g,',')+(tail?'.'+tail:'');}; %>
<section class="pr-request-detail"><header class="pr-confirm"><span>REQUISITION SUBMITTED</span><h1>Stock Requisition (Packaging To Main Warehouse) <%= request.request_no %></h1><span class="pr-pending"><%= dispatchLabel(request.status) %></span></header><div class="pr-facts"><div><small>Requested By</small><strong><%= request.requested_by %></strong><span>Packaging Team</span></div><div><strong>Request From: Packaging Warehouse</strong><strong>Request To: Main Warehouse</strong></div><div><small>Request Date &amp; Time</small><strong><%= request.created_at %></strong><span>Asia/Bangkok</span></div></div>
<div class="pr-request-meta"><span>Priority: <strong class="pr-priority <%= request.priority==='URGENT'?'urgent':'' %>"><%= request.priority==='URGENT'?'Urgent':'Normal' %></strong></span><span>Needed By: <strong><%= request.needed_by||'—' %></strong></span></div><h2>Requested Items</h2><div class="pr-table-wrap"><table class="pr-table"><thead><tr><th>Item Code</th><th>Item Name</th><% if(request.request_type!=='MANUAL'){ %><th>Sales Qty</th><% } %><th>Packaging Stock</th><% if(request.request_type!=='MANUAL'){ %><th>Shortage Qty</th><% } %><th>Requested Qty</th></tr></thead><tbody><% for(const line of lines){ %><tr><td><%= line.item_code || 'မချိတ်ရသေးပါ' %></td><td><strong><%= line.item_name %></strong><small><%= line.category %><%= line.size_ml?' · '+line.size_ml+' ml':'' %></small></td><% if(request.request_type!=='MANUAL'){ %><td><%= num(line.sales_qty) %></td><% } %><td><%= num(line.stock_qty) %></td><% if(request.request_type!=='MANUAL'){ %><td><%= num(line.shortage_qty) %></td><% } %><td><strong><%= num(line.requested_qty) %></strong></td></tr><% } %></tbody></table></div><div class="pr-detail-total"><strong>Total Items: <%= lines.length %></strong><strong>Total Request Qty: <%= num(totalQty) %></strong></div><% if(request.remark){ %><div class="pr-saved-remark"><strong>Remark</strong><p><%= request.remark %></p></div><% } %>
<% if(dispatchHistory.length){ %><%- include('dispatch-history',{dispatches:dispatchHistory,allowReceive:!printMode}) %><% } %>
<% if(!printMode){ %><div class="pr-detail-actions"><a href="/packaging/material-request">← Request History</a><div><a class="pr-button pr-secondary" href="/packaging/requests/<%= request.id %>/print" target="_blank" rel="noopener">Print Slip</a><a class="pr-button" href="<%= request.request_type==='MANUAL'?'/packaging/material-request/new':'/packaging/operation/material-requirement' %>"><%= request.request_type==='MANUAL'?'New Request':'New Calculation' %></a></div></div><% } %></section>
