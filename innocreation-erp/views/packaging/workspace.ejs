<%
const currentPackaging=typeof packagingPage==='string'?packagingPage:'requirement';
const packagingMenus=[
 {id:'warehouse',name:'Packaging Warehouse',path:'/packaging/warehouse',icon:'box',subtitle:'Packaging Warehouse လက်ကျန်စာရင်း',description:'Opening၊ Stock In၊ Stock Out နှင့် Closing ကို စစ်ဆေးရန်။',tags:['Stock Balance','Stock In','Stock Out']},
 {id:'operation',name:'Packaging Operation',path:'/packaging/operation/material-requirement',icon:'layers',subtitle:'Packaging လုပ်ငန်းစဉ်များ',description:'ရောင်းအား၊ Packaging Stock နှင့် လိုအပ်ချက်ကို နှိုင်းယှဉ်ရန်။',tags:['Material Requirement']},
 {id:'material-request',name:'Stock Requisition',path:'/packaging/material-request',icon:'box',subtitle:'ပစ္စည်းတောင်းခံမှု',description:'Main Warehouse သို့ တင်ထားသော Request များကို ပြန်ကြည့်ရန်။',tags:['Request History']},
 {id:'record',name:'Packaging Record',path:'/packaging/record',icon:'layers',subtitle:'ထုပ်ပိုးမှု မှတ်တမ်း',description:'Packaging လုပ်ဆောင်မှုနှင့် ပြီးစီးမှု မှတ်တမ်းများ ကြည့်ရန်။',tags:['Coming Soon']},
 {id:'qc',name:'Packaging QC',path:'/packaging/qc',icon:'box',subtitle:'အရည်အသွေး စစ်ဆေးမှု',description:'Packaging အရည်အသွေး စစ်ဆေးမှုများ စီမံရန်။',tags:['Coming Soon']}
];
const warehousePage=['warehouse','stock-in','stock-out'].includes(currentPackaging);
const operationPage=currentPackaging==='requirement';
const requestPage=['requests','request-detail','manual-request'].includes(currentPackaging);
const activePackaging=packagingMenus.find(m=>m.id===currentPackaging);
const pageTitle=operationPage?'Material Requirement':requestPage?(currentPackaging==='requests'?'Stock Requisition':currentPackaging==='manual-request'?'New Stock Requisition':'Stock Requisition (Packaging To Main Warehouse)'):currentPackaging==='dashboard'?'Packaging Dashboard':currentPackaging==='stock-in'?'Stock In':currentPackaging==='stock-out'?'Stock Out':activePackaging?.name||'Packaging';
%>
<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %> | Innocreation ERP</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/innocreation-loading.css?v=2"><script src="/innocreation-loading.js?v=2" defer></script><link rel="stylesheet" href="/workspace.css"><link rel="stylesheet" href="/inventory-navigation.css"><link rel="stylesheet" href="/packaging-navigation.css?v=2"><% if(currentPackaging==='warehouse'){ %><link rel="stylesheet" href="/packaging.css?v=8"><script src="/packaging.js?v=8" defer></script><% } %><% if(operationPage||requestPage||currentPackaging==='stock-in'){ %><link rel="stylesheet" href="/packaging-requirements.css?v=7"><script src="/packaging-requirements.js?v=7" defer></script><% } %><% if(currentPackaging==='manual-request'){ %><script src="/packaging-manual-request.js?v=4" defer></script><% } %><% if(requestPage||currentPackaging==='stock-in'){ %><link rel="stylesheet" href="/stock-requisitions.css?v=6"><script src="/stock-requisitions.js?v=4" defer></script><% } %></head>
<body class="app-home packaging-workspace"><header class="app-header"><a class="app-logo" href="/dashboard">INNOCREATION <span>/ ERP</span></a><div class="account-area"><% if(Array.isArray(user.app_access)&&user.app_access.includes('inventory')){ %><%- include('../partials/approval-notifications',{user,csrf}) %><% } %><a class="back-link" href="/dashboard">← Main Dashboard</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="logout">Logout</button></form></div></header>
<div class="inventory-shell"><aside class="inventory-sidebar"><p class="eyebrow">PACKAGING</p><nav aria-label="Packaging navigation">
<section class="packaging-sidebar-section"><h2>PACKAGING OPERATIONS</h2>
<% for(const m of [{id:'requirement',name:'Material Requirement',path:'/packaging/operation/material-requirement',icon:'calculate'},{id:'requests',name:'Stock Requisition',path:'/packaging/material-request',icon:'transfer'},{id:'record',name:'Packaging Record',path:'/packaging/record',icon:'record'},{id:'qc',name:'Packaging QC',path:'/packaging/qc',icon:'check'}]){ const active=currentPackaging===m.id||(m.id==='requests'&&requestPage); %><a class="packaging-sidebar-link <%= active?'active':'' %>" href="<%= m.path %>" <% if(active){ %>aria-current="page"<% } %>><span class="packaging-link-icon" aria-hidden="true"><%- include('menu-icon',{icon:m.icon}) %></span><span><%= m.name %></span><% if(active){ %><span class="packaging-active-dot" aria-hidden="true"></span><% } %></a><% } %>
</section><section class="packaging-sidebar-section"><h2>PACKAGING WAREHOUSE</h2><% for(const m of [{id:'warehouse',name:'Stock Balance',path:'/packaging/warehouse',icon:'box'},{id:'stock-in',name:'Stock In',path:'/packaging/warehouse/in',icon:'in'},{id:'stock-out',name:'Stock Out',path:'/packaging/warehouse/out',icon:'out'}]){const active=currentPackaging===m.id; %><a class="packaging-sidebar-link <%= active?'active':'' %>" href="<%= m.path %>" <% if(active){ %>aria-current="page"<% } %>><span class="packaging-link-icon" aria-hidden="true"><%- include('menu-icon',{icon:m.icon}) %></span><span><%= m.name %></span><% if(active){ %><span class="packaging-active-dot" aria-hidden="true"></span><% } %></a><% } %></section>
</nav><div class="sidebar-foot">INNOCREATION<br><span>Packaging workspace</span></div></aside>
<main class="inventory-main"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/packaging">Packaging</a><% if(currentPackaging!=='dashboard'){ %><span>/</span><% if(warehousePage&&currentPackaging!=='warehouse'){ %><a href="/packaging/warehouse">Packaging Warehouse</a><span>/</span><% } %><% if(operationPage){ %><a href="/packaging/operation">Packaging Operation</a><span>/</span><% } %><span aria-current="page"><%= pageTitle %></span><% } %></nav>
<% if(currentPackaging==='dashboard'){ %><div class="inventory-intro"><h1>Packaging Dashboard</h1><p class="muted">စီမံခန့်ခွဲလိုသည့် လုပ်ငန်းအပိုင်းကို ရွေးချယ်ပါ။</p></div><div class="inventory-section-title"><h2>Packaging workspaces</h2><span>05 WORKSPACES</span></div><section class="category-grid" aria-label="Packaging workspaces"><% packagingMenus.forEach((m,index)=>{ %><a class="category-card" href="<%= m.path %>"><div class="category-top"><span class="category-icon icon-<%= m.icon %>"><%- include('../partials/inventory-icon',{icon:m.icon}) %></span><span class="category-number">0<%= index+1 %></span></div><h2><%= m.name %></h2><p class="category-subtitle"><%= m.subtitle %></p><p class="category-description"><%= m.description %></p><div class="category-menu-tags"><% for(const tag of m.tags){ %><span><%= tag %></span><% } %></div><div class="category-open">Open workspace <span aria-hidden="true">↗</span></div></a><% }); %></section><div class="inventory-hint">ဘေး Menu မှလည်း သက်ဆိုင်ရာ လုပ်ငန်းအပိုင်းကို ရွေးချယ်နိုင်ပါသည်။</div>
<% }else if(currentPackaging==='warehouse'){ %><%- include('warehouse-content') %>
<% }else if(currentPackaging==='stock-in'){ %><%- include('receipts') %>
<% }else if(operationPage){ %><%- include('requirement-content') %><% }else if(currentPackaging==='manual-request'){ %><%- include('manual-request') %><% }else if(currentPackaging==='requests'){ %><%- include('request-list') %><% }else if(currentPackaging==='request-detail'){ %><%- include('request-detail') %><% }else{ %><section class="packaging-coming"><span class="category-icon icon-box" aria-hidden="true"><%- include('../partials/inventory-icon',{icon:warehousePage?'box':activePackaging?.icon||'box'}) %></span><p class="eyebrow">PACKAGING</p><h1><%= pageTitle %></h1><span class="packaging-coming-label">Coming Soon</span><p class="muted">ဤအပိုင်း၏ လုပ်ငန်းစဉ်ကို သတ်မှတ်ပြီးမှ ဆက်လက်တည်ဆောက်ပါမည်။</p><a href="/packaging">← Packaging Dashboard</a></section><% } %>
<footer class="inventory-footer"><span>PACKAGING WORKSPACE</span><span>MEMORI · LUXURI · GENTLEMEN’S CLUB · FLORAL</span></footer></main></div></body></html>
