<section class="sr-history" data-sr-root data-csrf="<%= csrf %>"><h2>Dispatch &amp; Receipt</h2><% for(const d of dispatches){ %><article class="sr-history-card"><header><strong>DSP-<%= String(d.id).padStart(6,'0') %><% if(d.request_no){ %> · <a href="/packaging/requests/<%= d.requisition_id %>"><%= d.request_no %></a><% } %></strong><span class="sr-badge"><%= dispatchLabel(d.status) %></span></header><% if(d.approved_at){ %><p>Dispatched: <%= d.approved_at %> · <%= d.approved_name||'Warehouse Supervisor' %></p><% } %><div class="sr-table-wrap"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Dispatch Qty</th></tr></thead><tbody><% for(const l of d.lines){ %><tr><td><%= l.item_code %></td><td><%= l.item_name %></td><td><%= String(l.qty) %> pcs</td></tr><% } %></tbody></table></div><% if(d.note){ %><p class="sr-preserve">Handover: <%= d.note %></p><% } %><% if(d.status==='RECEIVED'){ %><p>Received: <%= d.received_at %><% if(d.received_name){ %> · <%= d.received_name %><% } %></p><% } %><% if(d.status==='REJECTED'&&d.rejection_reason){ %><p class="sr-error"><%= d.rejection_reason %></p><% } %>
<% if(d.status==='IN_TRANSIT'&&allowReceive){ %><form data-sr-receive data-dispatch-id="<%= d.id %>"><label class="sr-confirm"><input type="checkbox" data-receipt-check required> ပစ္စည်းနှင့် Qty အားလုံး စစ်ဆေးလက်ခံပြီးပါပြီ။</label><p class="sr-info">Qty မကိုက်လျှင် Confirm မလုပ်ဘဲ Warehouse ကို ဆက်သွယ်ပါ။</p><label>Receipt Note (Optional)<textarea data-receipt-note maxlength="500" rows="2"></textarea></label><button type="submit" disabled>Confirm Receipt</button></form><% } %></article><% } %><p data-sr-message class="sr-error" role="status" hidden></p></section>
