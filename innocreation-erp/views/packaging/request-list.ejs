<div class="pr-heading"><div><h1>Stock Requisition</h1><p class="muted">Packaging Team မှ Main Warehouse သို့ တောင်းခံထားသော စာရင်း</p></div><a class="pr-button" href="/packaging/material-request/new">+ New Stock Requisition</a></div>
<div class="pr-table-wrap"><table class="pr-table"><thead><tr><th>Request No.</th><th>Date &amp; Time</th><th>Requested By</th><th>Items</th><th>Total Qty</th><th>Priority</th><th>Needed By</th><th>Status</th></tr></thead><tbody><% for(const r of requests){ %><tr><td><a href="/packaging/requests/<%= r.id %>"><%= r.request_no %></a></td><td><%= r.created_at %></td><td><%= r.requested_by %></td><td><%= r.item_count %></td><td><%= String(r.total_qty||'0').replace(/\.0+$/,'') %></td><td><span class="pr-priority <%= r.priority==='URGENT'?'urgent':'' %>"><%= r.priority==='URGENT'?'Urgent':'Normal' %></span></td><td><%= r.needed_by||'—' %></td><td><span class="pr-pending"><%= ({PENDING_WAREHOUSE_ISSUE:'Pending Dispatch',PENDING_SUPERVISOR_APPROVAL:'Pending Supervisor Approval',PARTIALLY_DISPATCHED:'Partially Dispatched',DISPATCHED:'Dispatched'})[r.status]||r.status %></span></td></tr><% } %><% if(!requests.length){ %><tr><td colspan="8">Request မရှိသေးပါ။</td></tr><% } %></tbody></table></div><div class="pr-detail-actions"><span><%= total %> requests · Page <%= pageNo %></span><div><% if(pageNo>1){ %><a href="?p=<%= pageNo-1 %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?p=<%= pageNo+1 %>">Next →</a><% } %></div></div>
