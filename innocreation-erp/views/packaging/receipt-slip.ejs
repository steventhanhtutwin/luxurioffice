<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Stock Receipt DSP-<%= String(d.id).padStart(6,'0') %></title><% if(pdfMode){ %><style><%- css %></style><% }else{ %><link rel="stylesheet" href="/fg-print.css"><script src="/fg-print.js" defer></script><% } %><% if(typeof downloadMode!=='undefined'&&downloadMode){ %><%- include('../partials/pdf-download-assets') %><% } %></head><body><% if(typeof downloadMode!=='undefined'&&downloadMode){ %><%- include('../partials/pdf-download-panel',{fileName:'Stock_Receipt_DSP-'+String(d.id).padStart(6,'0')+'.pdf'}) %><% } %><% if(!pdfMode){ %><nav class="print-controls"><a href="/packaging/warehouse/in?tab=history">← Back to Received History</a><button id="print-document">Print / Save as PDF</button><a class="pdf-download" href="/packaging/warehouse/in/slips/<%= d.id %>/pdf">Download PDF</a></nav><% } %><main class="print-sheet"><header class="report-heading"><div><p class="brand">INNOCREATION</p><h1>Packaging Stock Receipt</h1></div><div class="report-ref"><strong>DSP-<%= String(d.id).padStart(6,'0') %></strong><span><%= d.request_no %></span><span>Received</span></div></header><section class="report-facts"><div><span>FROM</span><strong>Main Warehouse</strong></div><div><span>TO</span><strong>Packaging Warehouse</strong></div><div><span>DISPATCHED BY / TIME</span><strong><%= d.approved_name %></strong><small><%= d.approved_at %></small></div><div><span>RECEIVED BY / TIME</span><strong><%= d.received_name %></strong><small><%= d.received_at %></small></div></section><table class="report-items"><thead><tr><th>Item Code</th><th>Item Name</th><th>Dispatched · pcs</th><th>Received · pcs</th></tr></thead><tbody><% for(const l of lines){ %><tr><td><%= l.item_code %></td><td><%= l.item_name %></td><td class="qty"><%= l.qty %></td><td class="qty"><%= l.qty %></td></tr><% } %></tbody><tfoot><tr><td colspan="2">Total · <%= lines.length %> items</td><td class="qty"><%= d.total_qty %></td><td class="qty"><%= d.total_qty %></td></tr></tfoot></table><section class="report-remark"><span>WAREHOUSE HANDOVER</span><p><%= d.note||'—' %></p><span>Receiving Remark</span><p><%= d.receipt_note||'—' %></p></section></main></body></html>