<% const fmt=v=>String(v||0).replace(/\B(?=(\d{3})+(?!\d))/g,','),tab=receiptTab,selected=receiptSelected;
const query=(values={})=>new URLSearchParams({...historyFilters,tab,...values}).toString(); %>
<section data-sr-root data-csrf="<%= csrf %>" class="sr-receipt-screen"><div class="sr-receipt-heading"><div><h1>Packaging Stock In</h1><p>Main Warehouse မှ ပို့ထားသော Dispatch များကို စစ်ဆေးလက်ခံရန်နှင့် မှတ်တမ်းကြည့်ရန်။</p></div><div class="sr-receipt-stats"><article><span>Pending Dispatches</span><strong><%= receiptStats.pending %></strong></article><article><span>Received Today</span><strong><%= receiptStats.receivedToday %></strong></article><article><span>Total Items Received</span><strong><%= fmt(receiptStats.totalQty) %> pcs</strong></article></div></div>
<div class="sr-receipt-tabs"><nav aria-label="Stock In tabs"><a class="<%= tab==='pending'?'active':'' %>" href="/packaging/warehouse/in">Pending Receipt <b><%= receiptStats.pending %></b></a><a class="<%= tab==='history'?'active':'' %>" href="/packaging/warehouse/in?tab=history">Received History <b><%= receiptStats.received %></b></a></nav><span>Route: <strong>Main Warehouse → Packaging Warehouse</strong></span></div>
<%- include('../partials/history-search',{action:'/packaging/warehouse/in',f:historyFilters,tab,showStatus:false,label:dispatchLabel}) %><% if(tab==='history'){ %><div class="sr-history-table sr-table-wrap"><table><thead><tr><th>Dispatch No.</th><th>Request Ref</th><th>Dispatched By &amp; Time</th><th>Received By &amp; Time</th><th>Items / Total Qty</th><th>Status</th><th>Action</th></tr></thead><tbody><% for(const d of dispatches){ const url='/packaging/warehouse/in/slips/'+d.id; %><tr data-row-href="<%= url %>"><td><strong>DSP-<%= String(d.id).padStart(6,'0') %></strong></td><td><a href="/packaging/requests/<%= d.requisition_id %>"><%= d.request_no %></a></td><td><%= d.approved_name %><small><%= d.approved_at %></small></td><td><%= d.received_name %><small><%= d.received_at %></small></td><td><strong><%= fmt(d.total_qty) %> pcs</strong><small><%= d.item_count %> items</small></td><td><span class="sr-badge">Received</span></td><td><a class="sr-button secondary" href="<%= url %>">View Slip</a></td></tr><% } %><% if(!dispatches.length){ %><tr><td colspan="7">လက်ခံပြီး မှတ်တမ်းမရှိသေးပါ။</td></tr><% } %></tbody></table><footer class="sr-history-pagination"><span><%= total %> received records · Page <%= pageNo %></span><nav><% if(pageNo>1){ %><a href="?<%= query({p:String(pageNo-1)}) %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?<%= query({p:String(pageNo+1)}) %>">Next →</a><% } %></nav></footer></div><% } %>
<div class="sr-layout <%= tab==='history'?'sr-receipt-slip-layout':'' %>"><% if(tab==='pending'){ %><aside class="sr-queue"><header><strong>INCOMING DISPATCHES (<%= total %>)</strong><small>Select to verify</small></header><% for(const d of dispatches){ %><a class="sr-queue-card <%= String(d.id)===String(selected?.id)?'active':'' %>" href="?<%= query({dispatch:String(d.id),p:String(pageNo)}) %>"><strong>DSP-<%= String(d.id).padStart(6,'0') %></strong><span><%= d.request_no %></span><span class="sr-badge">Pending Receipt</span><footer><small>By <%= d.approved_name %></small><b><%= d.item_count %> items · <%= fmt(d.total_qty) %> pcs</b></footer></a><% } %><% if(!dispatches.length){ %><p>လက်ခံရန် Dispatch မရှိသေးပါ။</p><% } %><nav class="sr-pagination"><% if(pageNo>1){ %><a href="?<%= query({p:String(pageNo-1)}) %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?<%= query({p:String(pageNo+1)}) %>">Next →</a><% } %></nav></aside><% } %>
<% if(selected){const d=selected,receiving=d.status==='IN_TRANSIT'; %><article class="sr-main sr-receipt-detail"><header class="sr-detail-header"><div><h2>DSP-<%= String(d.id).padStart(6,'0') %> · <a href="/packaging/requests/<%= d.requisition_id %>"><%= d.request_no %></a></h2><span class="sr-badge"><%= receiving?'Awaiting Verification':'Received' %></span><p>Dispatched: <strong><%= d.approved_at %></strong> · <%= d.approved_name %></p><% if(!receiving){ %><p>Received: <%= d.received_at %> · <%= d.received_name %></p><% } %><% if(d.note){ %><p class="sr-preserve">Handover: <%= d.note %></p><% } %></div></header><form <%- receiving?'data-sr-receive':'' %> data-dispatch-id="<%= d.id %>"><div class="sr-table-wrap"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Dispatched Qty</th><th><%= receiving?'Receiving Qty':'Received Qty' %></th><th>Condition / Status</th></tr></thead><tbody><% for(const l of d.lines){ %><tr><td><%= l.item_code %></td><td><strong><%= l.item_name %></strong></td><td><%= fmt(l.qty) %> pcs</td><td><strong><%= fmt(l.qty) %> pcs</strong></td><td><span class="sr-badge"><%= receiving?'Check before confirming':'Good (Matched)' %></span></td></tr><% } %></tbody></table></div><div class="sr-dispatch-footer"><% if(receiving){ %><label class="sr-confirm"><input type="checkbox" data-receipt-check required> ပစ္စည်းနှင့် Qty အားလုံး စစ်ဆေးလက်ခံပြီးပါပြီ။</label><p class="sr-info">Qty မကိုက်လျှင် Confirm မလုပ်ဘဲ Warehouse ကို ဆက်သွယ်ပါ။</p><label>Receiving Remark (Optional)<textarea data-receipt-note maxlength="500" rows="2"></textarea></label><div><strong>Receiving Now: <%= fmt(d.total_qty) %> pcs</strong><button type="submit" disabled>Confirm &amp; Receive Stock</button></div><% }else{ %><p class="sr-preserve">Receiving Remark: <%= d.receipt_note||'—' %></p><% } %></div></form></article><% } %></div><p data-sr-message class="sr-error" role="status" hidden></p></section>
