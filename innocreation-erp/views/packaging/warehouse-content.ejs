<div class="stock-page-title"><h1>Packaging Warehouse — Stock Balance</h1><span>One-Time Opening Lock</span></div><p class="muted">Opening + Stock In − Stock Out = Closing</p>
<% if(saved){ %><p class="success">Opening Stock သိမ်းဆည်းပြီးပါပြီ။</p><% } %>


<div class="stock-filters stock-compact-toolbar">
<form id="stock-filter-form" class="stock-search-form" role="search"><div class="stock-search-control"><span class="stock-search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></span><input id="stock-search" type="search" maxlength="100" aria-label="Search Item Code or Item Name" placeholder="Search Item Code / Item Name…"><button type="submit" class="stock-search-button">Search</button><details class="stock-custom-filter"><summary aria-label="Custom Filter"><span aria-hidden="true">▼</span></summary><section class="stock-custom-panel" aria-label="Custom Filter"><strong>Custom Filter</strong><div class="stock-custom-fields"><label for="stock-category">Category<select id="stock-category"><option value="">All Categories</option><% [...new Set(items.map(i=>i.category))].sort().forEach(c=>{ %><option><%= c %></option><% }); %></select></label><label for="stock-size">Size (ml)<select id="stock-size"><option value="">All Sizes</option><% [...new Set(items.map(i=>String(i.size_ml||'')).filter(Boolean))].sort((a,b)=>Number(a)-Number(b)).forEach(size=>{ %><option value="<%= size %>"><%= size %> ml</option><% }); %></select></label></div><button id="stock-apply" type="button">Apply Filter</button></section></details></div><a id="stock-export" class="stock-export" href="/packaging/warehouse/export.xlsx">↓ Download Excel</a><button type="button" id="stock-reset">Reset</button><span id="stock-count" aria-live="polite"><%= items.length %> items</span></form><div id="stock-active-filters" hidden></div>
</div>
<div class="stock-table"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Categories</th><th>Size<br><small>(ml)</small></th><th>Opening <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/></svg></th><th>Stock In</th><th>Stock Out</th><th>Closing</th><th>Action</th></tr></thead><tbody><% items.forEach(i=>{ %><tr data-search="<%= ((i.item_code||'')+' '+i.item_name).toLowerCase() %>" data-category="<%= i.category %>" data-size="<%= String(i.size_ml||'') %>"><td><%= i.item_code || 'မချိတ်ရသေးပါ' %></td><td><%= i.item_name %></td><td><span class="stock-category-badge"><%= i.category %></span></td><td><%= i.size_ml || '—' %></td><td class="stock-opening-cell"><% if(i.opening_saved){ %><span class="stock-opening-saved"><strong><%= fmt(i.opening_qty) %></strong><span title="Opening locked" aria-label="Opening locked"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/></svg></span></span><% }else{ %><button type="button" class="stock-set-opening" data-opening-id="<%= i.id %>" data-opening-name="<%= i.item_name %>" data-opening-version="<%= i.version %>">＋ Set Opening</button><% } %></td><td><span class="stock-move-in">+<%= fmt(i.imported_stock_in) %></span></td><td><span class="stock-move-out">−<%= fmt(i.imported_stock_out) %></span></td><td><strong><%= fmt(i.closing_qty) %></strong></td><td><button type="button" class="stock-ledger-button" data-ledger-id="<%= i.id %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="6" y="5" width="13" height="16" rx="2"/><rect x="9" y="2" width="7" height="5" rx="2" fill="white"/></svg><span>View Ledger</span></button></td></tr><% }); %></tbody></table><p id="stock-empty" hidden>ကိုက်ညီသော ပစ္စည်းမရှိပါ။</p></div>
<dialog id="stock-ledger" aria-labelledby="stock-ledger-title"><header><div id="stock-ledger-meta"></div><button type="button" data-ledger-close aria-label="Close ledger">×</button><h2 id="stock-ledger-title">Item Ledger</h2></header><div id="stock-ledger-totals"></div><nav class="stock-ledger-tabs" aria-label="Ledger filters"><strong>Movement Ledger</strong><button type="button" data-ledger-type="ALL">All</button><button type="button" data-ledger-type="IN">Stock In</button><button type="button" data-ledger-type="OUT">Stock Out</button></nav><div id="stock-ledger-rows" aria-live="polite"></div></dialog>

<dialog id="stock-opening-dialog" aria-labelledby="stock-opening-title"><form method="post" id="stock-opening-form"><header><h2 id="stock-opening-title">Set Opening</h2><button type="button" data-opening-close aria-label="Close opening form">×</button></header><p id="stock-opening-item"></p><p class="stock-opening-warning">Opening ကို တစ်ကြိမ်သာ သိမ်းနိုင်ပါသည်။ Save ပြီးပါက ပြန်ပြင်၍ မရပါ။</p><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version"><label>Opening Qty · pcs<input name="opening_qty" type="number" min="0" max="999999999999.999" step="0.001" required></label><footer><button type="button" data-opening-close>Cancel</button><button type="submit">Save Opening</button></footer></form></dialog>