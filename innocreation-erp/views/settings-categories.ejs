<p class="muted">ဤ Category များကို Raw Oil In / Out နှစ်ခုလုံးတွင် ရွေးချယ်အသုံးပြုနိုင်ပါသည်။</p>
<% if(error){ %><div class="error" role="alert"><%= error %></div><% } %><% if(voided){ %><div class="settings-success" role="status">Category ကို Void လုပ်ပြီးပါပြီ။ In / Out Dropdown တွင် မပေါ်တော့ပါ။</div><% } %><% if(updated){ %><div class="settings-success" role="status">Category အမည် ပြောင်းပြီးပါပြီ။</div><% } %><% if(created){ %><div class="settings-success" role="status">Transaction Category အသစ် ဖန်တီးပြီးပါပြီ။ Raw Oil In / Out ကို ပြန်ဖွင့်လျှင် ရွေးနိုင်ပါသည်။</div><% } %>
<form class="settings-form" method="post" action="/settings/inventory/raw-oil/categories"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Create Transaction Category</h2><label for="category-name">Category Name *</label><input id="category-name" name="name" maxlength="100" value="<%= categoryName %>" placeholder="ဥပမာ — Production Usage" required><div class="settings-form-footer"><span class="settings-note">အမည်ထပ်၍ မဖန်တီးနိုင်ပါ။</span><button type="submit">Create Category →</button></div></form>
<div class="settings-toolbar"><form method="get"><input name="q" value="<%= q %>" placeholder="Search Category" aria-label="Search Category"><button>Search</button><a href="/settings/inventory/raw-oil/categories">Reset</a></form></div>
<div class="settings-table-wrap"><table><thead><tr><th>Category Name</th><th>Created By</th><th>Created At</th><th>Status</th><th>Action</th><th>Voided By / At</th></tr></thead><tbody><% categories.forEach(c=>{ %><tr><td><%= c.name %></td><td><%= c.created_name||'Initial setup' %></td><td><%= c.created_at||'—' %></td><td><%= Number(c.is_active??1)===0?'Voided':'Active' %></td><td><% if(c.name.trim().toLowerCase()==='adjustment'){ %><span class="settings-role">Locked</span><% }else if(Number(c.is_active??1)===0){ %>—<% }else{ %><a href="/settings/inventory/raw-oil/categories/<%= c.id %>/edit">Edit</a> · <a href="/settings/inventory/raw-oil/categories/<%= c.id %>/void">Void</a><% } %></td><td><%= c.voided_name||'—' %><% if(c.voided_at){ %><br><%= c.voided_at %><% } %></td></tr><% }); %><% if(!categories.length){ %><tr><td colspan="6">Category မတွေ့ပါ။</td></tr><% } %></tbody></table></div>
<div class="settings-pagination"><span><%= total %> categories · Page <%= pageNo %></span><div><% if(pageNo>1){ %><a href="?q=<%= encodeURIComponent(q) %>&p=<%= pageNo-1 %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?q=<%= encodeURIComponent(q) %>&p=<%= pageNo+1 %>">Next →</a><% } %></div></div>
