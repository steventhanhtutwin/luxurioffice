<% const base='/inventory/configuration/warehouses',url=patch=>base+'?'+new URLSearchParams({state:w.state,q:w.q,...patch}),canOrder=w.canEdit&&w.state==='all'&&!w.q&&w.counts.all<=50; %>
<section class="wl-page" data-warehouse-page data-csrf="<%= w.csrf %>" data-can-order="<%= canOrder?'1':'0' %>"><header class="wl-heading"><span class="wl-heading-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m3 7 9-5 9 5v3H3zM4 21h16M5 10v11M19 10v11M9 13v5M15 13v5"/></svg></span><div><div class="wl-title-line"><h1>Warehouses</h1><span class="wl-total"><%= w.counts.all %> total</span></div><p>Manage physical storage facilities, stock locations, and township addresses.</p></div><div class="wl-heading-actions"><details class="wl-settings"><summary aria-label="Settings" title="Settings"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="19.21,9.02 19.63,10.38 21.88,10.44 21.88,13.56 19.63,13.62 19.21,14.98 18.54,16.25 20.09,17.88 17.88,20.09 16.25,18.54 14.98,19.21 13.62,19.63 13.56,21.88 10.44,21.88 10.38,19.63 9.02,19.21 7.75,18.54 6.12,20.09 3.91,17.88 5.46,16.25 4.79,14.98 4.37,13.62 2.12,13.56 2.12,10.44 4.37,10.38 4.79,9.02 5.46,7.75 3.91,6.12 6.12,3.91 7.75,5.46 9.02,4.79 10.38,4.37 10.44,2.12 13.56,2.12 13.62,4.37 14.98,4.79 16.25,5.46 17.88,3.91 20.09,6.12 18.54,7.75"/><circle cx="12" cy="12" r="3.2"/></svg></summary><div><a href="<%= base %>/export.xlsx?<%= new URLSearchParams({state:w.state,q:w.q}) %>">↓ Export to Excel</a></div></details><% if(w.canEdit){ %><button type="button" class="wl-new" data-new-warehouse>＋ New Warehouse</button><% } %></div></header><p class="wl-feedback" role="status" hidden></p><section class="wl-card"><div class="wl-toolbar"><nav aria-label="Warehouse status"><% for(const [id,label] of [['all','All'],['active','Active'],['archived','Archived']]){ %><a class="<%= w.state===id?'active':'' %>" href="<%= url({state:id,p:'1'}) %>"><%= id==='active'?'● ':id==='archived'?'● ':'' %><%= label %> <b><%= w.counts[id] %></b></a><% } %></nav><form method="get"><input type="hidden" name="state" value="<%= w.state %>"><input name="q" value="<%= w.q %>" placeholder="Search name, stock code, township…" aria-label="Search warehouses"><button aria-label="Search">⌕</button></form><span class="wl-range"><%= w.total?(w.page-1)*50+1:0 %>–<%= Math.min(w.page*50,w.total) %> of <%= w.total %></span><div class="wl-paging"><% if(w.page>1){ %><a href="<%= url({p:String(w.page-1)}) %>" aria-label="Previous page">‹</a><% }else{ %><span>‹</span><% }if(w.page<w.pages){ %><a href="<%= url({p:String(w.page+1)}) %>" aria-label="Next page">›</a><% }else{ %><span>›</span><% } %></div></div><div class="wl-table-wrap"><table class="wl-table"><thead><tr><th><button type="button" data-sort="name">Warehouse ↕</button></th><th><button type="button" data-sort="stock_code">Location Stock ↕</button></th><th>Address</th><th>Township</th><th>Actions</th></tr></thead><tbody data-warehouse-rows><% for(const row of w.rows){ %><tr data-warehouse-row data-id="<%= row.id %>" data-values="<%= JSON.stringify(row) %>" tabindex="0" aria-label="<%= w.canEdit?'Edit':'View' %> <%= row.name %>"><td><div class="wl-name"><strong><%= row.name %></strong><span class="wl-badge <%= Number(row.archived)?'archived':'active' %>">● <%= Number(row.archived)?'Archived':'Active' %></span></div><% if(row.note){ %><small><%= row.note %></small><% } %></td><td><span class="wl-code">◇ <%= row.stock_code||'—' %></span></td><td class="wl-address"><%= row.address||'—' %></td><td><%= row.township||'—' %><small><%= row.city||'—' %></small></td><td class="wl-actions"><% if(w.canEdit){ %><button type="button" data-action="<%= Number(row.archived)?'restore':'archive' %>" aria-label="<%= Number(row.archived)?'Restore':'Archive' %> <%= row.name %>" title="<%= Number(row.archived)?'Restore':'Archive' %>"><%- Number(row.archived)?'↻':'<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16v13H4zM3 3h18v4H3zM9 11h6"/></svg>' %></button><button type="button" data-edit aria-label="Edit <%= row.name %>" title="Edit">✎</button><% }else{ %><button type="button" data-edit aria-label="View <%= row.name %>">↗</button><% } %></td></tr><% }if(!w.rows.length){ %><tr><td colspan="5" class="wl-empty">No warehouses found.</td></tr><% } %></tbody></table></div></section><p class="wl-tip">Click a row to <%= w.canEdit?'inspect & edit':'inspect' %>. <span>Unicode Support: Myanmar (UTF-8)</span></p>
<dialog class="wl-dialog wl-modern-dialog"><form data-edit-form><header><div><p class="wl-dialog-code" data-dialog-code>—</p><h2 data-dialog-title><%= w.canEdit?'Edit':'View' %> Warehouse</h2></div><button type="button" data-close aria-label="Close">×</button></header><input type="hidden" name="id"><input type="hidden" name="revision"><div class="wl-form-fields"><div class="wl-status-card"><div><strong>Warehouse Status</strong><p>Choose Active or Archived</p></div><label class="wl-status-switch"><input type="checkbox" role="switch" aria-label="Warehouse Active" name="status_active" <%= !w.canEdit?'disabled':'' %>><span aria-hidden="true"></span><b data-status-label>Active</b></label></div><label class="wl-wide">Warehouse Name *<input name="name" maxlength="120" required <%= !w.canEdit?'readonly':'' %>></label><label>Short Code *<input name="short_code" maxlength="3" minlength="3" pattern="[A-Za-z]{3}" required placeholder="e.g. SOW" autocomplete="off" <%= !w.canEdit?'readonly':'' %>></label><label>Location Stock *<input name="stock_code" readonly tabindex="-1" aria-describedby="wl-code-help"><small id="wl-code-help">Generated from Short Code</small></label><label>Township<input name="township" maxlength="150" <%= !w.canEdit?'readonly':'' %>></label><label>City / Region<input name="city" maxlength="150" <%= !w.canEdit?'readonly':'' %>></label><label class="wl-wide">Street Address (Myanmar / English)<textarea name="address" maxlength="500" rows="3" <%= !w.canEdit?'readonly':'' %>></textarea></label><label class="wl-wide">Notes<textarea name="note" maxlength="500" rows="2" <%= !w.canEdit?'readonly':'' %>></textarea></label></div><p data-dialog-error role="alert" hidden></p><footer><button type="button" data-close>Cancel</button><% if(w.canEdit){ %><button type="submit" class="wl-save">Save Changes</button><% } %></footer></form></dialog></section>
