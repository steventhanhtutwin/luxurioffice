<% const inventoryView=['inventory-home','categories','category-edit','category-void'].includes(view);const userView=['user-management','new','list','edit','reset','departments','department-edit','department-void'].includes(view);const settingsTitle=({'home':'Settings','user-management':'User Management','departments':'Department List','department-edit':'Edit Department','department-void':'Void Department','inventory-home':'Inventory Setting','categories':'Raw Oil Transaction Categories','category-edit':'Edit Transaction Category','category-void':'Void Transaction Category','new':'Add User','list':'User List','edit':'Edit User','reset':'Reset Password'})[view]||'Settings'; %>
<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= settingsTitle %> | Innocreation ERP</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/workspace.css"><link rel="stylesheet" href="/settings.css"></head><body class="app-home"><header class="app-header"><a class="app-logo" href="/dashboard">INNOCREATION <span>/ ERP</span></a><div class="account-area"><a class="back-link" href="/dashboard">← Main Dashboard</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="logout">Logout</button></form></div></header><div class="settings-layout"><aside class="settings-sidebar"><p class="eyebrow">ADMINISTRATION</p><nav aria-label="Settings"><details class="settings-nav-group" <%= userView||view==='home'?'open':'' %>><summary>User Management</summary><div><a href="/settings/users" class="<%= ['list','edit','reset'].includes(view)?'active':'' %>">User List</a><a href="/settings/users/new" class="<%= view==='new'?'active':'' %>">Add User</a><a href="/settings/departments" class="<%= ['departments','department-edit','department-void'].includes(view)?'active':'' %>">Department List</a></div></details><details class="settings-nav-group" <%= inventoryView||view==='home'?'open':'' %>><summary>Inventory Setting</summary><div><a href="/settings/inventory/raw-oil/categories" class="<%= ['categories','category-edit','category-void'].includes(view)?'active':'' %>">Raw Oil Transaction Categories</a></div></details></nav><span class="settings-admin-tag">ADMIN ACCESS</span></aside><main class="settings-main"><p class="eyebrow"><%= view==='home'?'ADMINISTRATION / SETTINGS':inventoryView?'SETTINGS / INVENTORY':'SETTINGS / USER MANAGEMENT' %></p><h1><%= settingsTitle %></h1>
<% if(view==='home'){ %><p class="muted">အသုံးပြုသူနှင့် Inventory သတ်မှတ်ချက်များကို စီမံရန်။</p><div class="settings-cards"><a class="settings-card" href="/settings/user-management"><span class="settings-symbol" aria-hidden="true">≡</span><h2>User Management</h2><p>User List နှင့် Add User ကို စီမံရန်။</p><span>Open menu →</span></a><a class="settings-card" href="/settings/inventory"><span class="settings-symbol" aria-hidden="true">⚙</span><h2>Inventory Setting</h2><p>Raw Oil အဝင် / အထွက် Transaction Category များ သတ်မှတ်ရန်။</p><span>Open menu →</span></a></div>
<% }else if(view==='user-management'){ %><div class="settings-cards"><a class="settings-card" href="/settings/users"><h2>User List</h2><p>ဝန်ထမ်းအကောင့်များ၊ Role နှင့် Password Reset ကို စီမံရန်။</p><span>Open menu →</span></a><a class="settings-card" href="/settings/users/new"><h2>Add User</h2><p>အကောင့်အသစ် ဖန်တီးရန်။</p><span>Open menu →</span></a></div>
<% }else if(view==='inventory-home'){ %><div class="settings-cards"><a class="settings-card" href="/settings/inventory/raw-oil/categories"><h2>Raw Oil Transaction Categories</h2><p>Raw Oil In / Out နှစ်ခုလုံးတွင် ရွေးမည့် Category များကို ဖန်တီးရန်။</p><span>Open menu →</span></a></div>
<% }else if(['departments','department-edit','department-void'].includes(view)){ %><%- include('settings-departments') %>
<% }else if(view==='category-void'){ %><%- include('settings-category-void',{category,csrf}) %>
<% }else if(view==='category-edit'){ %><%- include('settings-category-edit',{category,categoryName,error,csrf}) %>
<% }else if(view==='categories'){ %><%- include('settings-categories',{categories,q,pageNo,total,categoryName,created,updated,voided,error,csrf}) %>
<% }else if(view==='reset'){ %><section class="settings-form"><h2>Reset Password အတည်ပြုရန်</h2><p><strong><%= values.display_name %></strong> (<%= values.username %>)</p><p class="settings-note">ဤ User ၏ Password ကို <strong>123456</strong> ပြန်သတ်မှတ်မည်။ Login Session ဟောင်းများဖြင့် ဆက်သုံး၍ မရတော့ပါ။ ပြန်ဝင်ပြီး My Profile မှ Password ပြောင်းနိုင်ပါသည်။</p><form method="post" action="/settings/users/<%= values.id %>/reset-password"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="confirm_reset" value="yes"><div class="settings-form-footer"><a href="/settings/users/<%= values.id %>/edit">Cancel</a><button type="submit">Confirm Reset Password</button></div></form></section>
<% }else if(view==='new'||view==='edit'){const v=values; %><p class="muted"><%= view==='new'?'ဝန်ထမ်းအတွက် Login အကောင့်အသစ် ဖန်တီးပါ။':'ဝန်ထမ်းအချက်အလက်နှင့် User Role ကို ပြင်ဆင်ပါ။' %></p><% if(error){ %><div class="error" role="alert"><%= error %></div><% } %><% if(reset){ %><div class="settings-success" role="status">Password ကို 123456 ပြန်သတ်မှတ်ပြီးပါပြီ။ ဤ User သည် Login ပြန်ဝင်ရပါမည်။</div><% } %><form class="settings-form" method="post" action="<%= view==='new'?'/settings/users/new':'/settings/users/'+v.id+'/edit' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="settings-fields"><div><label for="staff-name">Staff Name</label><input id="staff-name" name="display_name" value="<%= v.display_name||'' %>" maxlength="150" required></div><div><label for="username">User Name</label><input id="username" name="username" value="<%= v.username||'' %>" maxlength="100" autocomplete="off" <%= view==='edit'?'readonly':'required' %>></div><div><label for="position">Position</label><input id="position" name="position" value="<%= v.position||'' %>" maxlength="150" placeholder="ရာထူးအမည်"></div><div><label for="department">Department</label><select id="department" name="department_id"><option value="">Department မသတ်မှတ်ရသေး</option><% (typeof departments==='undefined'?[]:departments).forEach(d=>{ %><option value="<%= d.id %>" <%= String(v.department_id)===String(d.id)?'selected':'' %>><%= d.name %><%= Number(d.is_active)===0?' (Voided — လက်ရှိ Department)':'' %></option><% }); %></select></div><div><label for="role">User Role</label><select id="role" name="role" required><option value="">Role ရွေးပါ</option><% roles.forEach(role=>{ %><option value="<%= role.value %>" <%= v.role===role.value?'selected':'' %>><%= role.label %></option><% }); %></select></div><% if(view==='new'){ %><div><label for="initial-password">Password</label><input id="initial-password" name="password" type="password" autocomplete="new-password" minlength="5" maxlength="256" placeholder="အနည်းဆုံး ၅ လုံး" required></div><div><label for="confirm-password">Confirm Password</label><input id="confirm-password" name="confirm_password" type="password" autocomplete="new-password" minlength="5" maxlength="256" required></div><% } %></div><p class="settings-note"><%= view==='new'?'ဤအကောင့်ဖြင့် Login ဝင်ပြီး My Profile မှ Password ပြောင်းနိုင်ပါသည်။':'Role ပြောင်းလဲပါက ထို User သည် Login ပြန်ဝင်ရပါမည်။' %></p><div class="settings-form-footer"><a href="/settings/users">← User List</a><button><%= view==='new'?'Create User':'Save Changes' %> →</button></div></form><% if(view==='edit'){ %><section class="settings-form"><h2>Reset Password</h2><p class="settings-note">Password မေ့နေပါက 123456 ပြန်သတ်မှတ်ပေးနိုင်ပါသည်။</p><a class="settings-reset-link" href="/settings/users/<%= v.id %>/reset-password">Reset Password →</a></section><% } %>
<% }else if(view==='list'){ %><p class="muted">User အကောင့်များနှင့် သတ်မှတ်ထားသော Role များ။</p><% if(created||updated){ %><div class="settings-success" role="status"><%= created?'User အသစ် ဖန်တီးပြီးပါပြီ။':'အချက်အလက်များ ပြင်ဆင်ပြီးပါပြီ။' %></div><% } %><div class="settings-toolbar"><form method="get"><input name="q" value="<%= q %>" placeholder="User Name / Staff Name" aria-label="Search users"><button>Search</button><a href="/settings/users">Reset</a></form><a class="settings-add" href="/settings/users/new">+ Add User</a></div><div class="settings-table-wrap"><table><thead><tr><th>Staff Name</th><th>User Name</th><th>Position</th><th>Department</th><th>User Role</th><th>Status</th><th>Action</th></tr></thead><tbody><% users.forEach(account=>{ %><tr><td><%= account.display_name %></td><td><%= account.username %></td><td><%= account.position||'—' %></td><td><%= account.department_name||'—' %><%= account.department_name&&Number(account.department_active)===0?' (Voided)':'' %></td><td><span class="settings-role"><%= roleLabel(account.role) %></span></td><td><%= account.is_active?'Active':'Inactive' %></td><td><a href="/settings/users/<%= account.id %>/edit">Edit</a></td></tr><% }); %><% if(!users.length){ %><tr><td colspan="7">User မတွေ့ပါ။</td></tr><% } %></tbody></table></div><div class="settings-pagination"><span><%= total %> users · Page <%= pageNo %></span><div><% if(pageNo>1){ %><a href="?q=<%= encodeURIComponent(q) %>&p=<%= pageNo-1 %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?q=<%= encodeURIComponent(q) %>&p=<%= pageNo+1 %>">Next →</a><% } %></div></div><% } %></main></div></body></html>
