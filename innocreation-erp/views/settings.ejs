<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= view==='new'?'Add User':view==='reset'?'Reset Password':view==='edit'?'Edit User':view==='list'?'User List':'Settings' %> | Innocreation ERP</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/workspace.css"><link rel="stylesheet" href="/settings.css"></head><body class="app-home"><header class="app-header"><a class="app-logo" href="/dashboard">INNOCREATION <span>/ ERP</span></a><div class="account-area"><a class="back-link" href="/dashboard">← Main Dashboard</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="logout">Logout</button></form></div></header><div class="settings-layout"><aside class="settings-sidebar"><p class="eyebrow">ADMINISTRATION</p><nav aria-label="Settings"><a href="/settings" class="<%= view==='home'?'active':'' %>" <% if(view==='home'){ %>aria-current="page"<% } %>>Settings Dashboard</a><a href="/settings/users/new" class="<%= view==='new'?'active':'' %>" <% if(view==='new'){ %>aria-current="page"<% } %>>Add User</a><a href="/settings/users" class="<%= view==='list'||view==='edit'||view==='reset'?'active':'' %>" <% if(view==='list'){ %>aria-current="page"<% } %>>User List</a></nav><span class="settings-admin-tag">ADMIN ACCESS</span></aside><main class="settings-main"><p class="eyebrow">SETTINGS / USER MANAGEMENT</p><h1><%= view==='new'?'Add User':view==='reset'?'Reset Password':view==='edit'?'Edit User':view==='list'?'User List':'Settings' %></h1>
<% if(view==='home'){ %><p class="muted">အသုံးပြုသူအကောင့်နှင့် Role များကို စီမံခန့်ခွဲရန်။</p><div class="settings-cards"><a class="settings-card" href="/settings/users/new"><span class="settings-symbol" aria-hidden="true">+</span><h2>Add User</h2><p>ဝန်ထမ်းအကောင့်အသစ် ဖန်တီးပြီး Role သတ်မှတ်ရန်။</p><span>Open menu →</span></a><a class="settings-card" href="/settings/users"><span class="settings-symbol" aria-hidden="true">≡</span><h2>User List</h2><p>အကောင့်စာရင်းကြည့်ရန်နှင့် ဝန်ထမ်းအချက်အလက်၊ Role ပြင်ဆင်ရန်။</p><span>Open menu →</span></a></div>
<% }else if(view==='reset'){ %><section class="settings-form"><h2>Reset Password အတည်ပြုရန်</h2><p><strong><%= values.display_name %></strong> (<%= values.username %>)</p><p class="settings-note">ဤ User ၏ Password ကို <strong>123456</strong> ပြန်သတ်မှတ်မည်။ Login Session ဟောင်းများဖြင့် ဆက်သုံး၍ မရတော့ပါ။ ပြန်ဝင်ပြီး My Profile မှ Password ပြောင်းနိုင်ပါသည်။</p><form method="post" action="/settings/users/<%= values.id %>/reset-password"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="confirm_reset" value="yes"><div class="settings-form-footer"><a href="/settings/users/<%= values.id %>/edit">Cancel</a><button type="submit">Confirm Reset Password</button></div></form></section>
<% }else if(view==='new'||view==='edit'){const v=values; %><p class="muted"><%= view==='new'?'ဝန်ထမ်းအတွက် Login အကောင့်အသစ် ဖန်တီးပါ။':'ဝန်ထမ်းအချက်အလက်နှင့် User Role ကို ပြင်ဆင်ပါ။' %></p><% if(error){ %><div class="error" role="alert"><%= error %></div><% } %><% if(reset){ %><div class="settings-success" role="status">Password ကို 123456 ပြန်သတ်မှတ်ပြီးပါပြီ။ ဤ User သည် Login ပြန်ဝင်ရပါမည်။</div><% } %><form class="settings-form" method="post" action="<%= view==='new'?'/settings/users/new':'/settings/users/'+v.id+'/edit' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="settings-fields"><div><label for="staff-name">Staff Name</label><input id="staff-name" name="display_name" value="<%= v.display_name||'' %>" maxlength="150" required></div><div><label for="username">User Name</label><input id="username" name="username" value="<%= v.username||'' %>" maxlength="100" autocomplete="off" <%= view==='edit'?'readonly':'required' %>></div><div><label for="position">Position</label><input id="position" name="position" value="<%= v.position||'' %>" maxlength="150" placeholder="ရာထူးအမည်"></div><div><label for="role">User Role</label><select id="role" name="role" required><option value="">Role ရွေးပါ</option><% roles.forEach(role=>{ %><option value="<%= role.value %>" <%= v.role===role.value?'selected':'' %>><%= role.label %></option><% }); %></select></div><% if(view==='new'){ %><div><label for="initial-password">Password</label><input id="initial-password" name="password" type="password" autocomplete="new-password" minlength="5" maxlength="256" placeholder="အနည်းဆုံး ၅ လုံး" required></div><div><label for="confirm-password">Confirm Password</label><input id="confirm-password" name="confirm_password" type="password" autocomplete="new-password" minlength="5" maxlength="256" required></div><% } %></div><p class="settings-note"><%= view==='new'?'ဤအကောင့်ဖြင့် Login ဝင်ပြီး My Profile မှ Password ပြောင်းနိုင်ပါသည်။':'Role ပြောင်းလဲပါက ထို User သည် Login ပြန်ဝင်ရပါမည်။' %></p><div class="settings-form-footer"><a href="/settings/users">← User List</a><button><%= view==='new'?'Create User':'Save Changes' %> →</button></div></form><% if(view==='edit'){ %><section class="settings-form"><h2>Reset Password</h2><p class="settings-note">Password မေ့နေပါက 123456 ပြန်သတ်မှတ်ပေးနိုင်ပါသည်။</p><a class="settings-reset-link" href="/settings/users/<%= v.id %>/reset-password">Reset Password →</a></section><% } %>
<% }else if(view==='list'){ %><p class="muted">User အကောင့်များနှင့် သတ်မှတ်ထားသော Role များ။</p><% if(created||updated){ %><div class="settings-success" role="status"><%= created?'User အသစ် ဖန်တီးပြီးပါပြီ။':'အချက်အလက်များ ပြင်ဆင်ပြီးပါပြီ။' %></div><% } %><div class="settings-toolbar"><form method="get"><input name="q" value="<%= q %>" placeholder="User Name / Staff Name" aria-label="Search users"><button>Search</button><a href="/settings/users">Reset</a></form><a class="settings-add" href="/settings/users/new">+ Add User</a></div><div class="settings-table-wrap"><table><thead><tr><th>Staff Name</th><th>User Name</th><th>Position</th><th>User Role</th><th>Status</th><th>Action</th></tr></thead><tbody><% users.forEach(account=>{ %><tr><td><%= account.display_name %></td><td><%= account.username %></td><td><%= account.position||'—' %></td><td><span class="settings-role"><%= roleLabel(account.role) %></span></td><td><%= account.is_active?'Active':'Inactive' %></td><td><a href="/settings/users/<%= account.id %>/edit">Edit</a></td></tr><% }); %><% if(!users.length){ %><tr><td colspan="6">User မတွေ့ပါ။</td></tr><% } %></tbody></table></div><div class="settings-pagination"><span><%= total %> users · Page <%= pageNo %></span><div><% if(pageNo>1){ %><a href="?q=<%= encodeURIComponent(q) %>&p=<%= pageNo-1 %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?q=<%= encodeURIComponent(q) %>&p=<%= pageNo+1 %>">Next →</a><% } %></div></div><% } %></main></div></body></html>
