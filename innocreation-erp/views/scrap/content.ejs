<% const s=scrap,base='/inventory/scrap-management',fmt=(n,d=3)=>n==null?'—':Number(n).toLocaleString('en-US',{maximumFractionDigits:d}),url=(extra={})=>base+'?'+new URLSearchParams({tab:s.f?.tab||'drafts',q:s.f?.q||'',reason:s.f?.reason||'',warehouse:s.f?.warehouse||'',...extra}).toString(); %>
<div class="sc-title"><div><h1>Scrap Management</h1><p>ပျက်စီး၊ သက်တမ်းကုန် ပစ္စည်းများနှင့် Stock Write-off မှတ်တမ်း</p></div><% if(s.creators.includes(s.actor.role)&&!s.record){ %><a href="<%= url({tab:'drafts',new:'1'}) %>" class="sc-primary">＋ New Scrap</a><% } %><% if(s.record){ %><a href="<%= base %>?tab=<%= s.record.status==='POSTED'?'posted':s.record.status==='DRAFT'?'drafts':'pending' %>" class="sc-link">← Back to Scrap Management</a><% } %></div>
<% if(s.record){ const r=s.record,permission=s.canAct(s.actor,r); %>
<section class="sc-card sc-detail"><div class="sc-detail-head"><div><small><%= r.scrap_no %></small><h2><%= r.item_name %></h2><p><%= r.item_code %> · <%= r.source_type %></p></div><span class="sc-badge <%= r.status==='POSTED'?'posted':r.status==='DRAFT'?'draft':'pending' %>"><%= s.labels[r.status] %></span></div><dl class="sc-facts"><div><dt>Warehouse</dt><dd><%= r.warehouse_name %></dd></div><div><dt>Batch / Lot #</dt><dd><%= r.batch_no||'—' %></dd></div><div><dt>Qty</dt><dd><%= fmt(r.qty) %> <%= r.unit %></dd></div><div><dt>Recorded Unit Cost</dt><dd><%= fmt(r.unit_cost,4) %></dd></div><div><dt>Total Value</dt><dd><%= fmt(r.total_value,4) %></dd></div><div><dt>Reason</dt><dd><%= s.reasons[r.reason] %></dd></div></dl><h3>Remark</h3><p class="sc-note"><%= r.remark %></p><% if(r.rejection_reason){ %><p class="sc-warning">Returned: <%= r.rejection_reason %></p><% } %><% if(r.stock_reference){ %><p class="sc-success">Stock Reference: <%= r.stock_reference %> · Posted records are locked.</p><% } %><%- include('actions',{r,s,csrf}) %><% if(s.document){ %><section class="sc-document"><h3>Scrap Entry Details</h3><p>Quarantine Date: <%= s.document.quarantine_date instanceof Date?s.document.quarantine_date.toLocaleDateString('en-CA',{timeZone:'Asia/Bangkok'}):String(s.document.quarantine_date).slice(0,10) %> · Zone Bin: <%= s.document.zone_bin||'—' %></p><p>Each line has its own approval and stock posting record.</p><ul><% for(const line of s.document.lines){ %><li><a href="<%= base %>/<%= line.id %>"><%= line.scrap_no %></a> · <%= line.item_name %> · <%= line.qty %> <%= line.unit %> · <%= s.labels[line.status] %></li><% } %></ul><% for(const e of s.document.evidence){ %><a class="sc-evidence-download" href="<%= base %>/evidence/<%= e.token %>" download>↓ <%= e.original_name %></a><% } %></section><% } %><h3>Audit Trail</h3><ol class="sc-audit"><% for(const e of s.events){ %><li><strong><%= e.action.replace(/_/g,' ') %></strong><span><%= e.actor_name||'—' %> · <%= e.created_at instanceof Date?e.created_at.toLocaleString('en-GB',{timeZone:'Asia/Bangkok'}):e.created_at %> · Asia/Bangkok</span><p><%= e.note %></p></li><% } %></ol></section>
<% }else{ %>
<section class="sc-card"><div class="sc-top"><nav aria-label="Scrap status" class="sc-tabs"><% for(const [key,label,icon] of [['drafts','Quarantine / Drafts','▣'],['pending','Pending Approval','◷'],['posted','Approved & Posted','✓']]){ %><a href="<%= url({tab:key}) %>" class="<%= s.f.tab===key?'active':'' %>" <%- s.f.tab===key?'aria-current="page"':'' %>><span aria-hidden="true"><%= icon %></span><%= label %><b><%= s.counts[key] %></b></a><% } %></nav><p class="sc-help"><%= s.f.tab==='posted'?'Posted write-offs are locked. Stock has been deducted.':s.f.tab==='drafts'?'Quarantine drafts do not deduct stock.':'Supervisor review → Accountant approval → Stock write-off.' %></p></div>
<form class="sc-filters" method="get" action="<%= base %>"><input type="hidden" name="tab" value="<%= s.f.tab %>"><label class="sc-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg><input type="search" name="q" maxlength="100" value="<%= s.f.q %>" placeholder="Search by Scrap ID, SKU, Item Name, or Batch #…" aria-label="Search scrap"></label><select name="reason" aria-label="Reason"><option value="">All Reasons</option><% for(const [key,label] of Object.entries(s.reasons)){ %><option value="<%= key %>" <%= s.f.reason===key?'selected':'' %>><%= key %> — <%= label %></option><% } %></select><select name="warehouse" aria-label="Warehouse"><option value="">All Warehouses</option><% for(const w of s.warehouses){ %><option value="<%= w.warehouse_id %>" <%= s.f.warehouse===String(w.warehouse_id)?'selected':'' %>><%= w.warehouse_name %></option><% } %></select><button type="submit" class="sc-filter-button">Search</button><a href="<%= base %>?tab=<%= s.f.tab %>" class="sc-link">Reset</a></form>
<div class="sc-table-wrap"><table class="sc-table"><thead><tr><% for(const label of ['Scrap ID','Date','SKU & Item Name','Batch / Lot #','Warehouse','Qty','Unit Cost','Total Value','Reason','Status','Quick Actions']){ %><th><%= label %></th><% } %></tr></thead><tbody><% for(const r of s.rows){ %><tr><td><a class="sc-id" href="<%= base %>/<%= r.id %>"><%= r.scrap_no %></a></td><td class="sc-nowrap"><%= r.created_at instanceof Date?r.created_at.toLocaleDateString('en-CA',{timeZone:'Asia/Bangkok'}):String(r.created_at).slice(0,10) %></td><td><strong><%= r.item_name %></strong><small><%= r.item_code %></small></td><td><%= r.batch_no||'—' %></td><td><%= r.warehouse_name %></td><td class="sc-number"><strong><%= fmt(r.qty) %></strong><small><%= r.unit %></small></td><td class="sc-number"><%= fmt(r.unit_cost,4) %></td><td class="sc-number"><strong><%= fmt(r.total_value,4) %></strong></td><td><span class="sc-reason <%= r.reason==='EXP'?'expired':'' %>" title="<%= s.reasons[r.reason] %>"><%= r.reason %></span></td><td><span class="sc-badge <%= r.status==='POSTED'?'posted':r.status==='DRAFT'?'draft':'pending' %>"><%= s.labels[r.status] %></span></td><td><div class="sc-actions"><a class="sc-view" href="<%= base %>/<%= r.id %>" aria-label="<%= r.status==='POSTED'?'Audit Trail':'View' %> <%= r.scrap_no %>"><% if(r.status==='POSTED'){ %>▤ Audit Trail<% }else{ %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><% } %></a><%- include('actions',{r,s,csrf}) %></div></td></tr><% } %><% if(!s.rows.length){ %><tr><td colspan="11" class="sc-empty">သက်ဆိုင်ရာ Scrap မှတ်တမ်း မရှိသေးပါ။</td></tr><% } %></tbody></table></div>
<footer class="sc-footer"><span>Showing <%= s.rows.length %> of <%= s.counts[s.f.tab] %> records</span><nav aria-label="Scrap pages"><% if(s.f.page>1){ %><a href="<%= url({p:s.f.page-1}) %>">← Previous</a><% } %><span>Page <%= s.f.page %> / <%= s.pages %></span><% if(s.f.page<s.pages){ %><a href="<%= url({p:s.f.page+1}) %>">Next →</a><% } %></nav><span>Valuation: Recorded item cost · GL integration: Not connected</span></footer></section>
<% } %>
<% if(s.newForm&&s.creators.includes(s.actor.role)){ %><%- include('new-form',{s,csrf,base}) %><% } %>
<dialog id="sc-reject" class="sc-dialog"><header><h2>Return to Draft</h2><button type="button" data-close aria-label="Close">×</button></header><form method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Reject reason *<textarea name="reason" maxlength="500" rows="4" required></textarea></label><footer><button class="sc-danger" type="submit">Reject &amp; Return</button></footer></form></dialog>
