<dialog id="sc-new" class="sc-dialog sc-entry-dialog" open><header class="sc-entry-head"><div><div class="sc-entry-kicker"><span>NEW DOCUMENT</span><small>Reference assigned on save</small></div><h2>Create Inventory Scrap Entry</h2></div><a href="<%= base %>?tab=drafts" aria-label="Close New Scrap">×</a></header><% if(s.error){ %><p class="sc-warning" role="alert"><%= s.error %></p><% } %>
<form method="post" action="<%= base %>/new" id="sc-entry-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= s.key %>"><input type="hidden" name="lines" id="sc-lines-json" value=""><input type="hidden" name="evidence_token" id="sc-evidence-token" value="<%= s.draft.evidence_token||'' %>">
<textarea id="sc-initial-lines" hidden><%= s.draft.lines||'[]' %></textarea><div class="sc-entry-meta"><label>Source Warehouse <em>*</em><select name="warehouse_id" required><option value="<%= s.main.id %>">Main Warehouse</option></select></label><label>Quarantine Date <em>*</em><input type="date" name="quarantine_date" value="<%= s.draft.quarantine_date||s.today %>" max="<%= s.today %>" required></label><label>Quarantine Zone Bin<input name="zone_bin" maxlength="100" value="<%= s.draft.zone_bin||'' %>" placeholder="e.g. QTN-ZONE-A1"></label></div>
<div class="sc-entry-line-heading"><div><h3>SCRAP LINE ITEMS</h3><p>Select SKU to fetch current available stock and recorded item cost.</p></div><button type="button" id="sc-add-line" class="sc-add-line">＋ Add Line</button></div>
<div class="sc-sku-search"><label>Find SKU / Item<input id="sc-item-search" type="search" placeholder="Search item code or name…" autocomplete="off"></label><p id="sc-search-message" role="status"></p></div>
<select id="sc-item-options" hidden><option value="">Select SKU / Item</option><% for(const item of s.choices){ %><option value="<%= item.type %>:<%= item.id %>" data-code="<%= item.code %>"><%= item.code %> — <%= item.name %> (<%= item.type %>)</option><% } %></select>
<div class="sc-entry-table-wrap"><table class="sc-entry-lines"><thead><tr><th>SKU / Item</th><th>Batch / Lot #</th><th>Avail.</th><th>Scrap Qty</th><th>Reason</th><th>Line Total</th><th></th></tr></thead><tbody id="sc-entry-lines"></tbody></table></div>
<div class="sc-grand-total"><div>Total Lines: <strong id="sc-total-lines">1</strong><span> | </span>Total Units: <strong id="sc-total-units">—</strong></div><div>GRAND TOTAL WRITE-OFF: <strong id="sc-grand-value">—</strong></div></div>
<div class="sc-entry-bottom"><section><label for="sc-evidence-file">Inspection Photo / QC Evidence</label><label class="sc-upload" for="sc-evidence-file"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h5l2-3h4l2 3h5v14H3z"/><circle cx="12" cy="13" r="4"/></svg><strong>Click to attach damage photo</strong><small>JPG, PNG or QC PDF report (Max 10MB)</small><input id="sc-evidence-file" type="file" accept="image/jpeg,image/png,application/pdf"></label><p id="sc-evidence-status" role="status"><%= s.draft.evidence_token?'Previously uploaded evidence retained.':'' %></p></section><label>Quarantine &amp; Root-Cause Notes <em>*</em><textarea name="remark" maxlength="500" rows="5" placeholder="Describe physical condition, supplier batch issue, or handling incident…" required><%= s.draft.remark||'' %></textarea></label></div>
<p class="sc-help">Draft သိမ်းခြင်းဖြင့် Stock မလျော့ပါ။ Approval အပြီးမှ အမှန်တကယ် Stock posting date ဖြင့် လျော့ပါမည်။ Cost မသတ်မှတ်ထားပါက တန်ဖိုးကို “—” ပြပါသည်။</p><p id="sc-form-error" class="sc-warning" role="alert" hidden></p><footer><a class="sc-link" href="<%= base %>?tab=drafts">Cancel</a><button class="sc-primary" type="submit">Save Draft</button></footer></form>
</dialog>
<template id="sc-line-template"><tr><td><select class="sc-line-item" required aria-label="SKU / Item"></select><small class="sc-unit-cost">Unit Cost: —</small></td><td><input class="sc-line-batch" maxlength="100" aria-label="Batch / Lot #"></td><td><strong class="sc-available">—</strong><small class="sc-unit"></small></td><td><input class="sc-line-qty" type="number" min="0.001" step="0.001" max="999999999.999" required aria-label="Scrap Qty"></td><td><select class="sc-line-reason" required aria-label="Scrap Reason"><% for(const [key,label] of Object.entries(s.reasons)){ %><option value="<%= key %>" title="<%= label %>"><%= key %></option><% } %></select></td><td><strong class="sc-line-value">—</strong></td><td><button type="button" class="sc-remove-line" aria-label="Remove line">×</button></td></tr></template>
