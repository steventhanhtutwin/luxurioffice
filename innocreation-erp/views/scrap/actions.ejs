<% const permission=s.canAct(s.actor,r),base='/inventory/scrap-management'; %><% if(permission.submit){ %><form method="post" action="<%= base %>/<%= r.id %>/submit"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="sc-submit" type="submit">Submit</button></form><% } %><% if(permission.approve){ %><form method="post" action="<%= base %>/<%= r.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="sc-approve" type="submit" title="<%= r.status==='PENDING_ACCOUNTANT'?'Final approval deducts stock':'Supervisor approval; stock unchanged' %>"><%= r.status==='PENDING_ACCOUNTANT'?'Approve & Post':'Approve' %></button></form><button type="button" class="sc-danger" data-reject="<%= base %>/<%= r.id %>/reject">Reject</button><% } %>
