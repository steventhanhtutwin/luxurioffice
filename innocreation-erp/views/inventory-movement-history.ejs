<% const fmt=v=>v==null?'—':Number(v).toLocaleString('en-US',{maximumFractionDigits:3}),label=k=>({IN:'↑ Stock In',OUT:'↓ Stock Out',TRANSFER:'⇄ Internal Transfer',OPENING:'Opening'})[k]||k,url=patch=>h.base+'?'+new URLSearchParams({...h.filters,...patch}).toString(); %>
<section class="mh-page"><a class="mh-back" href="<%= h.item.href %>">← Back to Item Details</a><header class="mh-heading"><span class="mh-icon" aria-hidden="true">⇄</span><div><h1>Stock Movement History</h1><span class="mh-product"><%= h.item.code %> · <%= h.item.name %></span><p>Inbound stock, outbound dispatches &amp; department transfers</p></div><a class="mh-export" href="<%= h.base %>/export.csv?<%= new URLSearchParams(h.filters).toString() %>">↓ Export CSV</a></header>
<div class="mh-summary"><div><span>On Hand · Main Warehouse</span><strong><%= fmt(h.item.closing_qty) %> <small><%= h.item.unit %></small></strong></div><div><span>Stock In · Posted</span><strong class="mh-in"><%= fmt(h.item.stock_in) %> <small><%= h.item.unit %></small></strong></div><div><span>Stock Out · Posted</span><strong><%= fmt(h.item.stock_out) %> <small><%= h.item.unit %></small></strong></div><div><span>History Records</span><strong><%= h.counts.all %></strong></div></div>
<section class="mh-filters"><nav aria-label="Movement types"><% for(const [key,title] of [['','All Movements'],['IN','Stock In (↑)'],['OUT','Stock Out (↓)'],['TRANSFER','Internal Transfer (⇄)'],...(h.counts.OPENING?[['OPENING','Opening']]:[])]){ %><a class="<%= h.filters.kind===key?'active':'' %>" href="<%= url({kind:key,p:'1'}) %>" <%- h.filters.kind===key?'aria-current="page"':'' %>><%= title %> (<%= key?h.counts[key]:h.counts.all %>)</a><% } %></nav><form method="get"><input type="hidden" name="kind" value="<%= h.filters.kind %>"><label class="mh-search"><span>Search history</span><input name="q" value="<%= h.filters.q %>" placeholder="Reference, staff, department or remarks…"></label><label><span>Department / Warehouse</span><select name="department"><option value="">All Departments (From &amp; To)</option><% for(const d of h.departments){ %><option <%= h.filters.department===d?'selected':'' %>><%= d %></option><% } %></select></label><label><span>From date</span><input type="date" name="from" value="<%= h.filters.from %>"></label><label><span>To date</span><input type="date" name="to" value="<%= h.filters.to %>"></label><button>Search</button><a class="mh-reset" href="<%= h.base %>">Reset</a></form></section>
<p class="mh-help"><%= h.total %> matching records · Balance After refers to Main Warehouse. Pending, rejected and voided records do not change its balance. “—” means information was not recorded.</p>
<div class="mh-table-wrap"><table class="mh-table"><thead><tr><th>Date &amp; Reference #</th><th>Movement Type</th><th>Transfer Route (From → To)</th><th>Quantity</th><th>Balance After</th><th>Handled By</th></tr></thead><tbody><% if(!h.rows.length){ %><tr><td colspan="6" class="mh-empty">No stock movements found.</td></tr><% }for(const row of h.rows){ %><tr><td colspan="6" class="mh-row-cell"><details class="mh-record"><summary><span><strong><%= row.reference||'—' %></strong><small><%= row.date %><%= row.clock?' · '+row.clock:'' %></small></span><span><b class="mh-badge <%= row.kind==='IN'?'is-in':row.kind==='OUT'?'is-out':'' %>"><%= label(row.kind) %></b></span><span class="mh-route"><span><%= row.from_name||'—' %></span><i>→</i><span><%= row.to_name||'—' %></span></span><span class="mh-qty <%= row.kind==='IN'?'mh-in':'' %>"><%= row.kind==='IN'?'+':row.kind==='OUT'?'−':'' %><%= fmt(row.qty) %> <%= h.item.unit %></span><span class="mh-balance"><%= fmt(row.balance) %> <%= row.balance==null?'':h.item.unit %></span><span class="mh-person"><b><%= row.actor_name||'—' %></b><small><%= row.statusLabel %></small></span></summary><div class="mh-expanded"><dl><div><dt>Batch / Lot No.</dt><dd>—</dd></div><div><dt>Source Bin</dt><dd>—</dd></div><div><dt>Destination Bin</dt><dd>—</dd></div><div><dt>Approval Status</dt><dd><%= row.statusLabel %></dd></div></dl><p><span>Remarks / Transfer Note:</span> <%= row.remark||'—' %></p><% if(row.href){ %><a href="<%= row.href %>">View Source Document →</a><a href="<%= row.printHref %>" target="_blank" rel="noopener">Print Transfer Slip</a><% } %></div></details></td></tr><% } %></tbody></table></div><footer class="mh-pagination"><span>Page <%= h.page %> of <%= h.pages %> · 50 records per page</span><% if(h.page>1){ %><a href="<%= url({p:String(h.page-1)}) %>">← Previous</a><% }if(h.page<h.pages){ %><a href="<%= url({p:String(h.page+1)}) %>">Next →</a><% } %></footer></section>
