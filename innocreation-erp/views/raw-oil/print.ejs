<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Raw Oil <%= tx.voucher %></title><% if(pdfMode){ %><style><%- css %></style><% }else{ %><link rel="stylesheet" href="/fg-print.css"><script src="/fg-print.js" defer></script><% } %></head><body>
<% if(!pdfMode){ %><nav class="print-controls"><a href="/inventory/raw-oil/transactions/<%= tx.id %>">← Back to transaction</a><button id="print-document" type="button">Print / Save as PDF</button><a href="/inventory/raw-oil/transactions/<%= tx.id %>/pdf">↓ Download PDF</a></nav><% } %>
<main class="print-sheet"><header class="report-heading"><div><p class="brand">INNOCREATION</p><p class="report-label">RAW OIL / WAREHOUSE</p><h1><%= tx.direction==='IN'?'Stock In Voucher':'Stock Out Voucher' %></h1></div><div class="report-ref"><strong><%= tx.voucher %></strong><span>Transaction #<%= tx.id %></span><span><%= tx.day %></span><span class="report-status"><%= statusLabel(tx.void_status) %></span></div></header>
<section class="report-facts"><div><span>FROM</span><strong><%= tx.direction==='IN'?tx.place:'Warehouse' %></strong></div><div><span>TO</span><strong><%= tx.direction==='IN'?'Warehouse':tx.place %></strong></div><div><span>TRANSACTION CATEGORY</span><strong><%= tx.transaction_category||'—' %></strong></div><div><span>ENTERED BY</span><strong><%= tx.entered_by %></strong></div></section>
<table class="report-items"><colgroup><col style="width:19%"><col style="width:39%"><col style="width:25%"><col style="width:17%"></colgroup><thead><tr><th>Item Code</th><th>Item Name</th><th>Product Category</th><th class="qty">Qty · g</th></tr></thead><tbody><tr><td><%= tx.code %></td><td><%= tx.name %></td><td><%= tx.category||'—' %></td><td class="qty"><%= Number(tx.qty_grams).toLocaleString('en-US',{minimumFractionDigits:3,maximumFractionDigits:3}) %></td></tr></tbody></table>
<section class="report-remark"><span>REMARK</span><p><%= tx.remark||'—' %></p></section>
<p class="posting-note"><%= tx.void_status==='VOIDED'?'VOIDED — excluded from stock balance.':tx.void_status==='VOID_PENDING'?'Pending void approval — currently included in stock balance.':'Posted — included in stock balance.' %></p>
<% if(approval){ %><section class="report-approvals"><article><span>PREPARED BY</span><strong><%= tx.entered_by %></strong><small><%= tx.day %></small></article><article><span><%= Number(approval.supervisor_by)===Number(tx.created_by)?'WAREHOUSE SUPERVISOR · SUBMITTED':'WAREHOUSE SUPERVISOR' %></span><strong><%= approval.supervisor_name||'—' %></strong><small><%= approval.supervisor_at||'—' %></small></article><article><span>WAREHOUSE ACCOUNTANT</span><strong><%= approval.accountant_name||'—' %></strong><small><%= approval.accountant_at||'—' %></small></article></section><% } %>
<% if(requests.length){ %><h2>Void Request History</h2><% requests.forEach(v=>{ %><section class="report-rejection"><strong>#<%= v.id %> · <%= v.status %></strong><p><%= v.reason %></p><small>Requested: <%= v.requester %> · <%= v.requested_at %></small><% if(v.decided_by){ %><p>Decision: <%= v.decider %> · <%= v.decided_at %></p><p><%= v.decision_reason||'—' %></p><% } %></section><% });} %>
<footer class="report-footer">Generated from Innocreation ERP · Stock unit: gram (g) · Recorded approvals shown where applicable.</footer></main></body></html>
