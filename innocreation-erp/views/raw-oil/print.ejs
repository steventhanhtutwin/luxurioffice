<% const voucherItems=typeof lines!=='undefined'?lines:[tx];const totalMilligrams=voucherItems.reduce((sum,item)=>{const [whole,fraction='']=String(item.qty_grams).split('.');return sum+BigInt(whole)*1000n+BigInt(fraction.padEnd(3,'0').slice(0,3));},0n);const totalWeight=(totalMilligrams/1000n).toString().replace(/\B(?=(\d{3})+(?!\d))/g,',')+'.'+(totalMilligrams%1000n).toString().padStart(3,'0');const signingApproval=approval||{}; %>
<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Raw Oil <%= tx.voucher %></title><% if(pdfMode){ %><style><%- css %></style><% }else{ %><link rel="stylesheet" href="/fg-print.css"><script src="/fg-print.js" defer></script><% } %><% if(typeof downloadMode!=='undefined'&&downloadMode){ %><%- include('../partials/pdf-download-assets') %><% } %><style>
.oil-item-remark{white-space:pre-wrap;overflow-wrap:anywhere}
.oil-voucher-totals{display:flex;justify-content:space-between;gap:16px;margin:12px 0 15px;padding:9px 7px;background:#f2f4ee;color:#355340;font-size:9px;font-weight:700;line-height:1.7;border-bottom:1px solid #c9d1c2;break-inside:avoid;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.oil-voucher-totals span:last-child{text-align:right;font-variant-numeric:tabular-nums}
.report-approvals .oil-sign-space{display:block;height:22mm;border-bottom:1px solid #aab4a5;margin-top:10px;break-inside:avoid}
.report-approvals .oil-sign-space em{font-size:9px;color:#777;letter-spacing:0;font-weight:400}
.report-approvals article>strong{margin-top:9px}
</style></head><body><% if(typeof downloadMode!=='undefined'&&downloadMode){ %><%- include('../partials/pdf-download-panel',{fileName:'Raw_Oil_Transaction_'+tx.id+'.pdf'}) %><% } %>
<% if(!pdfMode){ %><nav class="print-controls"><a href="/inventory/raw-oil/transactions/<%= tx.id %>">← Back to transaction</a><button id="print-document" type="button">Print / Save as PDF</button><a href="/inventory/raw-oil/transactions/<%= tx.id %>/pdf">↓ Download PDF</a></nav><% } %>
<main class="print-sheet"><header class="report-heading"><div><p class="brand">INNOCREATION</p><p class="report-label">RAW OIL / WAREHOUSE</p><h1><%= tx.direction==='IN'?'Stock In Voucher':'Stock Out Voucher' %></h1></div><div class="report-ref"><strong><%= tx.voucher %></strong><span>Transaction #<%= tx.id %></span><span><%= tx.day %></span><span class="report-status"><%= approval&&approval.status&&approval.status!=='APPROVED'?approval.status:statusLabel(tx.void_status) %></span></div></header>
<section class="report-facts"><div><span>FROM</span><strong><%= tx.direction==='IN'?tx.place:'Main Warehouse' %></strong></div><div><span>TO</span><strong><%= tx.direction==='IN'?'Main Warehouse':tx.place %></strong></div><div><span>TRANSACTION CATEGORY</span><strong><%= tx.transaction_category||'—' %></strong></div><div><span>ENTERED BY</span><strong><%= tx.entered_by %></strong></div></section>
<table class="report-items"><colgroup><col style="width:14%"><col style="width:27%"><col style="width:21%"><col style="width:15%"><col style="width:23%"></colgroup><thead><tr><th>Item Code</th><th>Item Name</th><th>Product Category</th><th class="qty">Qty · g</th><th>Remark</th></tr></thead><tbody><% for(const line of voucherItems){ %><tr><td><%= line.code %></td><td><%= line.name %></td><td><%= line.category||'—' %></td><td class="qty"><%= Number(line.qty_grams).toLocaleString('en-US',{minimumFractionDigits:3,maximumFractionDigits:3}) %></td><td class="oil-item-remark"><%= line.remark||'—' %></td></tr><% } %></tbody></table>
<section class="oil-voucher-totals" aria-label="Voucher totals"><span>Total Items: <%= new Set(voucherItems.map(item=>String(item.code))).size %></span><span>Total Weight: <%= totalWeight %> g</span></section>

<p class="posting-note"><%= approval&&approval.status&&approval.status!=='APPROVED'?'Adjustment pending / rejected — excluded from stock balance.':tx.void_status==='VOIDED'?'VOIDED — excluded from stock balance.':tx.void_status==='VOID_PENDING'?'Pending void approval — currently included in stock balance.':'Posted — included in stock balance.' %></p>
<section class="report-approvals"><article><span>PREPARED BY</span><div class="oil-sign-space"><em>Sign</em></div><strong><%= tx.entered_by %></strong><small><%= tx.day %></small></article><article><span><%= Number(signingApproval.supervisor_by)===Number(tx.created_by)?'WAREHOUSE SUPERVISOR · SUBMITTED':'WAREHOUSE SUPERVISOR' %></span><div class="oil-sign-space"><em>Sign</em></div><strong><%= signingApproval.supervisor_name||'—' %></strong><small><%= signingApproval.supervisor_at||'—' %></small></article><article><span>WAREHOUSE ACCOUNTANT</span><div class="oil-sign-space"><em>Sign</em></div><strong><%= signingApproval.accountant_name||'—' %></strong><small><%= signingApproval.accountant_at||'—' %></small></article></section>
<% if(requests.length){ %><h2>Void Request History</h2><% requests.forEach(v=>{ %><section class="report-rejection"><strong>#<%= v.id %> · <%= v.status %></strong><p><%= v.reason %></p><small>Requested: <%= v.requester %> · <%= v.requested_at %></small><% if(v.decided_by){ %><p>Decision: <%= v.decider %> · <%= v.decided_at %></p><p><%= v.decision_reason||'—' %></p><% } %></section><% });} %>
<footer class="report-footer">Generated from Innocreation ERP · Stock unit: gram (g) · Recorded approvals shown where applicable.</footer></main></body></html>
