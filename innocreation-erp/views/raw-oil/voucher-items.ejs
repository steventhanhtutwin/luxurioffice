<div class="oil-table-wrap"><table class="oil-table"><thead><tr><th>Item Code</th><th>Item Name</th><th>Categories</th><th>Qty · g</th><th>Remark</th></tr></thead><tbody><% for(const line of lines){ %><tr><td><%= line.code %></td><td><%= line.name %></td><td><%= line.category||'—' %></td><td><%= Number(line.qty_grams).toLocaleString('en-US',{minimumFractionDigits:3,maximumFractionDigits:3}) %></td><td><%= line.remark||'—' %></td></tr><% } %></tbody></table></div>
