<% const balanceCount=[r.category,r.from,r.to].filter(Boolean).length; %><div class="oil-balance-toolbar oil-compact-transaction"><form method="get" class="oil-transaction-search-form"><div class="oil-search-control"><span class="oil-search-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg></span><input name="q" value="<%= r.q %>" placeholder="Search Item Code / Name…" aria-label="Search items"><button type="submit" class="oil-quick-search">Search</button><details class="oil-custom-filter"><summary aria-label="Open Custom Filter" title="Custom Filter">▼<% if(balanceCount){ %><span class="oil-custom-count"><%= balanceCount %></span><% } %></summary><div class="oil-custom-panel"><div class="oil-custom-panel-title">Custom Filter</div><div class="oil-balance-fields oil-record-fields"><label>Category<select name="category"><option value="">All categories</option><% r.categories.forEach(c=>{ %><option value="<%= c.category %>" <%= r.category===c.category?'selected':'' %>><%= c.category %></option><% }); %></select></label><label>From date<input type="date" name="from" value="<%= r.from||'' %>"></label><label>To date<input type="date" name="to" value="<%= r.to||'' %>"></label></div><div class="oil-custom-panel-actions"><button type="submit">Apply Filter</button><a class="oil-balance-reset" href="/inventory/raw-oil/summary">Clear filters</a></div></div></details></div><div class="oil-compact-tools"><button class="oil-export" type="submit" formaction="/inventory/raw-oil/summary/export.xlsx">↓ Download Excel</button><a class="oil-balance-reset" href="/inventory/raw-oil/summary">Reset</a><% if(user.role==='admin'){ %><a class="oil-compact-new" href="/inventory/raw-oil/items/new">+ New Raw Oil</a><% } %></div></form><% if(balanceCount){ %><div class="oil-active-filters"><% if(r.category){ %><span>Category: <%= r.category %></span><% }if(r.from){ %><span>From: <%= r.from %></span><% }if(r.to){ %><span>To: <%= r.to %></span><% } %></div><% } %></div>
