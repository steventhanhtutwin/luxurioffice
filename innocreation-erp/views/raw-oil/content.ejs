<% const r=rawOil;const fmt=v=>v===null||v===undefined?'—':Number(v).toLocaleString('en-US',{minimumFractionDigits:3,maximumFractionDigits:3});const pagination=(p)=>{const u=new URLSearchParams();for(const key of ['q','category','direction','from','to','status','transaction_category'])if(r[key])u.set(key,r[key]);u.set('p',p);return '?'+u.toString();}; %>
<div class="oil-title"><div><p class="eyebrow">RAW OIL / WAREHOUSE</p><h1><%= r.type==='item'?(r.item.id?'Adjustment Raw Oil':'New Raw Oil'):page.name %></h1><p class="muted">ပမာဏအားလုံး gram (g) ဖြင့် စာရင်းသွင်းပါသည်။</p></div><span class="oil-unit">STANDARD UNIT · g</span></div>
<% if(r.error){ %><div class="error" role="alert"><%= r.error %></div><% } %>
<% if(r.saved){ %><div class="oil-success" role="status">သိမ်းဆည်းပြီးပါပြီ။ <% if(r.type==='history'){ %>Transaction #<%= r.saved %><% } %></div><% } %>
<% if(r.type==='list'){ %>
<% if(page.id==='summary'){ %><div class="oil-stats"><article><small>Opening Qty · g</small><strong><%= Number(r.totals.pending)>0?'အတည်ပြုရန်ကျန်':fmt(r.totals.opening) %></strong></article><article><small>Stock In · g</small><strong><%= fmt(r.totals.stock_in) %></strong></article><article><small>Stock Out · g</small><strong><%= fmt(r.totals.stock_out) %></strong></article><article><small>Closing Qty · g</small><strong><%= Number(r.totals.pending)>0?'အတည်ပြုရန်ကျန်':fmt(r.totals.closing) %></strong></article></div><p class="oil-note">Stock In = Warehouse အဝင်စုစုပေါင်း · Stock Out = Warehouse အထွက်စုစုပေါင်း<br>Closing Qty = Opening Qty + Stock In − Stock Out · Voided မှတ်တမ်းများကို မတွက်ပါ။ Pending Void Approval ကို ဆက်တွက်ထားပါသည်။</p><% } %>
<% if(Number(r.totals.pending)>0){ %><div class="oil-pending"><%= r.totals.pending %> items အတွက် Opening Qty နှင့် စာရင်းစတင်ရက် ဖြည့်ရန်ကျန်ပါသည်။ လက်ကျန်ကို အတည်မပြုရသေးပါ။</div><% } %>
<div class="oil-toolbar"><form method="get" class="oil-filters"><input name="q" value="<%= r.q %>" placeholder="Item Code / Item Name" aria-label="Search item"><select name="category" aria-label="Category"><option value="">All categories</option><% r.categories.forEach(c=>{ %><option value="<%= c.category %>" <%= r.category===c.category?'selected':'' %>><%= c.category %></option><% }); %></select><button>Search</button><% if(page.id==='summary'){ %><button class="oil-export" type="submit" formaction="/inventory/raw-oil/summary/export.xlsx" title="Filter နှင့်ကိုက်ညီသော စာရင်းအားလုံးကို Download လုပ်ရန်">↓ Download Excel</button><% } %><a href="/inventory/raw-oil/<%= page.id %>">Reset</a></form><% if(user.role==='admin'){ %><a class="oil-button" href="/inventory/raw-oil/items/new">+ New Raw Oil</a><% } %></div>
<div class="oil-table-wrap"><table class="oil-table"><thead><tr><th>Item Code</th><th>Item Name</th><th>Categories</th><th>Class</th><% if(page.id==='summary'){ %><th>Opening · g</th><th>Stock In · g</th><th>Stock Out · g</th><% } %><th>Closing · g</th><th>Start Date</th><% if(user.role==='admin'){ %><th>Action</th><% } %></tr></thead><tbody><% r.rows.forEach(item=>{ %><tr><td class="oil-code"><%= item.code %></td><td><%= item.name %></td><td><%= item.category %></td><td><%= item.item_class %></td><% if(page.id==='summary'){ %><td class="oil-number"><%= fmt(item.opening_grams) %></td><td class="oil-number"><%= fmt(item.stock_in) %></td><td class="oil-number"><%= fmt(item.stock_out) %></td><% } %><td class="oil-number"><%= item.closing_grams===null?'Opening ဖြည့်ရန်':fmt(item.closing_grams) %></td><td><%= item.opening_date||'—' %></td><% if(user.role==='admin'){ %><td><a href="/inventory/raw-oil/items/<%= item.id %>"><%= item.opening_grams===null?'Set opening':'Adjustment' %></a></td><% } %></tr><% }); %><% if(!r.rows.length){ %><tr><td colspan="10" class="oil-empty">ပစ္စည်းမတွေ့ပါ။</td></tr><% } %></tbody></table></div>
<div class="oil-pagination"><span><%= r.total %> items · Page <%= r.pageNo %> / <%= Math.max(1,Math.ceil(r.total/50)) %></span><div><% if(r.pageNo>1){ %><a href="<%= pagination(r.pageNo-1) %>">← Previous</a><% } %><% if(r.pageNo*50<r.total){ %><a href="<%= pagination(r.pageNo+1) %>">Next →</a><% } %></div></div>
<% }else if(r.type==='movement'){const v=r.values; %>
<form method="post" action="/inventory/raw-oil/<%= r.direction==='IN'?'in':'out' %>" class="oil-form" id="oil-movement"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= v.request_key %>"><div class="oil-form-heading"><h2><%= r.direction==='IN'?'Warehouse အဝင်':'Warehouse အထွက်' %></h2><a href="/inventory/raw-oil/transactions">Transaction History →</a></div><div class="oil-form-grid"><div><label for="oil-date">Date</label><input id="oil-date" type="date" name="date" value="<%= v.date %>" readonly></div><div><label for="oil-voucher">Vr No / Reference</label><input id="oil-voucher" name="voucher" maxlength="100" value="" readonly placeholder="<%= 'Save လုပ်ချိန်တွင် '+(r.direction==='IN'?'ROI-000001':'ROO-000001')+' ပုံစံ အလိုအလျောက် သတ်မှတ်မည်' %>"></div><div class="oil-wide"><label for="oil-transaction-category">Transaction Category *</label><select id="oil-transaction-category" name="transaction_category" required><option value="">Transaction Category ရွေးပါ</option><% r.transactionCategories.forEach(category=>{ %><option value="<%= category %>" <%= v.transaction_category===category?'selected':'' %>><%= category %></option><% }); %></select></div><div class="oil-wide"><label for="oil-code">Scan Item Code</label><input id="oil-code" name="code" value="<%= v.code||'' %>" maxlength="100" autocomplete="off" placeholder="Barcode scan ဖတ်ပါ / Item Code ရိုက်ပါ" required autofocus><p id="oil-lookup-status" class="oil-note" role="status" aria-live="polite">Scanner ကို USB Keyboard Mode ဖြင့် အသုံးပြုနိုင်ပါသည်။</p></div><div><label for="oil-name">Item Name</label><input id="oil-name" readonly placeholder="Code ဖတ်ပြီးလျှင် အလိုအလျောက်ပေါ်မည်"></div><div><label for="oil-category">Categories</label><input id="oil-category" readonly></div><div class="oil-wide oil-balance">Warehouse လက်ကျန်: <strong id="oil-balance">—</strong> <span>g</span><span id="oil-opening-note"></span></div><% if(r.direction==='OUT'){ %><div><label for="oil-fixed"><%= r.direction==='IN'?'To':'From' %></label><input id="oil-fixed" value="Warehouse" readonly></div><div><label for="oil-place"><%= r.direction==='IN'?'From — ဘယ်နေရာမှ ဝင်လာသလဲ':'To — ဘယ်နေရာသို့ ထုတ်ပေးသလဲ' %></label><select id="oil-place" name="place_id" required><option value="">နေရာရွေးပါ</option><% r.places.forEach(place=>{ %><option value="<%= place.id %>" <%= String(v.place_id)===String(place.id)?'selected':'' %>><%= place.name %></option><% }); %></select></div><% }else{ %><div><label for="oil-place"><%= r.direction==='IN'?'From — ဘယ်နေရာမှ ဝင်လာသလဲ':'To — ဘယ်နေရာသို့ ထုတ်ပေးသလဲ' %></label><select id="oil-place" name="place_id" required><option value="">နေရာရွေးပါ</option><% r.places.forEach(place=>{ %><option value="<%= place.id %>" <%= String(v.place_id)===String(place.id)?'selected':'' %>><%= place.name %></option><% }); %></select></div><div><label for="oil-fixed"><%= r.direction==='IN'?'To':'From' %></label><input id="oil-fixed" value="Warehouse" readonly></div><% } %><div><label for="oil-qty">Qty · gram (g)</label><input id="oil-qty" name="qty" type="number" min="0.001" max="999999999999.999" step="0.001" value="<%= v.qty||'' %>" placeholder="0.000" required></div><div><label for="oil-remark">Remark</label><input id="oil-remark" name="remark" maxlength="500" value="<%= v.remark||'' %>"></div></div><div class="oil-form-footer"><span>Save လုပ်ပြီးလျှင် Balance နှင့် Transaction မှတ်တမ်းတွင် ပေါ်မည်။</span><button id="oil-save" type="submit" disabled><%= r.direction==='IN'?'Save Stock In':'Save Stock Out' %></button></div></form>
<% if(user.role==='admin'){ %><details class="oil-place-form"><summary>+ From / To နေရာအသစ် ထည့်ရန်</summary><form method="post" action="/inventory/raw-oil/places"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="return_to" value="<%= r.direction==='IN'?'in':'out' %>"><label for="place-name">နေရာအမည်</label><input id="place-name" name="name" maxlength="120" placeholder="နေရာအမည်" required><button>Add location</button></form><p class="oil-note">နေရာအသစ်ထည့်မည်ဆိုပါက Transaction Form ကို မဖြည့်မီ ထည့်ပါ။</p></details><% } %><script src="/raw-oil.js" defer></script>
<% }else if(r.type==='void-detail'){ %><%- include('void-detail',{r,user,csrf}) %>
<% }else if(r.type==='history'){ %><p class="oil-note">Void တောင်းခံရုံဖြင့် Balance မပြောင်းပါ။ Accountant အတည်ပြုပြီးမှ Voided ဖြစ်၍ Balance မှ ဖယ်တွက်မည်။</p>
<div class="oil-toolbar"><form method="get" class="oil-filters oil-history-filter"><input name="q" value="<%= r.q %>" placeholder="Code / Name / Vr No" aria-label="Search transactions"><select name="direction" aria-label="Direction"><option value="">In + Out</option><option value="IN" <%= r.direction==='IN'?'selected':'' %>>Stock In</option><option value="OUT" <%= r.direction==='OUT'?'selected':'' %>>Stock Out</option></select><select name="transaction_category" aria-label="Transaction category"><option value="">All transaction categories</option><% r.transactionCategories.forEach(category=>{ %><option value="<%= category %>" <%= r.transaction_category===category?'selected':'' %>><%= category %></option><% }); %></select><select name="status" aria-label="Transaction status"><option value="">All statuses</option><% for(const [value,label] of [['POSTED','Posted'],['VOID_PENDING','Pending Void Approval'],['VOIDED','Voided']]){ %><option value="<%= value %>" <%= r.status===value?'selected':'' %>><%= label %></option><% } %></select><label>From date<input type="date" name="from" value="<%= r.from %>"></label><label>To date<input type="date" name="to" value="<%= r.to %>"></label><button>Filter</button><button class="oil-export" type="submit" formaction="/inventory/raw-oil/transactions/export.xlsx" title="Filter နှင့်ကိုက်ညီသော Transaction အားလုံးကို Download လုပ်ရန်">↓ Download Excel</button><a href="/inventory/raw-oil/transactions">Reset</a></form></div><div class="oil-table-wrap"><table class="oil-table"><thead><tr><th>ID</th><th>Date</th><th>Vr No</th><th>Item Code</th><th>Item Name</th><th>Categories</th><th>Type</th><th>Status</th><th>Request Void / Action</th><th>Transaction Category</th><th>From</th><th>To</th><th>Qty · g</th><th>Remark</th><th>Entered By</th></tr></thead><tbody><% r.rows.forEach(tx=>{ %><tr><td>#<%= tx.id %></td><td><%= tx.day %></td><td><%= tx.voucher %></td><td class="oil-code"><%= tx.code %></td><td><%= tx.name %></td><td><%= tx.category %></td><td><span class="oil-direction oil-<%= tx.direction.toLowerCase() %>"><%= tx.direction %></span></td><td><span class="oil-void-status"><%= r.statusLabel(tx.void_status) %></span></td><td><a href="/inventory/raw-oil/transactions/<%= tx.id %>"><%= user.role==='warehouse_supervisor'&&(!tx.void_status||tx.void_status==='POSTED')?'Request Void':user.role==='warehouse_accountant'&&tx.void_status==='VOID_PENDING'?'Review Void':'View' %></a></td><td><%= tx.transaction_category||'—' %></td><td><%= tx.direction==='IN'?tx.place:'Warehouse' %></td><td><%= tx.direction==='IN'?'Warehouse':tx.place %></td><td class="oil-number"><%= fmt(tx.qty_grams) %></td><td><%= tx.remark||'—' %></td><td><%= tx.entered_by %></td></tr><% }); %><% if(!r.rows.length){ %><tr><td colspan="15" class="oil-empty">Transaction မှတ်တမ်းမရှိသေးပါ။</td></tr><% } %></tbody></table></div><div class="oil-pagination"><span><%= r.total %> transactions · Page <%= r.pageNo %> / <%= Math.max(1,Math.ceil(r.total/50)) %></span><div><% if(r.pageNo>1){ %><a href="<%= pagination(r.pageNo-1) %>">← Previous</a><% } %><% if(r.pageNo*50<r.total){ %><a href="<%= pagination(r.pageNo+1) %>">Next →</a><% } %></div></div>
<% }else if(r.type==='adjustments'){ %><%- include('adjustments',{r,fmt}) %><% }else if(r.type==='item'){const item=r.item; %>
<form method="post" action="/inventory/raw-oil/items/<%= item.id||'new' %>" class="oil-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="oil-form-grid"><div><label for="item-code">Item Code / Barcode</label><input id="item-code" name="code" maxlength="100" value="<%= item.code||'' %>" <%= item.id?'readonly':'required' %>></div><div><label for="item-name">Item Name</label><input id="item-name" name="name" maxlength="200" value="<%= item.name||'' %>" required></div><div><label for="item-category">Categories</label><select id="item-category" name="category" required><option value="">Category ရွေးပါ</option><% r.categories.forEach(c=>{ %><option value="<%= c.category %>" <%= item.category===c.category?'selected':'' %>><%= c.category %></option><% }); %></select></div><div><label for="item-class">Class</label><input id="item-class" name="item_class" maxlength="100" value="<%= item.item_class||'Raw Oil' %>" readonly></div><div><label for="item-opening">Opening Qty · g</label><input id="item-opening" name="opening_grams" type="number" min="0" max="999999999999.999" step="0.001" value="<%= item.opening_grams??'' %>" <%= item.opening_locked?'readonly':'required' %>></div><div><label for="opening-date">စာရင်းစတင်ရက်</label><input id="opening-date" name="opening_date" type="date" value="<%= item.opening_date||'' %>" <%= item.opening_locked?'readonly':'required' %>></div><div class="oil-wide"><label for="adjustment-remark">Remark *</label><textarea id="adjustment-remark" name="remark" maxlength="500" rows="3" placeholder="ပြောင်းလဲရသည့် အကြောင်းရင်းကို မဖြစ်မနေ ဖြည့်ပါ" required><%= item.remark||'' %></textarea></div></div><p class="oil-note">စတင်ရက်၏ ပထမ Transaction မတိုင်မီရှိသော လက်ကျန်အမှန်ကို gram ဖြင့် ဖြည့်ပါ။ ထိုရက်မှစ၍ အဝင် / အထွက်ကို မှတ်တမ်းတင်ပါ။ Transaction ရှိပြီးပါက Opening Qty၊ စတင်ရက်နှင့် Item Code ကို ပြင်မရပါ။</p><div class="oil-form-footer"><a href="/inventory/raw-oil/summary">← Raw Oil Balance</a><button><%= item.id?'Save Adjustment':'Save Item' %></button></div></form>
<% } %>
