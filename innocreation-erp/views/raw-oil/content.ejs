<% const r=rawOil;const fmt=v=>v===null||v===undefined?'—':Number(v).toLocaleString('en-US',{minimumFractionDigits:3,maximumFractionDigits:3});const pagination=(p)=>{const u=new URLSearchParams();for(const key of ['q','category','direction','from','to','status','transaction_category'])if(r[key])u.set(key,r[key]);u.set('p',p);return '?'+u.toString();}; %>
<div class="oil-title"><div><h1><%= r.type==='item'?(r.item.id?'Set Opening Raw Oil':'New Raw Oil'):page.name %></h1><p class="muted">ပမာဏအားလုံး gram (g) ဖြင့် စာရင်းသွင်းပါသည်။</p></div><span class="oil-unit">STANDARD UNIT · g</span></div>
