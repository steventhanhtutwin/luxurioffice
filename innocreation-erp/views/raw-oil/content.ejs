</div><div class="oil-table-wrap"><table class="oil-table"><thead><tr><th>ID</th><th>Date</th><th>Vr No</th><th>Item Code</th><th>Item Name</th><th>Categories</th><th>Type</th><th>Status</th><th>Request Void / Action</th><th>Transaction Category</th><th>From</th><th>To</th><th>Qty · g</th><th>Remark</th><th>Entered By</th></tr></thead><tbody><% r.rows.forEach(tx=>{ %><tr class="oil-clickable-transaction" data-transaction-url="/inventory/raw-oil/transactions/<%= tx.id %>" tabindex="0" aria-label="View transaction <%= tx.voucher %>"><td>#<%= tx.id %></td><td><%= tx.day %></td><td><a class="oil-voucher-link" href="/inventory/raw-oil/transactions/<%= tx.id %>"><%= tx.voucher %></a></td><td class="oil-code"><%= tx.code %></td><td><%= tx.name %><% if(Number(tx.item_count)>1){ %><br><small>+ <%= Number(tx.item_count)-1 %> items · View voucher</small><% } %></td><td><%= tx.category %></td><td><span class="oil-direction oil-<%= tx.direction.toLowerCase() %>"><%= tx.direction %></span></td><td><span class="oil-void-status"><%= r.statusLabel(tx.void_status) %></span></td><td><a href="/inventory/raw-oil/transactions/<%= tx.id %>"><%= user.role==='warehouse_supervisor'&&(!tx.void_status||tx.void_status==='POSTED')?'Request Void':user.role==='warehouse_accountant'&&tx.void_status==='VOID_PENDING'?'Review Void':'View' %></a></td><td><%= tx.transaction_category||'—' %></td><td><%= tx.direction==='IN'?tx.place:'Main Warehouse' %></td><td><%= tx.direction==='IN'?'Main Warehouse':tx.place %></td><td class="oil-number"><%= Number(tx.item_count)>1?'View items':fmt(tx.qty_grams) %></td><td><%= tx.remark||'—' %></td><td><%= tx.entered_by %></td></tr><% }); %><% if(!r.rows.length){ %><tr><td colspan="15" class="oil-empty">Transaction မှတ်တမ်းမရှိသေးပါ။</td></tr><% } %></tbody></table></div><div class="oil-pagination"><span><%= r.total %> transactions · Page <%= r.pageNo %> / <%= Math.max(1,Math.ceil(r.total/50)) %></span><div><% if(r.pageNo>1){ %><a href="<%= pagination(r.pageNo-1) %>">← Previous</a><% } %><% if(r.pageNo*50<r.total){ %><a href="<%= pagination(r.pageNo+1) %>">Next →</a><% } %></div></div>
