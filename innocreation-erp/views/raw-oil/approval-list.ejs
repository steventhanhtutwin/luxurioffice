<div class="oil-note oil-notice"><div>Adjustment အတွက်—</div><div>ဝန်ထမ်းတင်ရင် → Warehouse Supervisor နှင့် Warehouse Accountant Approve ပေးမယ်။</div><div>Warehouse Supervisor ကိုယ်တိုင်တင်ရင် → Warehouse Accountant ကပဲ Approve ပေးမယ်။</div></div>
<% const f=r.filters||{}; const adjustmentPage=p=>'?'+new URLSearchParams({q:f.q||'',direction:f.direction||'',status:f.status||'',from:f.from||'',to:f.to||'',p}).toString(); %>
<% const approvalCount=[f.direction,f.status,f.from,f.to].filter(Boolean).length; %><div class="oil-balance-toolbar oil-compact-transaction"><form method="get" class="oil-transaction-search-form"><div class="oil-search-control"><span class="oil-search-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg></span><input name="q" value="<%= f.q||'' %>" placeholder="Search Code / Name / Vr No…" aria-label="Search adjustments"><button type="submit" class="oil-quick-search">Search</button><details class="oil-custom-filter"><summary aria-label="Open Custom Filter" title="Custom Filter">▼<% if(approvalCount){ %><span class="oil-custom-count"><%= approvalCount %></span><% } %></summary><div class="oil-custom-panel"><div class="oil-custom-panel-title">Custom Filter</div><div class="oil-balance-fields oil-record-fields"><label>Type<select name="direction" aria-label="Direction"><option value="">IN + OUT</option><% for(const d of ['IN','OUT']){ %><option value="<%= d %>" <%= f.direction===d?'selected':'' %>><%= d %></option><% } %></select></label>
<label>Approval Status<select name="status" aria-label="Approval status"><option value="">All approval statuses</option><% for(const [value,label] of Object.entries({PENDING_SUPERVISOR:'Pending Supervisor',PENDING_ACCOUNTANT:'Pending Accountant',APPROVED:'Approved',REJECTED:'Rejected'})){ %><option value="<%= value %>" <%= f.status===value?'selected':'' %>><%= label %></option><% } %></select></label>
<label>From date<input type="date" name="from" value="<%= f.from||'' %>"></label><label>To date<input type="date" name="to" value="<%= f.to||'' %>"></label>
</div><div class="oil-custom-panel-actions"><button type="submit">Apply Filter</button><a class="oil-balance-reset" href="/inventory/raw-oil/adjustments">Clear filters</a></div></div></details></div><div class="oil-compact-tools"><button class="oil-export" type="submit" formaction="/inventory/raw-oil/adjustments/export.xlsx">↓ Download Excel</button><a class="oil-balance-reset" href="/inventory/raw-oil/adjustments">Reset</a></div></form><% if(approvalCount){ %><div class="oil-active-filters"><% if(f.direction){ %><span>Type: <%= f.direction %></span><% }if(f.status){ %><span>Status: <%= ({PENDING_SUPERVISOR:'Pending Supervisor',PENDING_ACCOUNTANT:'Pending Accountant',APPROVED:'Approved',REJECTED:'Rejected'})[f.status] %></span><% }if(f.from){ %><span>From: <%= f.from %></span><% }if(f.to){ %><span>To: <%= f.to %></span><% } %></div><% } %></div>
<div class="oil-table-wrap"><table class="oil-table"><thead><tr><% for(const h of ['Date','Vr No','Item Code','Item Name','Type','Status','Action','Qty · g','From','To','Remark','Entered By','Supervisor','Accountant']){ %><th><%= h %></th><% } %></tr></thead><tbody>
<% r.rows.forEach(tx=>{const stage=tx.approval_status;const canApprove=(user.role==='warehouse_supervisor'&&stage==='PENDING_SUPERVISOR'||user.role==='warehouse_accountant'&&stage==='PENDING_ACCOUNTANT')&&Number(tx.created_by)!==Number(user.id)&&!(user.role==='warehouse_accountant'&&Number(tx.supervisor_by)===Number(user.id)); %>
<tr><td><%= tx.day %></td><td><a href="/inventory/raw-oil/transactions/<%= tx.id %>"><%= tx.voucher %></a></td><td><%= tx.code %></td><td><%= tx.name %><% if(Number(tx.item_count)>1){ %><br><small>+ <%= Number(tx.item_count)-1 %> items · View voucher</small><% } %></td><td><%= tx.direction %></td><td><%= ({PENDING_SUPERVISOR:'Pending Supervisor',PENDING_ACCOUNTANT:'Pending Accountant',APPROVED:'Approved',REJECTED:'Rejected'})[stage] %></td><td><% if(canApprove){ %><form method="post" action="/inventory/raw-oil/adjustments/<%= tx.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Approve</button></form><form method="post" action="/inventory/raw-oil/adjustments/<%= tx.id %>/reject"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Reject</button></form><% }else{ %><a href="/inventory/raw-oil/transactions/<%= tx.id %>">View Transaction</a><% } %></td><td><%= Number(tx.item_count)>1?'View items':fmt(tx.qty_grams) %></td><td><%= tx.direction==='IN'?tx.place:'Main Warehouse' %></td><td><%= tx.direction==='IN'?'Main Warehouse':tx.place %></td><td><%= tx.remark %></td><td><%= tx.entered_by %></td><td><%= tx.supervisor_name||'—' %><% if(Number(tx.supervisor_by)===Number(tx.created_by)){ %><br><small>Submitted by Supervisor</small><% } %><br><%= tx.supervisor_at||'' %></td><td><%= tx.accountant_name||'—' %><br><%= tx.accountant_at||'' %></td></tr>
<% });if(!r.rows.length){ %><tr><td colspan="14">Adjustment မှတ်တမ်း မရှိသေးပါ။</td></tr><% } %></tbody></table></div>
<div class="oil-pagination"><span><%= r.total %> adjustments · Page <%= r.pageNo %></span><div><% if(r.pageNo>1){ %><a href="<%= adjustmentPage(r.pageNo-1) %>">Previous</a><% }if(r.pageNo*50<r.total){ %><a href="<%= adjustmentPage(r.pageNo+1) %>">Next</a><% } %></div></div>
