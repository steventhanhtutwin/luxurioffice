<div class="oil-toolbar"><form method="get" class="oil-filters oil-history-filter oil-adjustment-filters"><input name="q" value="<%= r.q %>" placeholder="Item Code / Name / Remark" aria-label="Search adjustments"><select name="category" aria-label="Category before or after"><option value="">All categories</option><% r.categories.forEach(c=>{ %><option value="<%= c.category %>" <%= r.category===c.category?'selected':'' %>><%= c.category %></option><% }); %></select><select name="actor" aria-label="Adjusted by"><option value="">All users</option><% r.actors.forEach(a=>{ %><option value="<%= a.id %>" <%= r.actor===String(a.id)?'selected':'' %>><%= a.display_name %> (<%= a.username %>)</option><% }); %></select><label>From date<input name="from" type="date" value="<%= r.from %>"></label><label>To date<input name="to" type="date" value="<%= r.to %>"></label><button>Filter</button><button class="oil-export" type="submit" formaction="/inventory/raw-oil/adjustments/export.xlsx">↓ Download Excel</button><a href="/inventory/raw-oil/adjustments">Reset</a></form></div>
<p class="oil-note"><span class="oil-readonly">READ ONLY</span> ပြောင်းလဲမှုမှတ်တမ်းများကို ကြည့်ရှုရန်သာ ဖြစ်ပါသည်။ ပြင်ဆင်ခြင်း၊ ဖျက်ခြင်း မပြုနိုင်ပါ။</p>
<div class="oil-table-wrap"><table class="oil-table"><thead><tr><th>ID</th><th>Adjusted At</th><th>Item Code</th><th>Item Name Before</th><th>Item Name After</th><th>Category Before</th><th>Category After</th><th>Class</th><th>Opening Before · g</th><th>Opening After · g</th><th>Change · g</th><th>Start Date Before</th><th>Start Date After</th><th>Remark</th><th>Adjusted By</th></tr></thead><tbody><% r.rows.forEach(row=>{ %><tr><td>#<%= row.id %></td><td><%= row.adjusted_at %></td><td class="oil-code"><%= row.code %></td><td><%= row.before.name||'—' %></td><td><%= row.after.name||'—' %></td><td><%= row.before.category||'—' %></td><td><%= row.after.category||'—' %></td><td><%= row.after.item_class||row.before.item_class||'—' %></td><td class="oil-number"><%= fmt(row.before.opening_grams) %></td><td class="oil-number"><%= fmt(row.after.opening_grams) %></td><td class="oil-number"><%= fmt(row.delta) %></td><td><%= row.before.opening_date||'—' %></td><td><%= row.after.opening_date||'—' %></td><td class="oil-wrap"><%= row.remark %></td><td><%= row.adjusted_by %></td></tr><% }); %><% if(!r.rows.length){ %><tr><td colspan="15" class="oil-empty">Adjustment မှတ်တမ်းမရှိသေးပါ။</td></tr><% } %></tbody></table></div>
<div class="oil-pagination"><span><%= r.total %> adjustments · Page <%= r.pageNo %> / <%= Math.max(1,Math.ceil(r.total/50)) %></span><div><% const link=p=>{const q=new URLSearchParams();for(const k of ['q','category','actor','from','to'])if(r[k])q.set(k,r[k]);q.set('p',p);return '?'+q.toString();};if(r.pageNo>1){ %><a href="<%= link(r.pageNo-1) %>">← Previous</a><% } %><% if(r.pageNo*50<r.total){ %><a href="<%= link(r.pageNo+1) %>">Next →</a><% } %></div></div>
