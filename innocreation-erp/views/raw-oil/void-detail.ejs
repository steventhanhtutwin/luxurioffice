<% const tx=r.tx,latest=r.requests[0],lines=r.lines||[tx],pendingAdjustment=r.approvalStatus&&r.approvalStatus!=='APPROVED'; %>
<section class="oil-form"><nav class="oil-document-tools" aria-label="Transaction documents"><a class="oil-button" href="/inventory/raw-oil/transactions/<%= tx.id %>/print?autoprint=1" target="_blank" rel="noopener">Print</a><a class="oil-button" href="/inventory/raw-oil/transactions/<%= tx.id %>/pdf">↓ Download PDF</a></nav><div class="oil-form-heading"><h2><%= tx.voucher %> · #<%= tx.id %></h2><span class="oil-void-status"><%= pendingAdjustment?r.approvalStatus:r.statusLabel(tx.void_status) %></span></div>
<% if(r.notice){ %><div class="oil-success" role="status">လုပ်ဆောင်ချက် သိမ်းဆည်းပြီးပါပြီ။</div><% } %>
<div class="oil-form-grid oil-void-info"><div><strong>Date</strong><p><%= tx.day %></p></div><div><strong>Entered By</strong><p><%= tx.entered_by %></p></div><div class="oil-wide"><strong>Transaction Category</strong><p><%= tx.transaction_category||'—' %></p></div><div><strong>From</strong><p><%= tx.direction==='IN'?tx.place:'Main Warehouse' %></p></div><div><strong>To</strong><p><%= tx.direction==='IN'?'Main Warehouse':tx.place %></p></div></div>
<%- include('voucher-items',{lines}) %>
<% if(pendingAdjustment){ %><p class="oil-note oil-notice">Adjustment <%= r.approvalStatus %> · Balance တွင် ထည့်မတွက်သေးပါ။</p><% }else{ %><p class="oil-note"><%= tx.void_status==='VOIDED'?'Void အတည်ပြုပြီးပါပြီ။ ဤ Transaction ကို Balance တွင် ထည့်မတွက်တော့ပါ။':tx.void_status==='VOID_PENDING'?'Accountant အတည်ပြုရန် စောင့်နေပါသည်။ Balance မပြောင်းသေးပါ။':'Posted Transaction ဖြစ်ပါသည်။ Void အတည်ပြုပြီးမှ Balance ပြောင်းမည်။' %></p>
<% } %><% if(!pendingAdjustment&&user.role==='warehouse_supervisor'&&(!latest||latest.status==='REJECTED')){ %><form method="post" action="/inventory/raw-oil/transactions/<%= tx.id %>/void/request"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="void-reason">Void အကြောင်းရင်း *</label><textarea id="void-reason" name="reason" maxlength="500" rows="3" required></textarea><button type="submit">Request Void →</button></form><% } %>
<% if(latest?.status==='PENDING'){ %><article class="oil-void-audit"><strong>Pending Void Request</strong><p><%= latest.reason %></p><p>Requested: <%= latest.requester %> · <%= latest.requested_at %></p></article><% } %>
<% if(user.role==='warehouse_accountant'&&latest?.status==='PENDING'&&Number(latest.requested_by)!==Number(user.id)){ %><div class="oil-void-actions"><form method="post" action="/inventory/raw-oil/transactions/<%= tx.id %>/void/approve"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_id" value="<%= latest.id %>"><p class="oil-note">Approve လုပ်လျှင် ဤ Voucher ရှိ Item အားလုံး၏ Stock သက်ရောက်မှုကို ဖယ်မည်။</p><button type="submit">Approve Void</button></form><form method="post" action="/inventory/raw-oil/transactions/<%= tx.id %>/void/reject"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_id" value="<%= latest.id %>"><label for="reject-reason">Reject အကြောင်းရင်း *</label><textarea id="reject-reason" name="reason" maxlength="500" rows="2" required></textarea><button type="submit">Reject Void</button></form></div><% } %>
<h2>Void Request History</h2><% if(!r.requests.length){ %><p class="oil-note">Void Request မရှိသေးပါ။</p><% } %><% r.requests.forEach(v=>{ %><article class="oil-void-audit"><strong>#<%= v.id %> · <%= v.status %></strong><p><%= v.reason %></p><p>Requested: <%= v.requester %> · <%= v.requested_at %></p><% if(v.decided_by){ %><p>Decision: <%= v.decider %> · <%= v.decided_at %></p><p><%= v.decision_reason||'' %></p><% } %></article><% }); %><a href="/inventory/raw-oil/<%= pendingAdjustment?'adjustments':'transactions' %>">← <%= pendingAdjustment?'Raw Oil Adjustment':'Raw Oil Transaction' %></a></section>
