<% const fmt=v=>{const [a,b='']=String(v??0).split('.'),tail=b.replace(/0+$/,'');return a.replace(/\B(?=(\d{3})+(?!\d))/g,',')+(tail?'.'+tail:'');}; %>
<section class="rm-screen"><div class="rm-heading"><div><h1><%= rm.type==='ledger'?'Raw Material Ledger':'Raw Materials — Main Warehouse Stock Balance' %></h1><p>Opening + Stock In − Stock Out = Closing · Main Warehouse</p></div></div>
<% if(rm.type==='list'){ %><% if(rm.saved||rm.created){ %><p class="rm-success" role="status"><%= rm.saved?'Reorder Qty ပြင်ဆင်ပြီးပါပြီ။':'Raw Material သိမ်းဆည်းပြီးပါပြီ။' %></p><% } %><form class="rm-toolbar" method="get"><input name="q" value="<%= rm.q %>" placeholder="Search Item Code / Item Name…" aria-label="Search materials"><select name="category" aria-label="Category"><option value="">All Categories</option><% for(const c of rm.categories){ %><option <%= rm.category===c.category?'selected':'' %>><%= c.category %></option><% } %></select><button>Search</button><a href="/inventory/raw-materials/list">Reset</a><small><%= rm.materials.length %> items</small></form><div class="rm-table"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Category</th><th>Unit</th><th>Opening 🔒</th><th>Closing</th><th>Reorder Qty</th><th>Status</th><th>Action</th></tr></thead><tbody><% for(const m of rm.materials){ %><tr><td><%= m.code %></td><td><strong><%= m.name %></strong></td><td><span class="rm-badge"><%= m.category %></span></td><td><%= m.unit %></td><td><%= fmt(m.opening_qty) %> <span class="rm-lock" title="Opening locked">🔒</span></td><td><strong><%= fmt(m.stock_qty) %></strong></td><td><form class="rm-reorder" method="post" action="/inventory/raw-materials/<%= m.id %>/reorder"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="previous_reorder" value="<%= m.reorder_qty %>"><input type="number" name="reorder" min="0" max="999999999.999" step="<%= m.unit==='pcs'?'1':'0.001' %>" value="<%= m.reorder_qty %>" aria-label="Reorder Qty for <%= m.code %>" required><button>Update</button></form></td><td><span class="rm-stock-status <%= m.low_stock?'low':'in' %>"><i aria-hidden="true"></i><%= m.low_stock?'Low Stock':'In Stock' %></span></td><td><a class="rm-button" href="/inventory/raw-materials/<%= m.id %>/ledger">View Ledger →</a></td></tr><% } %><% if(!rm.materials.length){ %><tr><td colspan="9">စာရင်းမရှိသေးပါ။</td></tr><% } %></tbody></table></div>
<dialog id="rm-add-dialog" class="rm-add-dialog"><div class="rm-dialog-heading"><h2>Add Raw Material</h2><button type="button" data-rm-close aria-label="Close Add Raw Material">×</button></div><form method="post" action="/inventory/raw-materials/create"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="rm-grid"><label>Item Code<input name="code" maxlength="100" required></label><label>Item Name<input name="name" maxlength="255" required></label><label>Category<input name="category" maxlength="100" required></label><label>Unit<select name="unit"><option>pcs</option><option>g</option></select></label><label>One-Time Opening Qty<input type="number" name="opening" min="0" max="999999999.999" step="0.001" value="0" required></label><label>Reorder Qty<input type="number" name="reorder" min="0" max="999999999.999" step="0.001" value="0" required></label></div><div class="rm-dialog-actions"><button type="button" data-rm-close>Cancel</button><button>Save Material &amp; Opening</button></div></form></dialog>
<% }else{ %><a href="/inventory/raw-materials/list">← Raw Material List</a><section class="rm-card"><h2><%= rm.material.code %> · <%= rm.material.name %></h2><p>Closing: <strong><%= fmt(rm.material.stock_qty) %> <%= rm.material.unit %></strong> · Reorder: <%= fmt(rm.material.reorder_qty) %> <%= rm.material.unit %></p><h3>Stock Movement History</h3><% for(const l of rm.rows){ %><article class="rm-history"><header><strong><%= l.type %> · <%= l.reference %></strong><small><%= l.created_at %> · <%= l.actor_name %></small></header><p><%= l.note %></p><p>Movement: +<%= fmt(l.qty) %> <%= rm.material.unit %> · Running Balance: <strong><%= fmt(l.balance_after) %> <%= rm.material.unit %></strong></p></article><% } %><h3>Reorder Update History</h3><% for(const h of rm.history){ %><article class="rm-history"><header><strong><%= fmt(h.old_qty) %> → <%= fmt(h.new_qty) %> <%= rm.material.unit %></strong><small><%= h.created_at %> · <%= h.actor_name %></small></header></article><% } %><% if(!rm.history.length){ %><p>Reorder ပြင်ဆင်မှု မရှိသေးပါ။</p><% } %></section><% } %></section>
