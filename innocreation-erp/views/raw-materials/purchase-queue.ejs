<% const pq=purchaseQueue, pg=pq.progress;const progressUrl=(extra={})=>'/inventory/purchase-requests/history?'+new URLSearchParams({status:pg.status,q:pg.q,...extra}).toString(); %>
<div class="ipq-title-row"><div class="ipq-title"><h1><%= pq.view==='queue'?'Low Stock Auto-Reorder Queue':'Purchasing Progress & History' %></h1><p><%= pq.view==='queue'?'Raw Material Low Stock စာရင်း':'Purchase Request လုပ်ငန်းစဉ်နှင့် မှတ်တမ်း' %> · Main Warehouse</p></div><div class="ipq-warehouse"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m3 9 9-6 9 6v12H3zM7 21V11h10v10M7 15h10M7 18h10"/></svg>Main Warehouse</div></div>
<% if(purchaseQueue.sent){ %><p class="ipq-success" role="status">Purchaser ရဲ့ Purchase Requisition စာရင်းတွင် <strong><%= purchaseQueue.sent.request_no %></strong> ရှိပါပြီ။</p><% } %><% if(purchaseQueue.error){ %><p class="ipq-error" role="alert"><%= purchaseQueue.error %></p><% } %>

<% if(pq.view==='queue'){ %>
<section class="ipq-card"><header class="ipq-heading"><span class="ipq-bell"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M9 21h6M3 3 1 6m20-3 2 3"/></svg></span><div><h2>Low Stock Auto-Reorder Queue</h2><p>Closing Stock ≤ Min Qty ဖြစ်သော Raw Material များကို အလိုအလျောက် ပြထားပါသည်။</p></div><b><%= pq.queueTotal %> items</b></header>
<div class="ipq-table"><table><thead><tr><th>Material &amp; Item Code</th><th>Current Stock</th><th>Min Qty</th><th>Max Quantity</th><th>Status</th><th>Order Qty</th><th>Action</th></tr></thead><tbody><% for(const m of purchaseQueue.materials){ %><tr><td><strong><%= m.name %></strong><small><%= m.code %></small><small><%= m.category %></small></td><td><b class="ipq-stock"><%= Number(m.stock_qty).toLocaleString('en-US',{maximumFractionDigits:3}) %></b> <%= m.unit %></td><td><%= Number(m.min_qty).toLocaleString('en-US',{maximumFractionDigits:3}) %> <%= m.unit %></td><td><%= m.max_qty==null?'—':Number(m.max_qty).toLocaleString('en-US',{maximumFractionDigits:3})+' '+m.unit %></td><td><span class="ipq-status">Low Stock</span></td><td><form id="ipq-request-<%= m.id %>" method="post" action="/inventory/purchase-requests/request" class="ipq-order"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="material_id" value="<%= m.id %>"><input type="hidden" name="request_key" value="<%= m.request_key %>"><input name="qty" type="number" min="<%= m.unit==='pcs'?'1':'0.001' %>" step="<%= m.unit==='pcs'?'1':'0.001' %>" max="999999999.999" placeholder="Qty" aria-label="Order Qty for <%= m.code %>" value="<%= m.pending?m.pending.qty:String(purchaseQueue.values.material_id||'')===String(m.id)?purchaseQueue.values.qty||'':'' %>" <%= m.pending?'readonly':'required' %>><span><%= m.unit %></span></form></td><td><% if(m.pending){ %><span class="ipq-sent"><%= m.pending.progress?m.pending.progress.label:'✓ PR Sent' %></span><a class="ipq-pr-link" href="/inventory/purchase-requests/request/<%= m.pending.id %>/pdf" download><%= m.pending.request_no %></a><% }else{ %><button type="submit" form="ipq-request-<%= m.id %>" class="ipq-request"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m3 11 18-8-8 18-3-8zM10 13 21 3"/></svg>Request to Purchaser</button><% } %></td></tr><% } %><% if(!purchaseQueue.materials.length){ %><tr><td colspan="7" class="ipq-empty">Low Stock ဖြစ်သော Raw Material မရှိသေးပါ။</td></tr><% } %></tbody></table></div>
<footer class="ipq-foot">Quantity ဖြည့်ပြီး Request to Purchaser နှိပ်လျှင် Purchase Requisition စာရင်းသို့ ပို့ပေးမည်။<nav class="ipq-pagination" aria-label="Low stock pages"><% if(pq.queuePage>1){ %><a href="?queuePage=<%= pq.queuePage-1 %>">← Previous</a><% } %><span>Page <%= pq.queuePage %> / <%= pq.queuePages %></span><% if(pq.queuePage<pq.queuePages){ %><a href="?queuePage=<%= pq.queuePage+1 %>">Next →</a><% } %></nav></footer></section>

<% }else{ %>
<section class="ipq-card ipq-progress-card" aria-labelledby="ipq-progress-title">
<header class="ipq-heading"><span class="ipq-progress-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 18V6m0 12h14M9 14l4-4 3 2 4-6M16 6h4v4"/></svg></span><div><h2 id="ipq-progress-title">Purchasing Progress &amp; History</h2><p>Purchasing လုပ်ငန်းစဉ်ကို ဒီနေရာမှ ကြည့်နိုင်ပါသည်။ Stock ပြန်တက်သွားလည်း တင်ထားသော Request များကို ဆက်ကြည့်နိုင်ပါသည်။</p></div></header>
<div class="ipq-progress-tools"><nav class="ipq-status-tabs" aria-label="Purchasing status"><% for(const [key,label] of [['all','All'],['pending','PR Pending'],['ready','PO Ready'],['ordered','On Order'],['completed','Completed']]){ %><a href="<%= progressUrl({status:key}) %>" class="<%= pg.status===key?'active':'' %>" <%- pg.status===key?'aria-current="page"':'' %>><%= label %> <b><%= pg.counts[key] %></b></a><% } %></nav><form method="get" action="/inventory/purchase-requests/history" class="ipq-search"><input type="hidden" name="status" value="<%= pg.status %>"><input type="search" name="q" value="<%= pg.q %>" maxlength="100" placeholder="Search item code, name, PR or PO…" aria-label="Search purchasing progress"><button type="submit">Search</button><% if(pg.q){ %><a href="<%= progressUrl({q:''}) %>">Reset</a><% } %><a class="ipq-excel" href="/inventory/purchase-requests/export.xlsx?<%= new URLSearchParams({status:pg.status,q:pg.q}).toString() %>">↓ Download Excel</a></form></div>
<div class="ipq-table"><table><thead><tr><th>Request / Material</th><th>Purchasing Status</th><th>Requested</th><th>PO Qty</th><th>Accepted Received</th><th>Remaining</th><th>Progress</th></tr></thead><tbody>
<% for(const r of purchaseQueue.progress.rows){ %>
<tr id="ipq-progress-<%= r.id %>"><td><strong><%= r.item_name %></strong><small><%= r.item_code %> · <a href="/inventory/purchase-requests/request/<%= r.id %>/pdf" download><%= r.request_no %></a></small><small><%= r.po_no||'PO မထုတ်ရသေးပါ' %></small></td><td><span class="ipq-progress-status <%= r.tone %>"><%= r.label %></span><small><%= r.hint %></small><% if(r.events.length){ %><small>Updated: <%= r.events[r.events.length-1].at %></small><% } %></td><td><%= r.qty %> <%= r.unit %></td><td><%= r.order_qty===null?'—':r.order_qty+' '+r.unit %></td><td><%= r.order_qty===null?'—':r.accepted_qty+' '+r.unit %></td><td><%= r.remaining===null?'—':r.remaining+' '+r.unit %></td><td><details class="ipq-timeline"><summary>View Progress</summary><ol><% for(const e of r.events){ %><li><strong><%= e.label %></strong><small><%= e.at %> · Asia/Bangkok</small></li><% } %></ol><% if(!r.events.length){ %><p>Progress history မရှိသေးပါ။</p><% } %></details></td></tr>
<% } %><% if(!purchaseQueue.progress.rows.length){ %><tr><td colspan="7" class="ipq-empty">သက်ဆိုင်ရာ Purchase Request မရှိပါ။</td></tr><% } %>
</tbody></table></div><footer class="ipq-foot ipq-pagination"><span>Requested Qty သည် မူလတင်ထားသော Qty ဖြစ်ပါသည်။ Received သည် Stock ထဲ လက်ခံပြီးသော Qty ဖြစ်ပါသည်။</span><nav aria-label="Request history pages"><% if(purchaseQueue.progress.page>1){ %><a href="<%= progressUrl({history:pg.page-1}) %>">← Previous</a><% } %><span>Page <%= pg.page %> / <%= pg.totalPages %></span><% if(purchaseQueue.progress.more){ %><a href="<%= progressUrl({history:pg.page+1}) %>">Next →</a><% } %></nav></footer></section>

<% } %>
