<form class="hx-toolbar" method="get" action="<%= action %>"><% if(typeof tab!=='undefined'){ %><input type="hidden" name="tab" value="<%= tab %>"><% } %><div class="hx-search"><input name="q" value="<%= f.q %>" placeholder="Search Dispatch / Request / Item / Staff…" aria-label="Search history"><button>Search</button><details><summary aria-label="More search filters">▾</summary><div class="hx-options"><% for(const [key,title] of [['dispatchNo','Dispatch No.'],['request','Request No.'],['item','Item Code / Name'],['prepared','Prepared By'],['dispatched','Dispatched By'],['received','Received By']]){ %><label><%= title %><input name="<%= key %>" value="<%= f[key] %>"></label><% } %><% if(showStatus){ %><label>Status<select name="status"><option value="">All Statuses</option><% for(const v of ['PENDING','IN_TRANSIT','RECEIVED','REJECTED']){ %><option value="<%= v %>" <%= f.status===v?'selected':'' %>><%= label(v) %></option><% } %></select></label><% } %><label>Date Type<select name="dateField"><% for(const v of ['prepared','dispatched','received']){ %><option value="<%= v %>" <%= f.dateField===v?'selected':'' %>><%= v[0].toUpperCase()+v.slice(1) %></option><% } %></select></label><label>From Date<input type="date" name="from" value="<%= f.from %>"></label><label>To Date<input type="date" name="to" value="<%= f.to %>"></label><button>Apply Filters</button></div></details></div><a class="sr-button secondary" href="<%= action %>/export.xlsx?<%= new URLSearchParams({...f,...(typeof tab!=='undefined'?{tab}: {})}).toString() %>">↓ Download Excel</a><a href="<%= action %><%= typeof tab!=='undefined'?'?tab='+tab:'' %>">Reset</a></form>