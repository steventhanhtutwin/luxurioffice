<!doctype html>
<html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= page ? page.name : group ? group.name : 'Inventory Dashboard' %> | Innocreation ERP</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/workspace.css"><link rel="stylesheet" href="/inventory-navigation.css?v=2"><% if(typeof fg!=='undefined'){ %><% if(fg.type==='stock'){ %><script src="/fg-stock.js?v=1" defer></script><% } %><link rel="stylesheet" href="/fg.css?v=stock-style-3"><% if(fg.type==='stock'){ %><link rel="stylesheet" href="/fg-stock.css?v=1"><% } %><% } %><% if(typeof rawOil!=='undefined'){ %><link rel="stylesheet" href="/raw-oil.css?v=excel-import-5"><% if(page&&['list','history','approval-list'].includes(rawOil.type)&&['summary','transactions','adjustments'].includes(page.id)){ %><link rel="stylesheet" href="/raw-oil-balance-sticky.css?v=5"><script src="/raw-oil-balance-header.js?v=1" defer></script><script src="/raw-oil-custom-filter.js?v=1" defer></script><% } %><% } %><% if(typeof sr!=='undefined'){ %><link rel="stylesheet" href="/stock-requisitions.css?v=6"><link rel="stylesheet" href="/innocreation-loading.css?v=2"><script src="/innocreation-loading.js?v=2" defer></script><script src="/stock-requisitions.js?v=4" defer></script><% } %></head>
<body class="app-home"><header class="app-header"><a class="app-logo" href="/dashboard">INNOCREATION <span>/ ERP</span></a><div class="account-area"><% if(typeof user!=='undefined'&&Array.isArray(user.app_access)&&user.app_access.includes('inventory')){ %><%- include('partials/approval-notifications',{user,csrf}) %><% } %><a class="back-link" href="/dashboard">← Main Dashboard</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="logout">Logout</button></form></div></header>
<div class="inventory-shell"><aside class="inventory-sidebar"><p class="eyebrow">INVENTORY</p><nav aria-label="Inventory navigation"><% groups.forEach(g=>{ %><details name="inventory-main-menu" class="nav-group" <% if(group && group.id===g.id){ %>open<% } %>><summary><span class="inventory-menu-label"><span class="inventory-menu-icon"><%- include('partials/inventory-menu-icon',{icon:g.icon}) %></span><span><%= g.name %></span></span><svg class="nav-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 7 5 5 5-5"/></svg></summary><div class="nav-submenus"><% g.menus.filter(menu=>(!menu.adminOnly||user.role==='admin')&&(!menu.roles||menu.roles.includes(user.role))&&!(g.id==='raw-oil'&&user.role==='warehouse_accountant'&&['in','out'].includes(menu.id))).forEach(menu=>{ const current=group && group.id===g.id && page && page.id===menu.id; %><a class="<%= current ? 'active' : '' %>" href="/inventory/<%= g.id %>/<%= menu.id %>" <% if(current){ %>aria-current="page"<% } %>><%= menu.name %></a><% }); %></div></details><% }); %><details name="inventory-main-menu" class="nav-group" <% if(typeof sr!=='undefined'){ %>open<% } %>><summary><span class="inventory-menu-label"><span aria-hidden="true">⇄</span><span>Stock Requisitions</span></span><svg class="nav-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor"><path d="m5 7 5 5 5-5"/></svg></summary><div class="nav-submenus"><a class="<%= typeof sr!=='undefined'&&!sr.historyPage&&!sr.archived?'active':'' %>" href="/inventory/stock-requisitions">Stock Requisitions</a><a class="<%= typeof sr!=='undefined'&&(sr.historyPage||sr.archived)?'active':'' %>" href="/inventory/stock-requisitions/history">Stock Requisitions History</a></div></details></nav><div class="sidebar-foot">INNOCREATION<br><span>Inventory workspace</span></div></aside>
<main class="inventory-main"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/modules/inventory">Inventory</a><% if(group){ %><span>/</span><a href="/inventory/<%= group.id %>"><%= group.name %></a><% } %><% if(page){ %><span>/</span><span aria-current="page"><%= page.name %></span><% } %></nav>
<% if(typeof sr!=='undefined'){ %><%- include(sr.historyPage?'stock-requisitions/history':'stock-requisitions/content') %><% }else if(typeof fg!=='undefined'){ %><%- include('fg/content',{fg,user,page,csrf,statusLabel}) %><% }else if(typeof rawOil!=='undefined'){ %><%- include('raw-oil/content',{rawOil,user,page,csrf}) %><% }else if(!group){ %><div class="inventory-intro"><h1>Inventory Dashboard</h1><p class="muted">စီမံခန့်ခွဲလိုသည့် ပစ္စည်းအုပ်စုကို ရွေးချယ်ပါ။</p></div><div class="inventory-section-title"><h2>Inventory categories</h2><span>03 WORKSPACES</span></div><section class="category-grid" aria-label="Inventory categories"><% groups.forEach((g,index)=>{ %><a class="category-card" href="/inventory/<%= g.id %>"><div class="category-top"><span class="category-icon icon-<%= g.icon %>"><%- include('partials/inventory-icon',{icon:g.icon}) %></span><span class="category-number">0<%= index+1 %></span></div><h2><%= g.name %></h2><p class="category-subtitle"><%= g.subtitle %></p><p class="category-description"><%= g.description %></p><div class="category-menu-tags"><% g.menus.filter(menu=>(!menu.adminOnly||user.role==='admin')&&(!menu.roles||menu.roles.includes(user.role))&&!(g.id==='raw-oil'&&user.role==='warehouse_accountant'&&['in','out'].includes(menu.id))).forEach(menu=>{ %><span><%= menu.name %></span><% }); %></div><div class="category-open">Open workspace <span aria-hidden="true">↗</span></div></a><% }); %></section><div class="inventory-hint">ဘေး Menu မှလည်း ပစ္စည်းအုပ်စုနှင့် သက်ဆိုင်ရာ Submenu ကို ရွေးနိုင်ပါသည်။</div>
<% }else if(!page&&['raw-oil','finished-goods','raw-materials'].includes(group.id)){ %><%- include('raw-oil/coming-soon',{dashboardName:group.name,dashboardIcon:group.icon}) %>
<% }else if(!page){ %><div class="category-heading"><span class="category-icon icon-<%= group.icon %>"><%- include('partials/inventory-icon',{icon:group.icon}) %></span><div><h1><%= group.name %></h1><p class="muted"><%= group.description %></p></div></div><section class="action-grid" aria-label="<%= group.name %> menus"><% group.menus.filter(menu=>(!menu.adminOnly||user.role==='admin')&&(!menu.roles||menu.roles.includes(user.role))&&!(group.id==='raw-oil'&&user.role==='warehouse_accountant'&&['in','out'].includes(menu.id))).forEach((menu,index)=>{ %><a href="/inventory/<%= group.id %>/<%= menu.id %>" class="action-card"><span class="eyebrow">0<%= index+1 %></span><h2><%= menu.name %></h2><p class="muted"><%= menu.description %></p><span class="action-open">Open page →</span></a><% }); %></section>
<% }else{ %><h1><%= page.name %></h1><p class="muted"><%= page.description %></p><section class="design-empty"><span class="category-icon icon-<%= group.icon %>"><%- include('partials/inventory-icon',{icon:group.icon}) %></span><span class="design-badge">DESIGN PREVIEW</span><h2><%= page.name %></h2><p>ဤစာမျက်နှာအတွက် လိုအပ်သည့် အချက်အလက်များ သတ်မှတ်ပြီးမှ<br>Form နှင့် လုပ်ဆောင်ချက်များကို ဆက်လက်တည်ဆောက်မည်။</p><a href="/inventory/<%= group.id %>" class="empty-back">← <%= group.name %> Menu သို့</a></section><% } %>
<footer class="inventory-footer"><span>INVENTORY WORKSPACE</span><span>MEMORI · LUXURI · GENTLEMEN’S CLUB · FLORAL</span></footer></main></div></body></html>