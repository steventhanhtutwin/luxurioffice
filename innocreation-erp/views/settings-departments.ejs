<% if(error){ %><div class="error" role="alert"><%= error %></div><% } %>
<% if(view==='departments'){ %>
<p class="muted">User များအတွက် Department များ ဖန်တီး၊ ပြင်ဆင်၊ Void လုပ်ရန်။</p><% if(notice){ %><div class="settings-success" role="status">Department ကို <%= notice==='created'?'ဖန်တီး':notice==='updated'?'ပြင်ဆင်':'Void လုပ်' %>ပြီးပါပြီ။</div><% } %>
<form class="settings-form" method="post" action="/settings/departments"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Create Department</h2><label for="department-name">Department Name *</label><input id="department-name" name="name" value="<%= departmentName %>" maxlength="100" required><div class="settings-form-footer"><span></span><button type="submit">Create Department →</button></div></form>
<div class="settings-toolbar"><form method="get"><input name="q" value="<%= q %>" placeholder="Search Department" aria-label="Search Department"><button>Search</button><a href="/settings/departments">Reset</a></form></div>
<div class="settings-table-wrap"><table><thead><tr><th>Department Name</th><th>Status</th><th>Created By</th><th>Created At</th><th>Action</th><th>Voided By / At</th></tr></thead><tbody><% departmentRows.forEach(d=>{ %><tr><td><%= d.name %></td><td><%= Number(d.is_active)===1?'Active':'Voided' %></td><td><%= d.created_name||'—' %></td><td><%= d.created_at||'—' %></td><td><% if(Number(d.is_active)===1){ %><a href="/settings/departments/<%= d.id %>/edit">Edit</a> · <a href="/settings/departments/<%= d.id %>/void">Void</a><% }else{ %>—<% } %></td><td><%= d.voided_name||'—' %><% if(d.voided_at){ %><br><%= d.voided_at %><% } %></td></tr><% }); %><% if(!departmentRows.length){ %><tr><td colspan="6">Department မရှိသေးပါ။ အပေါ်မှ ဖန်တီးပါ။</td></tr><% } %></tbody></table></div>
<div class="settings-pagination"><span><%= total %> departments · Page <%= pageNo %></span><div><% if(pageNo>1){ %><a href="?q=<%= encodeURIComponent(q) %>&p=<%= pageNo-1 %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?q=<%= encodeURIComponent(q) %>&p=<%= pageNo+1 %>">Next →</a><% } %></div></div>
<% }else if(view==='department-edit'){ %>
<form class="settings-form" method="post" action="/settings/departments/<%= department.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="original_name" value="<%= department.name %>"><label for="department-name">Department Name *</label><input id="department-name" name="name" value="<%= departmentName %>" maxlength="100" required><p class="settings-note">ဤ Department နှင့် ချိတ်ထားသော User များတွင် အမည်အသစ် ပေါ်မည်။ User Role မပြောင်းပါ။</p><div class="settings-form-footer"><a href="/settings/departments">← Department List</a><button>Save Changes →</button></div></form>
<% }else{ %>
<section class="settings-form"><h2><%= department.name %></h2><p class="settings-note">Void လုပ်ပြီးရင် User အသစ်တွင် ရွေးမရတော့ပါ။ လက်ရှိ User များ၏ Department ကို ဆက်ထားမည်။</p><% if(Number(department.is_active)===1){ %><form method="post" action="/settings/departments/<%= department.id %>/void"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="confirm_void" value="yes"><input type="hidden" name="original_name" value="<%= department.name %>"><div class="settings-form-footer"><a href="/settings/departments">Cancel</a><button>Confirm Void</button></div></form><% }else{ %><p>Voided ဖြစ်ပြီးပါပြီ။</p><a href="/settings/departments">← Department List</a><% } %></section><% } %>
