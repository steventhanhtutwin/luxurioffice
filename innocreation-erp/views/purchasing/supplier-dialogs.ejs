<% const formValue=(dialog,key,fallback='')=>dialogError===dialog&&supplierValues[key]!==undefined?supplierValues[key]:fallback; %>
<%- include('supplier-add-dialog',{editMode:false,initialData:{}}) %>
<% if(selected){ %>
<% const editData={category_id:String(registrationInfo.category_id||''),status:registrationInfo.status==='VOID'?'VOID':'ACTIVE',name:selected.name,address:selected.address,category:registrationInfo.category||'',country:profile.country||'',tax_id:profile.tax_id||'',payment_terms:profile.payment_terms||'',note:profile.note||'',bank_count:String(Math.max(1,banks.length)),primary_bank:String(Math.max(0,banks.findIndex(b=>b.is_primary&&b.is_active)))};
const procurement=contacts.find(c=>/procurement|purchasing|primary/i.test(c.contact_type))||contacts.find(c=>!/finance|billing|remittance/i.test(c.contact_type));const finance=contacts.find(c=>c!==procurement&&/finance|billing|remittance/i.test(c.contact_type));const extras=contacts.filter(c=>c!==procurement&&c!==finance);editData.extra_contact_count=String(extras.length);
for(const [prefix,c] of [['procurement',procurement],['finance',finance],...extras.map((c,i)=>['extra_'+i,c])]){for(const [key,col] of [['name','contact_name'],['position','position'],['email','email'],['phone','phone'],['note','note'],['type','contact_type'],['id','id']])editData[prefix+'_'+key]=String(c?.[col]||'');editData[prefix+'_active']=!c||c.is_active?'1':'';}
if(procurement&&finance&&['contact_name','position','email','phone','note','is_active'].every(k=>String(procurement[k]??'')===String(finance[k]??'')))editData.same_finance='1';
if(!procurement){editData.procurement_name=profile.contact_person||'';editData.procurement_email=profile.email||'';editData.procurement_phone=selected.contact||'';}
for(const [i,b] of banks.entries()){for(const [key,col] of [['id','id'],['name','bank_name'],['holder','account_holder'],['number','account_number'],['currency','currency'],['branch','branch'],['note','note'],['label','account_label'],['swift','swift']])editData['bank_'+i+'_'+key]=String(b[col]||'');editData['bank_'+i+'_label']=b.account_label||'Settlement Account';editData['bank_'+i+'_active']=b.is_active?'1':'';}
%><%- include('supplier-add-dialog',{editMode:true,initialData:editData}) %>
<% for(const c of [{id:null,is_active:1},...contacts]){ const hasError=dialogError==='contact'&&String(supplierValues.contact_id||'')===String(c.id||'');const d=hasError?supplierValues:c; %>
<dialog class="sd-dialog" id="sd-contact-<%= c.id||'new' %>" <%- hasError?'data-sd-error':'' %>><div class="sd-dialog-title"><h2><%= c.id?'Edit':'Add' %> Contact</h2><button type="button" class="outline" data-sd-close aria-label="Close">×</button></div><% if(hasError){ %><p class="pu-warning" role="alert"><%= supplierError %></p><% } %><form method="post" action="<%= base %>/suppliers/<%= selected.id %>/contacts"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(c.id){ %><input type="hidden" name="contact_id" value="<%= c.id %>"><% } %><div class="pu-grid"><label>Contact Name<input name="contact_name" maxlength="255" value="<%= d.contact_name||'' %>" required></label><label>Contact Type<input name="contact_type" list="sd-contact-types" maxlength="100" value="<%= d.contact_type||'Purchasing Contact' %>" required></label><label>Position<input name="position" maxlength="255" value="<%= d.position||'' %>"></label><label>Email<input name="email" type="email" maxlength="255" value="<%= d.email||'' %>"></label><label>Phone<input name="phone" maxlength="255" value="<%= d.phone||'' %>"></label></div><p class="muted">Phone သို့မဟုတ် Email တစ်ခု အနည်းဆုံး ဖြည့်ပါ။</p><label>Notes<textarea name="note" maxlength="500"><%= d.note||'' %></textarea></label><div class="sd-checks"><label><input type="checkbox" name="is_active" value="1" <%= d.is_active==='1'||d.is_active===1?'checked':'' %>> Active Contact</label></div><button>Save Contact</button></form></dialog>
<% } %><datalist id="sd-contact-types"><option value="Purchasing Contact"><option value="Finance & Billing Contact"><option value="Sales Contact"><option value="General Contact"></datalist>
<% } %><span class="sd-copy-status" role="status" aria-live="polite"></span>
