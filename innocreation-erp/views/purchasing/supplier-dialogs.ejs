<% const formValue=(dialog,key,fallback='')=>dialogError===dialog&&supplierValues[key]!==undefined?supplierValues[key]:fallback; %>
<dialog class="sd-dialog" id="sd-add-dialog" <%- dialogError==='add'?'data-sd-error':'' %>><div class="sd-dialog-title"><h2>Add Supplier</h2><button type="button" class="outline" data-sd-close aria-label="Close">×</button></div><% if(dialogError==='add'){ %><p class="pu-warning" role="alert"><%= supplierError %></p><% } %><form method="post" action="<%= base %>/suppliers"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Supplier Name<input name="name" maxlength="255" value="<%= formValue('add','name') %>" required></label><label>Contact / Phone<input name="contact" maxlength="255" value="<%= formValue('add','contact') %>"></label><label>Address<textarea name="address" maxlength="500"><%= formValue('add','address') %></textarea></label><button>Save Supplier</button></form></dialog>
<% if(selected){ %>
<dialog class="sd-dialog" id="sd-edit-dialog" <%- dialogError==='edit'?'data-sd-error':'' %>><div class="sd-dialog-title"><h2>Edit Supplier</h2><button type="button" class="outline" data-sd-close aria-label="Close">×</button></div><% if(dialogError==='edit'){ %><p class="pu-warning" role="alert"><%= supplierError %></p><% } %><form method="post" action="<%= base %>/suppliers/<%= selected.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="pu-grid"><% for(const [key,label,value,max,required] of [['name','Supplier Name',selected.name,255,true],['contact','Company Phone',selected.contact,255,false],['country','Country',profile.country,100,false],['tax_id','Tax Registration ID',profile.tax_id,100,false],['payment_terms','Payment Terms',profile.payment_terms,500,false]]){ %><label><%= label %><input name="<%= key %>" maxlength="<%= max %>" value="<%= formValue('edit',key,value||'') %>" <%= required?'required':'' %>></label><% } %></div><label>Address<textarea name="address" maxlength="500"><%= formValue('edit','address',selected.address) %></textarea></label><label>Notes<textarea name="note" maxlength="1000"><%= formValue('edit','note',profile.note||'') %></textarea></label><button>Save Supplier Changes</button></form></dialog>
<% for(const c of [{id:null,is_active:1},...contacts]){ const hasError=dialogError==='contact'&&String(supplierValues.contact_id||'')===String(c.id||'');const d=hasError?supplierValues:c; %>
<dialog class="sd-dialog" id="sd-contact-<%= c.id||'new' %>" <%- hasError?'data-sd-error':'' %>><div class="sd-dialog-title"><h2><%= c.id?'Edit':'Add' %> Contact</h2><button type="button" class="outline" data-sd-close aria-label="Close">×</button></div><% if(hasError){ %><p class="pu-warning" role="alert"><%= supplierError %></p><% } %><form method="post" action="<%= base %>/suppliers/<%= selected.id %>/contacts"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(c.id){ %><input type="hidden" name="contact_id" value="<%= c.id %>"><% } %><div class="pu-grid"><label>Contact Name<input name="contact_name" maxlength="255" value="<%= d.contact_name||'' %>" required></label><label>Contact Type<input name="contact_type" list="sd-contact-types" maxlength="100" value="<%= d.contact_type||'Purchasing Contact' %>" required></label><label>Position<input name="position" maxlength="255" value="<%= d.position||'' %>"></label><label>Email<input name="email" type="email" maxlength="255" value="<%= d.email||'' %>"></label><label>Phone<input name="phone" maxlength="255" value="<%= d.phone||'' %>"></label></div><p class="muted">Phone သို့မဟုတ် Email တစ်ခု အနည်းဆုံး ဖြည့်ပါ။</p><label>Notes<textarea name="note" maxlength="500"><%= d.note||'' %></textarea></label><div class="sd-checks"><label><input type="checkbox" name="is_active" value="1" <%= d.is_active==='1'||d.is_active===1?'checked':'' %>> Active Contact</label></div><button>Save Contact</button></form></dialog>
<% } %><datalist id="sd-contact-types"><option value="Purchasing Contact"><option value="Finance & Billing Contact"><option value="Sales Contact"><option value="General Contact"></datalist>
<% } %><span class="sd-copy-status" role="status" aria-live="polite"></span>
