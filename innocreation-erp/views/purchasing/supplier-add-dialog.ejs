<% const mode=editMode?'edit':'add';const v=dialogError===mode?supplierValues:initialData;const dialogId=editMode?'sd-edit-dialog':'sd-add-dialog';const contactEntries=[['procurement','Primary Procurement Contact'],['finance','Finance / Remittance Contact'],...Array.from({length:Math.min(100,Math.max(0,Number(v.extra_contact_count)||0))},(_,i)=>['extra_'+i,'Additional Contact'])];const value=(key,fallback='')=>typeof v[key]==='string'?v[key]:fallback;const bankCount=/^\d{1,2}$/.test(v.bank_count||'')?Math.min(20,Math.max(1,Number(v.bank_count))):1; %>
<dialog class="sd-dialog sd-registration" id="<%= dialogId %>" <%- dialogError===mode?'data-sd-error':'' %>>
<div class="sd-registration-header"><span class="sd-registration-mark"><%- include('supplier-icon',{name:'company'}) %></span><div><h2><%= editMode?'Edit Supplier':'Add New Supplier' %></h2><p>Configure supplier details, contacts and settlement bank accounts.</p></div><button type="button" class="sd-close" data-sd-close aria-label="Close">×</button></div>
<form method="post" action="<%= editMode?base+'/suppliers/'+selected.id+'/edit':base+'/suppliers' %>" data-registration-form><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="contact_flags" value="1"><input type="hidden" name="extra_contact_count" value="<%= value('extra_contact_count','0') %>"><div class="sd-registration-body">
<% if(dialogError===mode){ %><p class="pu-warning" role="alert"><%= supplierError %></p><% } %>
<section class="sd-registration-section"><h3><%- include('supplier-icon',{name:'company'}) %> 1. SUPPLIER CORPORATE DETAILS</h3><div class="sd-registration-grid">
<label class="sd-span-two">Supplier Legal Name <em>*</em><input name="name" maxlength="255" value="<%= value('name') %>" placeholder="Supplier company or business name" required></label><label>Vendor Code<input value="<%= editMode?(registrationInfo.vendor_code||'SUP-'+String(selected.id).padStart(5,'0')):'Auto-generated on save' %>" readonly aria-label="Vendor Code"></label>
<label>Category <em>*</em><input name="category" maxlength="100" value="<%= value('category') %>" placeholder="e.g. Packaging & Print" required></label><label>Country <em>*</em><input name="country" maxlength="100" value="<%= value('country') %>" placeholder="e.g. Myanmar" required></label><label>Status<input value="<%= editMode?(registrationInfo.status==='VOID'?'Void':'Active'):'Active' %>" readonly aria-label="Status"></label>
<label class="sd-span-half">Tax Registration ID <small>(Optional)</small><input name="tax_id" maxlength="100" value="<%= value('tax_id') %>" placeholder="Tax registration number"></label><label class="sd-span-half">Payment Terms <em>*</em><select name="payment_terms" required><% for(const t of [...(editMode&&value('payment_terms')&&!TERMS.includes(value('payment_terms'))?[value('payment_terms')]:[]),...TERMS]){ %><option <%= value('payment_terms',TERMS[0])===t?'selected':'' %>><%= t %></option><% } %></select></label>
<label class="sd-span-all">Registered Business Address <em>*</em><textarea name="address" rows="2" maxlength="500" placeholder="Street, township, city, country" required><%= value('address') %></textarea></label>
</div></section>
<section class="sd-registration-section"><h3><%- include('supplier-icon',{name:'company'}) %> 2. PROCUREMENT & FINANCE CONTACTS</h3><div class="sd-contact-entry-grid"><% for(const [prefix,title] of contactEntries){ %><div class="sd-contact-entry"><input type="hidden" name="<%= prefix %>_id" value="<%= value(prefix+'_id') %>"><h4><%= title %></h4><div class="sd-entry-grid"><label>Full Name <em>*</em><input name="<%= prefix %>_name" maxlength="255" value="<%= value(prefix+'_name') %>" placeholder="Contact name" required></label><label>Role / Title<input name="<%= prefix %>_position" maxlength="255" value="<%= value(prefix+'_position') %>" placeholder="Position"></label><label>Email <small>(Optional)</small><input type="email" name="<%= prefix %>_email" maxlength="255" value="<%= value(prefix+'_email') %>" placeholder="contact@example.com"></label><label>Phone <em>*</em><input name="<%= prefix %>_phone" maxlength="255" value="<%= value(prefix+'_phone') %>" placeholder="Contact phone number" required></label></div><% if(prefix.startsWith('extra_')){ %><label>Contact Type<input name="<%= prefix %>_type" maxlength="100" value="<%= value(prefix+'_type','General Contact') %>" required></label><% } %><label>Contact Notes<textarea name="<%= prefix %>_note" maxlength="500" rows="2"><%= value(prefix+'_note') %></textarea></label><div class="sd-contact-options"><label class="sd-primary-choice"><input type="checkbox" name="<%= prefix %>_active" value="1" <%= value(prefix+'_active',editMode?'':'1')==='1'?'checked':'' %>> Active Contact</label><% if(prefix==='procurement'){ %><label class="sd-primary-choice"><input type="checkbox" name="same_finance" value="1" data-same-finance <%= value('same_finance')==='1'?'checked':'' %>> Same Finance Contact</label><% } %></div></div><% } %></div></section>
<section class="sd-registration-section"><div class="sd-bank-entry-heading"><div><h3><%- include('supplier-icon',{name:'bank'}) %> 3. SETTLEMENT BANK ACCOUNTS (<span data-bank-count><%= bankCount %></span>)</h3><p>Add multiple bank accounts and designate one Primary payout account.</p></div><button type="button" data-add-registration-bank>＋ Add Another Bank Account</button></div>
<input type="hidden" name="bank_count" value="<%= bankCount %>"><div data-registration-banks><% for(let i=0;i<bankCount;i++){ %><%- include('supplier-registration-bank',{index:i,values:v,editMode,primary:String(v.primary_bank??'0')===String(i)}) %><% } %></div>
<template data-registration-bank-template><%- include('supplier-registration-bank',{index:'__INDEX__',values:{},editMode,primary:false}) %></template>
</section><label class="sd-registration-notes">Supplier Notes <small>(Optional)</small><textarea name="note" maxlength="1000" rows="2"><%= value('note') %></textarea></label></div>
<footer class="sd-registration-footer"><button type="button" class="outline" data-sd-close>Cancel</button><button type="submit"><%= editMode?'Save Supplier Changes':'Create Supplier' %></button></footer></form></dialog>
