<% const show=v=>{if(v==null||v==='')return '—';const [a,b='']=String(v).split('.'),tail=b.replace(/0+$/,'');return a.replace(/\B(?=(\d{3})+(?!\d))/g,',')+(tail?'.'+tail:'');}; %>
<article class="po-paper print-sheet" aria-label="Purchase Order Form"><header class="po-letterhead"><div class="po-company"><div class="po-monogram" aria-hidden="true">IN</div><strong>INNOCREATION</strong></div><h2>Purchase Order</h2></header>
<table class="po-facts"><colgroup><col style="width:18%"><col style="width:28%"><col style="width:24%"><col style="width:30%"></colgroup><tbody><tr><th>Requesting Dep:</th><td><%= po.warehouse||'—' %></td><th>PO No:</th><td><strong><%= po.po_no %></strong></td></tr><tr><th>Requested By:</th><td><%= po.requested_name||'—' %></td><th>PO Date &amp; Time:</th><td><%= po.approved_at %></td></tr><tr><th>Supplier Site Code:</th><td>—</td><th>Supplier Phone / Contact:</th><td><%= po.supplier_contact||'—' %></td></tr><tr><th>Supplier Name:</th><td><strong><%= po.supplier_name %></strong></td><th>Quotation Attached:<br>Number of Quotations:</th><td>Yes ☐ &nbsp; No ☐<br><%= po.quotation_count??'—' %></td></tr><tr class="po-address-row"><th>Supplier Address:</th><td><%= po.supplier_address||'—' %></td><th>Delivery Address:</th><td>Main Warehouse</td></tr></tbody></table>
<table class="po-items"><colgroup><col style="width:4%"><col style="width:12%"><col style="width:23%"><col style="width:8%"><col style="width:6%"><col style="width:9%"><col style="width:11%"><col style="width:14%"><col style="width:13%"></colgroup><thead><tr><th>No.</th><th>Item Code</th><th>Item Description</th><th>Weight /<br>Size</th><th>UOM</th><th>Qty</th><th>Price</th><th>Amount</th><th>Remark</th></tr></thead><tbody><tr><td class="po-number">1</td><td><%= po.item_code %></td><td><%= po.item_name %></td><td></td><td><%= po.unit %></td><td class="po-number"><%= show(po.qty) %></td><td class="po-number"><%= show(po.unit_price) %></td><td class="po-number"><%= show(po.total) %></td><td></td></tr><% for(let row=2;row<=12;row++){ %><tr class="po-blank-row"><td class="po-number"><%= row %></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><% } %></tbody></table>
<div class="po-summary-row"><div class="po-terms"><p><strong>Currency:</strong> ☒ MMK &nbsp; ☐ THB &nbsp; ☐ USD</p><p><strong>Payment Terms:</strong> <%= po.payment_terms %></p><p><strong>Lead Time:</strong> <%= po.lead_days %></p></div><table class="po-totals"><tbody><tr><th>Subtotal:</th><td><%= show(po.total) %></td></tr><tr><th>Discount:</th><td>—</td></tr><tr><th>Tax:</th><td>—</td></tr><tr><th>Delivery Charges:</th><td>—</td></tr><tr class="po-grand-total"><th>Total Amt (MMK):</th><td><%= show(po.total) %></td></tr></tbody></table></div>
<section class="po-reason"><strong>Purpose / Reason for Purchase:</strong><p><%= po.purchase_reason||'—' %></p><% if(po.quote_notes){ %><p><strong>QC / Warranty &amp; Notes:</strong> <%= po.quote_notes %></p><% } %></section>
<div class="po-signatures"><section><h3>Purchase Request No: <%= po.request_no %></h3><div><p>Signature: __________________</p><p>Name: <%= po.requested_name||'' %></p><p>Position: __________________</p><p>Date: <%= po.requested_at||'' %></p></div></section><section><h3>Checked By — Accountant Supervisor</h3><div><p>Signature: __________________</p><p>Name: __________________</p><p>Position: __________________</p><p>Date: __________________</p></div></section><section><h3>Approved By / Authorized Person</h3><div><p>Signature: __________________</p><p>Name: <%= po.approved_name %></p><p>Position: __________________</p><p>Date: <%= po.approved_at %></p></div></section></div>
<footer class="po-form-footer">INNOCREATION · Purchase Order · <%= po.po_no %></footer></article>
