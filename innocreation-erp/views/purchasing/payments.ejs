<% const purposeName={ADVANCE:'Advance / Deposit',AFTER_DELIVERY:'After Delivery',BALANCE:'Balance Payment',OTHER:'Other'},methodName={BANK_TRANSFER:'Bank Transfer',CASH:'Cash',OTHER:'Other'}; %>
<% if(page==='settled'){ %>
<p class="pu-note">Issued PO များအတွက် advance / partial / balance payment ကို Finance ထံ တောင်းခံရန်။ ဤစနစ်သည် ငွေလွှဲခြင်းမပြုဘဲ ငွေပေးချေမှုမှတ်တမ်းကိုသာ သိမ်းပါသည်။</p>
<div class="pu-tabs"><% for(const [key,label] of [['','Outstanding / In Progress'],['pending','Finance Requests'],['paid','Fully Paid'],['settled','Settled'],['all','All POs']]){ %><a class="<%= f.tab===key?'active':'' %>" href="?<%= new URLSearchParams({q:f.q,tab:key}) %>"><%= label %></a><% } %></div>
<form class="pu-search" method="get"><input type="hidden" name="tab" value="<%= f.tab %>"><div><input name="q" value="<%= f.q %>" placeholder="PO / PR number / supplier" aria-label="Search payments"><button>Search</button></div><a href="<%= base %>/settled">Reset</a></form>
<div class="pu-table"><table><thead><tr><th>PO / Supplier</th><th>PO Total · MMK</th><th>Paid</th><th>Pending Finance</th><th>Remaining</th><th>Delivery / Payment Status</th><th>Action</th></tr></thead><tbody><% for(const p of paymentRows){ %><tr><td><strong><%= p.po_no %></strong><small><%= p.supplier_name %></small><small><%= p.request_no %></small></td><td><%= fmt(p.total) %></td><td><%= fmt(p.paid_amount) %></td><td><%= fmt(p.pending_amount) %></td><td><strong><%= fmt(p.remaining_amount) %></strong></td><td><span class="pu-badge"><%= p.settled?'Settled & Paid':p.payment_status %></span><small><%= statusLabel(p.status) %></small></td><td><div class="pu-row-actions"><a class="pu-button" href="<%= base %>/settled/<%= p.id %>">Payments →</a><a class="pu-button outline" href="<%= base %>/po/<%= p.id %>">View PO →</a></div></td></tr><% } %><% if(!paymentRows.length){ %><tr><td colspan="7">သက်ဆိုင်သော PO မရှိသေးပါ။</td></tr><% } %></tbody></table><footer><span><%= total %> records · Page <%= pageNo %></span><nav><% if(pageNo>1){ %><a href="?<%= qs(pageNo-1) %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?<%= qs(pageNo+1) %>">Next →</a><% } %></nav></footer></div>
<% }else{const p=paymentPo; %>
<div class="pu-actions"><a class="pu-button outline" href="<%= base %>/settled">← Back to Payments</a><a class="pu-button outline" href="<%= base %>/po/<%= p.id %>">View PO →</a></div>
<section class="pu-card"><header class="pu-target"><h2><%= p.po_no %> — <%= p.supplier_name %></h2><span class="pu-badge"><%= p.settled?'Settled & Paid':p.payment_status %></span></header><p><%= p.item_name %> · <%= p.request_no %></p><p>Payment Terms: <strong><%= p.payment_terms %></strong> · Delivery: <%= statusLabel(p.status) %></p><div class="pu-payment-summary"><div>PO Total<strong><%= fmt(p.total) %> MMK</strong></div><div>Paid<strong><%= fmt(p.paid_amount) %> MMK</strong></div><div>Pending Finance<strong><%= fmt(p.pending_amount) %> MMK</strong></div><div>Remaining<strong><%= fmt(p.remaining_amount) %> MMK</strong></div></div><p class="pu-note">Remaining သည် မပေးချေရသေးသော ပမာဏဖြစ်ပါသည်။ တောင်းခံနိုင်သေးသော ပမာဏ: <strong><%= fmt(p.available_amount) %> MMK</strong> (Pending request များ နုတ်ပြီး)။ Fully Paid ဖြစ်သော်လည်း ပစ္စည်းလက်ခံမှု မပြီးသေးလျှင် Settled မဖြစ်သေးပါ။</p></section>
<% if(paymentError){ %><p class="pu-warning" role="alert"><%= paymentError %></p><% } %>
<% if(Number(p.available_amount)>0){ %><section class="pu-card"><h2>Request Payment from Finance</h2><form class="pu-form" method="post" action="<%= base %>/settled/<%= p.id %>/request"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= requestKey %>"><div class="pu-grid"><label>Amount · MMK<input name="amount" type="number" min="0.0001" max="<%= p.available_amount %>" step="0.0001" required></label><label>Payment Purpose<select name="purpose" required><% for(const [key,label] of Object.entries(purposeName)){ %><option value="<%= key %>"><%= label %></option><% } %></select></label></div><label>Reason / Payment Instructions<textarea name="reason" maxlength="500" required></textarea></label><button>Request Finance Payment</button></form></section><% } %>
<section class="pu-card"><h2>Payment Requests &amp; History</h2><% if(!paymentHistory.length){ %><p class="pu-note">Payment request မတင်ရသေးပါ။</p><% } %><% for(const r of paymentHistory){ %><article class="pu-payment-request"><header class="pu-target"><strong>Request #<%= r.id %> · <%= fmt(r.amount) %> MMK</strong><span class="pu-badge"><%= r.status==='REQUESTED'?'Awaiting Finance':r.status==='PAID'?'Payment Recorded':'Request Rejected' %></span></header><p><%= purposeName[r.purpose] %> · <%= r.requested_name %> · <%= r.requested_at %></p><p class="pu-payment-text"><%= r.reason %></p><% if(r.decided_at){ %><p><%= r.decided_name %> · <%= r.decided_at %><% if(r.payment_reference){ %> · <%= methodName[r.payment_method] %> · Reference: <strong><%= r.payment_reference %></strong><% } %></p><% if(r.decision_note){ %><p class="pu-payment-text"><%= r.decision_note %></p><% } %><% } %>
<% if(r.status==='REQUESTED'&&canPay){ %><p class="pu-note">အပြင်တွင် အမှန်တကယ် ငွေပေးချေပြီးမှ Record Payment ကို နှိပ်ပါ။ ဤခလုတ်မှ ငွေလွှဲခြင်း မပြုပါ။</p><form class="pu-form" method="post" action="<%= base %>/settled/<%= p.id %>/requests/<%= r.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="paid"><div class="pu-grid"><label>Payment Method<select name="payment_method" required><option value="BANK_TRANSFER">Bank Transfer</option><option value="CASH">Cash</option><option value="OTHER">Other</option></select></label><label>Bank / Voucher Reference<input name="payment_reference" maxlength="100" required></label></div><label>Finance Note<textarea name="note" maxlength="500"></textarea></label><button>Record Payment · <%= fmt(r.amount) %> MMK</button></form><form class="pu-inline" method="post" action="<%= base %>/settled/<%= p.id %>/requests/<%= r.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Reject Reason<input name="note" maxlength="500" required></label><button name="action" value="reject" class="pu-reject">Reject Payment Request</button></form><% }else if(r.status==='REQUESTED'){ %><p class="pu-note">Finance အတည်ပြုမှတ်တမ်းတင်ရန် စောင့်နေပါသည်။</p><% } %></article><% } %></section>
<% } %>
