<% const purposeName={ADVANCE:'Advance / Deposit',AFTER_DELIVERY:'After Delivery',BALANCE:'Balance Payment',OTHER:'Other'},methodName={BANK_TRANSFER:'Bank Transfer',CASH:'Cash',OTHER:'Other'}; %>
<div class="pu-payment-workspace"><span>Active Workspace Role:</span><div role="group" aria-label="Payment workspace"><a class="<%= paymentWorkspace==='purchaser'?'active':'' %>" href="<%= base %>/settled<%= page==='payment-detail'?'/'+paymentPo.id:'' %>?view=purchaser" <%- paymentWorkspace==='purchaser'?'aria-current="page"':'' %>><span class="pu-view-dot"></span>Purchaser View</a><% if(canUseFinance){ %><a class="<%= paymentWorkspace==='finance'?'active':'' %>" href="<%= base %>/settled<%= page==='payment-detail'?'/'+paymentPo.id:'' %>?view=finance" <%- paymentWorkspace==='finance'?'aria-current="page"':'' %>><span class="pu-view-dot finance"></span>Finance Team View</a><% } %></div></div>
<% if(page==='settled'){ %>
<p class="pu-note">Issued PO များအတွက် advance / partial / balance payment ကို Finance ထံ တောင်းခံရန်။ ဤစနစ်သည် ငွေလွှဲခြင်းမပြုဘဲ ငွေပေးချေမှုမှတ်တမ်းကိုသာ သိမ်းပါသည်။</p>
<div class="pu-tabs"><% for(const [key,label] of [['','Outstanding / In Progress'],['pending','Finance Requests'],['paid','Fully Paid'],['settled','Settled'],['all','All POs']]){ %><a class="<%= f.tab===key?'active':'' %>" href="?<%= new URLSearchParams({q:f.q,tab:key,view:paymentWorkspace}) %>"><%= label %></a><% } %></div>
<form class="pu-search" method="get"><input type="hidden" name="view" value="<%= paymentWorkspace %>"><input type="hidden" name="tab" value="<%= f.tab %>"><div><input name="q" value="<%= f.q %>" placeholder="PO / PR number / supplier" aria-label="Search payments"><button>Search</button></div><a href="<%= base %>/settled?view=<%= paymentWorkspace %>">Reset</a></form>
<div class="pu-table"><table><thead><tr><th>PO / Supplier</th><th>PO Total · MMK</th><th>Paid</th><th>Pending Finance</th><th>Remaining</th><th>Delivery / Payment Status</th><th>Action</th></tr></thead><tbody><% for(const p of paymentRows){ %><tr><td><strong><%= p.po_no %></strong><small><%= p.supplier_name %></small><small><%= p.request_no %></small></td><td><%= fmt(p.total) %></td><td><%= fmt(p.paid_amount) %></td><td><%= fmt(p.pending_amount) %></td><td><strong><%= fmt(p.remaining_amount) %></strong></td><td><span class="pu-badge"><%= p.settled?'Settled & Paid':p.payment_status %></span><small><%= statusLabel(p.status) %></small></td><td><div class="pu-row-actions"><a class="pu-button" href="<%= base %>/settled/<%= p.id %>?view=<%= paymentWorkspace %>">Payments →</a><a class="pu-button outline" href="<%= base %>/po/<%= p.id %>">View PO →</a></div></td></tr><% } %><% if(!paymentRows.length){ %><tr><td colspan="7">သက်ဆိုင်သော PO မရှိသေးပါ။</td></tr><% } %></tbody></table><footer><span><%= total %> records · Page <%= pageNo %></span><nav><% if(pageNo>1){ %><a href="?<%= new URLSearchParams({...f,view:paymentWorkspace,p:String(pageNo-1)}) %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?<%= new URLSearchParams({...f,view:paymentWorkspace,p:String(pageNo+1)}) %>">Next →</a><% } %></nav></footer></div>
<% }else{const p=paymentPo; %>
<div class="pu-actions"><a class="pu-button outline" href="<%= base %>/settled?view=<%= paymentWorkspace %>">← Back to Payments</a><a class="pu-button outline" href="<%= base %>/po/<%= p.id %>">View PO →</a></div>
<section class="pu-card pu-payment-overview"><header class="pu-target"><h2><%= p.po_no %> — <%= p.supplier_name %></h2><span class="pu-badge"><%= p.settled?'Settled & Paid':p.payment_status %></span></header><p><%= p.item_name %> · <%= p.request_no %></p><p>Payment Terms: <strong><%= p.payment_terms %></strong> · Delivery: <%= statusLabel(p.status) %></p><div class="pu-payment-summary"><div>PO Total<strong><%= fmt(p.total) %> MMK</strong></div><div>Paid<strong><%= fmt(p.paid_amount) %> MMK</strong></div><div>Pending Finance<strong><%= fmt(p.pending_amount) %> MMK</strong></div><div>Remaining<strong><%= fmt(p.remaining_amount) %> MMK</strong></div></div><p class="pu-note">Remaining သည် မပေးချေရသေးသော ပမာဏဖြစ်ပါသည်။ တောင်းခံနိုင်သေးသော ပမာဏ: <strong><%= fmt(p.available_amount) %> MMK</strong> (Pending request များ နုတ်ပြီး)။ Fully Paid ဖြစ်သော်လည်း ပစ္စည်းလက်ခံမှု မပြီးသေးလျှင် Settled မဖြစ်သေးပါ။</p></section>
<% if(paymentError){ %><p class="pu-warning" role="alert"><%= paymentError %></p><% } %>
<% if(paymentWorkspace==='purchaser'&&Number(p.available_amount)>0){ %><section class="pu-card pu-payment-request-form"><header class="pu-request-heading"><div><h2>Request Payment from Finance <span class="pu-request-tag">Purchaser Action</span></h2><p>Submit an advance, partial or balance payment request to Finance.</p></div><button type="button" class="outline" data-payment-autofill>⚡ Auto-Fill Request</button></header><form class="pu-form" data-payment-quick-form data-po-total="<%= p.total %>" data-available="<%= p.available_amount %>" data-paid="<%= p.paid_amount %>" data-delivered="<%= p.status==='COMPLETED' %>" data-po-number="<%= p.po_no %>" data-supplier="<%= p.supplier_name %>" method="post" action="<%= base %>/settled/<%= p.id %>/request"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= requestKey %>"><div class="pu-grid"><div class="pu-quick-amount"><label><span class="pu-amount-label"><span>Amount · MMK *</span><small>Max available: <strong><%= fmt(p.available_amount) %> MMK</strong></small></span><input name="amount" type="number" min="0.0001" max="<%= p.available_amount %>" step="0.0001" placeholder="e.g. 3000000" required></label><div class="pu-quick-buttons" role="group" aria-label="Quick payment amount"><span>Quick fill:</span><button type="button" data-payment-percent="30" aria-pressed="false">30% Advance</button><button type="button" data-payment-percent="50" aria-pressed="false">50% Advance</button><button type="button" data-payment-remaining aria-pressed="false">100% Remaining</button></div><div class="pu-custom-percent"><label>Custom %<input type="number" data-payment-custom min="0.01" max="100" step="0.01" placeholder="25" aria-label="Custom percentage"></label><button type="button" data-payment-custom-fill>Fill Amount</button></div><small class="pu-quick-hint">30% / 50% / custom % use the PO total. Remaining excludes pending requests.</small></div><div><label>Payment Purpose<select name="purpose" required><% for(const [key,label] of Object.entries(purposeName)){ %><option value="<%= key %>"><%= label %></option><% } %></select></label><p class="pu-payment-preview" data-payment-preview role="status" aria-live="polite">Enter an amount to preview the payment status.</p></div></div><p class="pu-quick-feedback" data-payment-feedback aria-live="polite"></p><label>Reason / Payment Instructions<textarea name="reason" maxlength="500" placeholder="Enter supplier bank / wallet details, deposit terms or invoice reference." required></textarea></label><div class="pu-payment-submit"><button>Request Finance Payment</button><span>Submits a request to Finance. Payment is recorded separately by Finance.</span></div></form></section><% } %>
<section class="pu-card"><h2>Payment Requests &amp; History</h2><% if(!paymentHistory.length){ %><p class="pu-note">Payment request မတင်ရသေးပါ။</p><% } %><% for(const r of paymentHistory){ %><article class="pu-payment-request"><header class="pu-target"><strong>Request #<%= r.id %> · <%= fmt(r.amount) %> MMK</strong><div class="pu-payment-history-badges"><% if(r.is_partial_payment){ %><span class="pu-badge pu-payment-partial-badge">Advance / Partially Paid</span><% } %><span class="pu-badge"><%= r.status==='REQUESTED'?'Awaiting Finance':r.status==='PAID'?'Payment Recorded':'Request Rejected' %></span></div></header><p><%= purposeName[r.purpose] %> · <%= r.requested_name %> · <%= r.requested_at %></p><p class="pu-payment-text"><%= r.reason %></p><% if(r.decided_at){ %><p><%= r.decided_name %> · <%= r.decided_at %><% if(r.payment_reference){ %> · <%= methodName[r.payment_method] %> · Reference: <strong><%= r.payment_reference %></strong><% } %></p><% if(r.decision_note){ %><p class="pu-payment-text"><%= r.decision_note %></p><% } %><% } %>
<% if(r.status==='REQUESTED'&&canPay){ %><p class="pu-note">အပြင်တွင် အမှန်တကယ် ငွေပေးချေပြီးမှ Record Payment ကို နှိပ်ပါ။ ဤခလုတ်မှ ငွေလွှဲခြင်း မပြုပါ။</p><form class="pu-form" data-finance-payment-decision method="post" action="<%= base %>/settled/<%= p.id %>/requests/<%= r.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="workspace_view" value="finance"><div class="pu-grid"><label>Payment Method<select name="payment_method" required><option value="BANK_TRANSFER">Bank Transfer</option><option value="CASH">Cash</option><option value="OTHER">Other</option></select></label><label>Bank / Voucher Reference<input name="payment_reference" maxlength="100" data-payment-reference required></label></div><label>Finance Note<textarea name="note" maxlength="500" data-finance-note></textarea></label><div class="pu-actions"><button name="action" value="paid">Record Payment · <%= fmt(r.amount) %> MMK</button><button name="action" value="reject" class="pu-reject" data-reject-payment formnovalidate>Reject Payment Request</button></div><p class="pu-note">Reject လုပ်ရန် Finance Note တွင် အကြောင်းပြချက် ဖြည့်ပါ။</p></form><% }else if(r.status==='REQUESTED'){ %><p class="pu-note">Finance အတည်ပြုမှတ်တမ်းတင်ရန် စောင့်နေပါသည်။</p><% } %></article><% } %></section>
<% } %>
