<% if(categoryUpdated&&editing){ %><p class="pu-note" role="status">✓ Category updated. Saved Status: <strong><%= editing.status==='VOID'?'Void':'Active' %></strong></p><% } %>
<section class="sc-manager"><div class="sc-editor"><% if(editing){ %><div class="sc-edit-banner">Editing [<%= categoryCode(editing.id) %>] <%= editing.name %><a href="<%= base %>/supplier-categories">Switch to Create</a></div><% } %><h2><%= editing?'Edit':'Create' %> Supplier Category</h2><p class="muted"><%= editing?'Updates apply to linked suppliers.':'Define a category for supplier classification.' %></p><% if(categoryError){ %><p role="alert" class="pu-warning"><%= categoryError %></p><% } %><form method="post" action="<%= base %>/supplier-categories<%= editing?'/'+editing.id+'/edit':'' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Category Name <em>*</em><input name="name" maxlength="100" value="<%= categoryValues.name!==undefined?categoryValues.name:editing?.name||'' %>" placeholder="e.g. Packaging & Vessels" required></label><label>Description <small>(Optional)</small><textarea name="description" maxlength="1000" rows="4" placeholder="Scope of goods or services in this category"><%= categoryValues.description!==undefined?categoryValues.description:editing?.description||'' %></textarea></label><% if(editing){ %><label>Status <em>*</em><select name="status" required><% for(const [key,title] of [['ACTIVE','Active'],['VOID','Void']]){ %><option value="<%= key %>" <%= (categoryValues.status??editing.status)===key?'selected':'' %>><%= title %></option><% } %></select></label><% } %><div class="sc-submit"><button><%= editing?'✓ Update Category':'＋ Create Category' %></button><% if(editing){ %><a class="pu-button outline" href="<%= base %>/supplier-categories">Cancel Edit</a><% } %></div></form></div>
<div class="sc-saved"><div class="sc-saved-heading"><div><h3>Saved Supplier Categories</h3><p class="muted">Manage categories across linked suppliers.</p></div><span class="pu-badge"><%= categories.length %> total</span></div><div class="sc-category-list"><% for(const c of categories){ %><article class="sc-category <%= editing&&String(editing.id)===String(c.id)?'selected':'' %>"><div class="sc-category-content"><div class="sc-category-label"><strong><%= categoryCode(c.id) %></strong><b><%= c.name %></b></div><span class="sc-linked"><%= c.supplier_count %> supplier<%= Number(c.supplier_count)===1?'':'s' %></span><span class="sd-status <%= c.status==='VOID'?'negative':'positive' %>"><%= c.status==='VOID'?'Void':'Active' %></span><% if(c.description){ %><p class="pu-preserve"><%= c.description %></p><% } %></div><div class="sc-category-actions"><a class="pu-button outline" href="<%= base %>/supplier-categories?edit=<%= c.id %>">✎ Edit</a><form method="post" action="<%= base %>/supplier-categories/<%= c.id %>/void" data-category-void><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="confirmed" value="0"><button class="outline" <%= c.status==='VOID'?'disabled':'' %>><%- include('supplier-icon',{name:'trash'}) %> Delete</button></form></div></article><% } %><% if(!categories.length){ %><p class="sd-empty">Category မရှိသေးပါ။ ဘယ်ဘက် Form မှ ဖန်တီးနိုင်ပါသည်။</p><% } %></div></div></section>
<script src="/purchasing-supplier-categories.js?v=1" defer></script>
