<form method="post" action="<%= action %>" class="sd-bank-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(b.id||b.bank_id){ %><input type="hidden" name="bank_id" value="<%= b.id||b.bank_id %>"><% } %><div class="pu-grid"><% for(const [key,title,max] of [['bank_name','Bank Name',255],['account_holder','Account Holder',255],['account_number','Account Number / IBAN',100],['currency','Currency',3]]){ %><label><%= title %><input name="<%= key %>" maxlength="<%= max %>" value="<%= b[key]||'' %>" <%= key!=='branch'?'required':'' %>></label><% } %></div><label>Notes<textarea name="note" maxlength="500"><%= b.note||'' %></textarea></label><div class="sd-checks"><label><input type="checkbox" name="is_active" value="1" <%= b.is_active?'checked':'' %>> Active</label><label><input type="checkbox" name="is_primary" value="1" <%= b.is_primary?'checked':'' %>> Primary Account</label></div><button>Save Bank Account</button></form>
