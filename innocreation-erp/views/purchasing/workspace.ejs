<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Purchasing | INNOCREATION</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/workspace.css"><link rel="stylesheet" href="/inventory-navigation.css?v=3"><link rel="stylesheet" href="/purchasing.css?v=16"><script src="/purchasing.js?v=6" defer></script><% if(['po-detail','pr-detail'].includes(page)){ %><link rel="stylesheet" href="/purchase-order-form.css?v=1"><% if(page==='pr-detail'){ %><link rel="stylesheet" href="/purchase-requisition-form.css?v=2"><% } %><% } %><% if(buy){ %><link rel="stylesheet" href="/purchasing-sidebar.css?v=1"><script src="/purchasing-sidebar.js?v=1" defer></script><% } %><% if(page==='payment-detail'){ %><script src="/purchasing-payment-quick.js?v=1" defer></script><% } %></head><body class="app-home purchase-app"><header class="app-header"><div class="pu-brand-area"><% if(buy){ %><button type="button" class="pu-menu-toggle" aria-controls="purchasing-sidebar" aria-expanded="true" aria-label="Hide sidebar" title="Hide sidebar" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><% } %><a class="app-logo" href="/dashboard">INNOCREATION <span>/ ERP</span></a></div><div class="account-area"><a class="back-link" href="/dashboard">← Main Dashboard</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="logout">Logout</button></form></div></header><div class="inventory-shell"><aside class="inventory-sidebar" id="purchasing-sidebar"><p class="eyebrow"><%= buy?'PURCHASING':appScope.toUpperCase() %></p><nav><details class="nav-group" open><summary><span class="inventory-menu-label"><span class="inventory-menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 3h3l3 13h11l3-10H6M