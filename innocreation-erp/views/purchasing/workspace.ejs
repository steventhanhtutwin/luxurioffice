':menus.find(m=>m[0]===active)?.[1]||'Purchasing' %></h1><p class="muted"><%= buy?'ဝယ်ယူတောင်းခံမှု၊ Supplier Quote၊ PO နှင့် ပစ္စည်းလက်ခံမှု စီမံရန်။':'Warehouse မှ ဝယ်ယူတောင်းခံခြင်းနှင့် ပစ္စည်းလက်ခံခြင်း။' %></p></div><% if(page==='pr'&&!queueMode){ %><a class="pu-button" href="<%= base %>/pr/new">＋ New Purchase Requisition</a><% } %></div>
<% if(buy&&!['suppliers','materials','material-ledger'].includes(page)){const icons={pr:'M6 3h8l4 4v14H6z M14 3v5h5 M9 12h6 M9 16h4',finance:'M12 3l8 4v6c0 4-8 8-8 8s-8-4-8-8V7z M8 12l3 3 5-6',comparison:'M20 11a8 8 0 1 1-4-7 M8 11l4 4L21 4',po:'M3 4l18 7-8 3-3 7z M10 14L21 4',grn:'M12 3l8 4v10l-8 4-8-4V7z M4 7l8 4 8-4 M12 11v10',settled:'M12 3l8 4v10l-8 4-8-4V7z M8 12l3 3 5-6'},stageCounts={pr:counts.draft_pr,finance:counts.finance_pr,comparison:counts.md_pr,po:counts.open_po,grn:counts.pending_grn,settled:counts.settled_open},subtitles={pr:'Requests & Vendor Quotes',finance:'Finance Review Queue',comparison:'Vendor Selection & Approval',po:'Ready to Issue PO',grn:'QC & Warehouse Stock In',settled:'Payment & Settlement'}; %><div class="pu-progress"><% for(const [index,[id,name]] of menus.entries()){ %><% if(restricted(id)){ %><div class="pu-progress-card disabled <%= active===id?'active':'' %>" aria-disabled="true"><% }else{ %><a class="pu-progress-card <%= active===id?'active':'' %>" href="<%= base+'/'+id %>" <%- active===id?'aria-current="step"':'' %>><% } %><span class="pu-progress-top"><span class="pu-progress-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="<%= icons[id] %>"/></svg></span><b><%= stageCounts[id]||0 %></b></span><strong><%= index+1 %>. <%= name %></strong><small><%= subtitles[id] %></small><% if(restricted(id)){ %></div><% }else{ %></a><% } %><% } %></div><% } %>
<% if(['settled','payment-detail'].includes(page)){ %><%- include('payments',{fmt,qs}) %><% } %>
<% if(page==='po'&&buy){ %><section class="pu-card"><h2>Ready to Issue PO</h2><div class="pu-table"><table><thead><tr><th>PR Number</th><th>Supplier / Material</th><th>Qty × Unit Price</th><th>Total (MMK)</th><th>Action</th></tr></thead><tbody><% if(!readyOrders.length){ %><tr><td colspan="5">PO Issue လုပ်ရန် ကျန်သော Request မရှိသေးပါ။</td></tr><% } %><% for(const draft of readyOrders){ %><tr><td><%= draft.request_no %></td><td><strong><%= draft.supplier_name %></strong><small><%= draft.item_name %></small></td><td><%= fmt(draft.order_qty) %> <%= draft.unit %> × <%= fmt(draft.unit_price) %></td><td><strong><%= fmt(draft.total) %></strong></td><td><% if(user.role==='admin'){ %><form method="post" action="<%= base %>/pr/<%= draft.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="quote_id" value="<%= draft.selected_quote_id %>"><button name="action" value="approve">PO Issue</button></form><% }else{ %><span class="pu-badge">Awaiting PO Issue</span><% } %></td></tr><% } %></tbody></table></div></section><% } %>
<% if(['pr','po','grn'].includes(page)&&!(page==='po'&&buy)){ %>
<% if(page==='grn'){ %><div class="pu-tabs"><a class="<%= receiptTab==='pending'?'active':'' %>" href="<%= base %>/grn">Pending Receipts (<%= pendingOrders.length %>)</a><a class="<%= receiptTab==='history'?'active':'' %>" href="<%= base %>/grn?tab=history">Received History</a></div><% } %>
<% if(page==='grn'&&receiptTab==='pending'){ %><div class="pu-table"><table><thead><tr><th>PO / Supplier</th><th>Material</th><th>Ordered</th><th>Accepted</th><th>Remaining</th><th>Action</th></tr></thead><tbody><% for(const p of pendingOrders){ %><tr><td><strong><%= p.po_no %></strong><small><%= p.supplier_name %></small></td><td><%= p.item_name %><small><%= p.item_code %></small></td><td><%= fmt(p.qty) %> <%= p.unit %></td><td><%= fmt(p.accepted_qty) %></td><td><%= fmt(Number(p.qty)-Number(p.accepted_qty)) %> <%= p.unit %></td><td><a class="pu-button" href="<%= base %>/grn/new/<%= p.id %>">Receive Goods (GRN) →</a></td></tr><% } %><% if(!pendingOrders.length){ %><tr><td colspan="6">လက်ခံရန် PO မရှိသေးပါ။</td></tr><% } %></tbody></table></div><% }else{ %>
<% if(page==='pr'&&!queueMode){ %><div class="pu-tabs"><% for(const [s,t] of [['','All Requisitions'],['READY_RFQ','Ready for RFQ'],['RFQ_IN_PROGRESS','RFQ In Progress'],['FINANCE_RESUBMIT','Finance Ask To Resubmit'],['MD_RESUBMIT','MD/CEO Ask To Resubmit'],['PENDING_FINANCE','Pending Finance'],['FINANCE_CHECKED','Pending MD/CEO'],['REJECTED','Rejected'],['PENDING_APPROVAL','Ready to Issue PO'],['CONVERTED_PO','PO Issued']]){ %><a class="<%= f.status===s?'active':'' %>" href="?<%= new URLSearchParams({...f,status:s,p:'1'}) %>"><%= t %></a><% } %></div><% } %>
<form class="pu-search" method="get"><div><input name="q" value="<%= f.q %>" placeholder="Search number / item / supplier…" aria-label="Search"><button>Search</button><details><summary aria-label="Search filters">▾</summary><section><% if(page!=='grn'&&!queueMode){ %><label>Status<select name="status"><option value="">All Statuses</option><% for(const s of page==='pr'?['READY_RFQ','RFQ_IN_PROGRESS','FINANCE_RESUBMIT','MD_RESUBMIT','PENDING_FINANCE','FINANCE_CHECKED','PENDING_APPROVAL','CONVERTED_PO','REJECTED']:['ISSUED','SENT','PARTIAL','COMPLETED']){ %><option value="<%= s %>" <%= f.status===s?'selected':'' %>><%= statusLabel(s) %></option><% } %></select></label><% } %><label>From Date<input type="date" name="from" value="<%= f.from %>"></label><label>To Date<input type="date" name="to" value="<%= f.to %>"></label><button>Apply Filters</button></section></details></div><a class="pu-button outline" href="<%= base+'/'+(queueMode||page) %>/export.xlsx?<%= new URLSearchParams(f) %>">↓ Download Excel</a><a href="<%= base+'/'+(queueMode||page) %>">Reset</a></form>
<div class="pu-table"><table><thead><tr><% for(const title of page==='pr'?['PR Number & Date','Material & Item Code','Stock / Reorder','Requested Qty','Priority','Status','Action']:page==='po'?['PO Number','Supplier','Material','Qty × Unit Price','Total (MMK)','Status','Action']:['GRN Number','PO / Supplier','Material','Received / Rejected','Accepted','Received By & Time','Action']){ %><th><%= title %></th><% } %></tr></thead><tbody><% for(const row of rows){if(page==='pr'){ %><tr><td><a href="<%= base %>/<%= queueMode==='finance'?'finance?pr=':queueMode==='comparison'?'comparison?pr=':'pr/' %><%= row.id %>"><strong><%= row.request_no %></strong></a><small><%= row.created_at %> · <%= row.warehouse %></small><small><%= row.created_name %></small></td><td><strong><%= row.item_name %></strong><small><%= row.item_code %></small></td><td><strong><%= fmt(row.current_stock) %> <%= row.unit %></strong><small>Reorder: <%= fmt(row.current_reorder) %></small><small>Main Warehouse · live</small></td><td><strong><%= fmt(row.qty) %> <%= row.unit %></strong></td><td><span class="pu-badge <%= row.priority==='URGENT'?'urgent':'' %>"><%= row.priority %></span></td><td><span class="pu-badge"><%= statusLabel(row.status) %></span><% if(['FINANCE_RESUBMIT','MD_RESUBMIT'].includes(row.status)&&row.rejection_reason){ %><small class="pu-red"><%= row.rejection_reason %></small><% } %></td><td><div class="pu-row-actions"><% if(buy&&['READY_RFQ','RFQ_IN_PROGRESS','FINANCE_RESUBMIT','MD_RESUBMIT'].includes(row.status)){ %><form method="post" action="<%= base %>/pr/<%= row.id %>/quotes"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Enter Quotes →</button></form><% }else{ %><% if(buy&&!queueMode){ %><form method="post" action="<%= base %>/pr/<%= row.id %>/quotes"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="outline">View Quotes →</button></form><% } %><% if(buy&&['admin','warehouse_accountant'].includes(user.role)&&row.status==='PENDING_FINANCE'){ %><a class="pu-button" href="<%= base %>/finance?pr=<%= row.id %>">Finance Review →</a><% }else if(buy&&user.role==='admin'&&row.status==='FINANCE_CHECKED'){ %><a class="pu-button" href="<%= base %>/comparison?pr=<%= row.id %>">MD/CEO Review →</a><% }else if(buy&&row.status==='PENDING_APPROVAL'){ %><a class="pu-button" href="<%= base %>/po">Go to Purchase Order →</a><% } %><a class="pu-button outline" href="<%= base %>/pr/<%= row.id %>">View PR →</a><% if(buy&&row.issued_po_id){ %><a class="pu-button outline" href="<%= base %>/po/<%= row.issued_po_id %>">View PO →</a><a class="pu-button outline" href="<%= base %>/settled/<%= row.issued_po_id %>">Payments →</a><% } %><% } %></div></td></tr>
<% }else if(page==='po'){ %><tr><td><strong><%= row.po_no %></strong><small>PR: <%= row.request_no %></small></td><td><%= row.supplier_name %></td><td><strong><%= row.item_name %></strong><small><%= row.item_code %></small></td><td><%= fmt(row.qty) %> <%= row.unit %> × <%= fmt(row.unit_price) %></td><td><strong><%= fmt(row.total) %></strong></td><td><span class="pu-badge"><%= statusLabel(row.status) %></span></td><td><a class="pu-button outline" href="<%= base %>/po/<%= row.id %>">View PO →</a><% if(['ISSUED','SENT','PARTIAL'].includes(row.status)){ %><a href="<%= base %>/grn/new/<%= row.id %>">Receive Goods →</a><% } %></td></tr>
<% }else{ %><tr><td><strong><%= row.grn_no %></strong></td><td><%= row.po_no %><small><%= row.supplier_name %></small></td><td><%= row.item_name %><small><%= row.item_code %></small></td><td><%= fmt(row.received_qty) %> / <%= fmt(row.rejected_qty) %> <%= row.unit %></td><td><strong>+<%= fmt(row.accepted_qty) %> <%= row.unit %></strong></td><td><%= row.received_name %><small><%= row.created_at %></small></td><td><a class="pu-button outline" href="<%= base %>/grn/<%= row.id %>">View GRN →</a></td></tr><% }} %><% if(!rows.length){ %><tr><td colspan="7">မှတ်တမ်း မရှိသေးပါ။</td></tr><% } %></tbody></table><footer><span><%= total %> records · Page <%= pageNo %></span><nav><% if(pageNo>1){ %><a href="?<%= qs(pageNo-1) %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?<%= qs(pageNo+1) %>">Next →</a><% } %></nav></footer></div>
<% } %>
<% }else if(page==='new-pr'){ %><form class="pu-card pu-form" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= requestKey %>"><div class="pu-grid"><label>Material / Item Code<select name="material_id" required><option value="">Select Material</option><% for(const m of materials){ %><option value="<%= m.id %>"><%= m.code %> · <%= m.name %> · <%= m.unit %> · Stock <%= fmt(m.stock_qty) %></option><% } %></select></label><label>Requested Qty<input name="qty" type="number" min="0.001" max="999999999.999" step="0.001" required></label><label>Priority<select name="priority"><option>NORMAL</option><option>HIGH</option><option>URGENT</option></select></label><label>Needed By<input name="needed_by" type="date" min="<%= today %>"></label><label class="wide">Remark<textarea name="remark" maxlength="500" rows="2"></textarea></label></div><p class="pu-note">Source: <%= appScope==='packaging'?'Packaging Warehouse':'Main Warehouse' %> · ဝယ်ယူပစ္စည်းများကို GRN အတည်ပြုပြီးမှ Main Warehouse Raw Materials Stock ထဲသို့ လက်ခံပါမည်။</p><% if(!materials.length){ %><p>Inventory တွင် Raw Material အရင်ထည့်ပါ။</p><% if(appScope==='inventory'){ %><a href="<%= base %>/materials">Raw Materials →</a><% } %><% }else{ %><button>Submit Purchase Requisition</button><% } %></form>
<% }else if(page==='pr-detail'){ %><div class="po-action-bar"><a class="pu-button outline" href="<%= base %>/pr">← Back to PR List</a><span class="pu-badge"><%= statusLabel(r.status) %></span><a class="pu-button outline" href="<%= base %>/pr/<%= r.id %>/print?autoprint=1" target="_blank" rel="noopener">Print PR</a><a class="pu-button" href="<%= base %>/pr/<%= r.id %>/pdf">Download PDF</a></div><div class="po-preview-wrap"><%- include('pr-document',{r}) %></div><section class="pu-card"><% if(r.selection_reason){ %><p>Selection Reason: <%= r.selection_reason %></p><% } %><% if(r.rejection_reason){ %><p class="pu-warning"><%= ['FINANCE_RESUBMIT','MD_RESUBMIT'].includes(r.status)?'Resubmit Reason':'Rejected' %>: <%= r.rejection_reason %></p><% } %><% if(po&&appScope!=='packaging'){ %><a class="pu-button" href="<%= base %>/po/<%= po.id %>">View <%= po.po_no %> →</a><% }else if(buy&&['READY_RFQ','RFQ_IN_PROGRESS','FINANCE_RESUBMIT','MD_RESUBMIT'].includes(r.status)){ %><form class="pu-inline" method="post" action="<%= base %>/pr/<%= r.id %>/quotes"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Enter Quotes →</button></form><% } %><% if(buy&&(r.status==='PENDING_FINANCE'&&['admin','warehouse_accountant'].includes(user.role)||r.status==='FINANCE_CHECKED'&&user.role==='admin')){ %><a class="pu-button" href="<%= base %>/<%= r.status==='PENDING_FINANCE'?'finance':'comparison' %>?pr=<%= r.id %>">Review Quotes →</a><% } %><% if(buy&&r.status==='PENDING_APPROVAL'){ %><a class="pu-button" href="<%= base %>/po">Go to Purchase Order →</a><% } %><% if(buy&&!['READY_RFQ','RFQ_IN_PROGRESS','FINANCE_RESUBMIT','MD_RESUBMIT'].includes(r.status)){ %><form class="pu-inline" method="post" action="<%= base %>/pr/<%= r.id %>/quotes"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>View Quotes →</button></form><% } %><h3>History</h3><% for(const a of history){ %><div class="pu-history"><strong><%= a.action %></strong><span><%= a.actor_name %> · <%= a.created_at %></span><p><%= a.note %></p></div><% } %></section>
<% }else if(['rfq','comparison','finance'].includes(page)){ %><% if(r){ %><div class="pu-card pu-target"><strong><%= r.request_no %> — <%= r.item_name %></strong><span>Target: <%= fmt(r.qty) %> <%= r.unit %> · <%= r.priority %> · <%= statusLabel(r.status) %></span></div><% if(['FINANCE_RESUBMIT','MD_RESUBMIT'].includes(r.status)&&r.rejection_reason){ %><p class="pu-warning"><strong><%= statusLabel(r.status) %></strong> — <%= r.rejection_reason %></p><% } %><% if(page==='rfq'){ const editable=['READY_RFQ','RFQ_IN_PROGRESS','FINANCE_RESUBMIT','MD_RESUBMIT'].includes(r.status);const cards=[0,1,2].map(n=>quotes[n]||null); %>
<div class="pu-rfq-actions"><a href="<%= base %>/pr/<%= r.id %>">← Back to Purchase Requisition</a><span class="pu-note">Quote card ၃ ခုအနက် အနည်းဆုံး ၁ ခု ပြည့်စုံစွာ ဖြည့်ပါ။</span><% if(options.length&&editable){ %><form method="post" action="<%= base %>/pr/<%= r.id %>/submit-finance"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Proceed To Finance Check →</button></form><% }else{ %><span class="pu-button pu-disabled" aria-disabled="true"><%= editable?'Proceed To Finance Check →':'View Only — Quotes Locked' %></span><% } %></div>
<div class="pu-rfq-three"><% cards.forEach((q,index)=>{ %><form class="pu-card pu-vendor <%= q?.unit_price!=null?'':'pu-dashed' %>" method="post" action="<%= base %>/rfq/<%= r.id %>" data-quote-card data-target-qty="<%= r.qty %>" data-unit="<%= r.unit %>"><header><h2>Supplier Quote <%= index+1 %> <small><%= index===0?'':'(Optional)' %></small></h2><span class="pu-badge"><%= q?.unit_price!=null?'✓ Quote Logged':'Awaiting Quote' %></span></header><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="quote_id" value="<%= q?.id||'' %>"><fieldset <%= editable?'':'disabled' %>><label>Supplier<select name="supplier_id" required data-supplier-picker><option value="">Select Supplier</option><% for(const sup of suppliers.filter(sup=>!quotes.some(other=>String(other.supplier_id)===String(sup.id)&&String(other.id)!==String(q?.id)))){ %><option value="<%= sup.id %>" <%= String(q?.supplier_id)===String(sup.id)?'selected':'' %>><%= sup.name %></option><% } %></select></label><div class="pu-grid pu-quote-fields"><label class="pu-quote-price-field">Unit Price · MMK<input data-quote-price type="number" name="unit_price" min="0.0001" max="999999999.9999" step="0.0001" value="<%= q?.unit_price??'' %>" placeholder="Blank = awaiting quote"></label><label>MOQ · <%= r.unit %><input data-quote-moq type="number" name="moq" min="<%= r.unit==='pcs'?'1':'0.001' %>" max="999999999.999" step="<%= r.unit==='pcs'?'1':'0.001' %>" value="<%= q?.moq||'' %>" required></label><label>Lead Time<input type="number" name="lead_days" min="0" max="365" value="<%= q?.lead_days??'' %>" required></label></div><div class="pu-grid pu-financial-fields"><label>Discount Amount · MMK<input data-quote-discount type="number" name="discount_amount" min="0" max="999999999.9999" step="0.0001" value="<%= q?.discount_amount??'0' %>"></label><label>Tax · %<input data-quote-tax type="number" name="tax_percent" min="0" max="100" step="0.0001" value="<%= q?.tax_percent??'0' %>"></label></div><label>Payment Terms<input name="payment_terms" maxlength="500" value="<%= q?.payment_terms||'' %>" required></label><label>QC / Warranty &amp; Notes<textarea name="note" maxlength="500" rows="2"><%= q?.note||'' %></textarea></label><div class="pu-price pu-quote-estimate"><span data-quote-order>Est. Total (MOQ applied)</span><strong data-quote-total><% if(q?.unit_price!=null){const o=options.find(o=>String(o.id)===String(q.id)); %><%= o?fmt(o.total)+' MMK':'—' %><% }else{ %>Awaiting Quote<% } %></strong></div><% if(editable){ %><button><%= q?'✓ Update Supplier Quote':'＋ Save Supplier Quote' %></button><% } %></fieldset></form><% }); %></div><% if(quotes.length>3){ %><p class="pu-note">အရင်သိမ်းထားသော Quote <%= quotes.length-3 %> ခုကို Comparison မှာ ဆက်ကြည့်နိုင်ပါသည်။ အသစ်ထည့်ခြင်းကို ၃ ခုအထိသာ ခွင့်ပြုပါသည်။</p><% } %><p><a href="<%= base %>/suppliers">Manage Suppliers →</a></p>
<% }else{ %><p class="pu-note">Recommendation သည် Needed-by date၊ MOQ၊ Estimated Total နှင့် Lead Time အပေါ် အခြေခံပါသည်။ Business Days တွင် Mon–Fri သာတွက်ထားသည်။ Supplier rating history မရှိသေးပါ။ Currency: MMK.</p><div class="pu-vendors pu-comparison-three"><% for(const q of [...options,...Array(Math.max(0,3-options.length)).fill(null)]){if(!q){ %><article class="pu-card pu-vendor pu-empty-quote" aria-label="No Data"><header><strong>Vendor Quote Option</strong></header><div><h2>No Data</h2><p>Supplier Quote မထည့်ရသေးပါ။</p></div></article><% continue;} %><article class="pu-card pu-vendor <%= q.recommended?'recommended':'' %>"><header><strong><%= q.recommended?'★ Recommended Best Value':'Vendor Quote Option' %></strong><% if(String(r.selected_quote_id)===String(q.id)){ %><span class="pu-badge">Selected</span><% } %></header><h2><%= q.supplier_name %></h2><div class="pu-price"><div>Unit Price<strong><%= fmt(q.unit_price) %> MMK</strong></div><div>Est. Total<strong><%= fmt(q.total) %> MMK</strong></div></div><dl><div><dt>Order Qty</dt><dd><%= fmt(q.order_qty) %> <%= r.unit %></dd></div><div><dt>MOQ</dt><dd class="<%= q.exceeds?'pu-red':'' %>"><%= fmt(q.moq) %> <%= r.unit %> <%= q.exceeds?'(Exceeds Target)':'' %></dd></div><div><dt>Lead Time</dt><dd><%= q.lead_days %> business days</dd></div><div><dt>Estimated Delivery</dt><dd><%= q.delivery %></dd></div><div><dt>Subtotal</dt><dd><%= fmt(q.subtotal) %> MMK</dd></div><div><dt>Discount</dt><dd><%= fmt(q.discount_amount) %> MMK</dd></div><div><dt>Tax (<%= fmt(q.tax_percent) %>%)</dt><dd><%= fmt(q.tax_amount) %> MMK</dd></div><div><dt>Payment</dt><dd><%= q.payment_terms %></dd></div></dl><p class="<%= q.late?'pu-warning':'pu-note' %>"><%= q.reason %></p><% if(page==='comparison'&&['FINANCE_CHECKED','PENDING_APPROVAL'].includes(r.status)&&user.role==='admin'){ %><% if(r.status==='PENDING_APPROVAL'&&String(r.selected_quote_id)===String(q.id)){ %><a class="pu-button" href="<%= base %>/po">Go to Purchase Order →</a><% }else{ %><form method="post" action="<%= base %>/comparison/<%= r.id %>/select"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="quote_id" value="<%= q.id %>"><label>Selection Reason<textarea name="reason" maxlength="500" required></textarea></label><button>Select Vendor →</button></form><% } %><% } %></article><% } %></div><% if(page==='finance'){ %><section class="pu-card"><% if(['READY_RFQ','RFQ_IN_PROGRESS','FINANCE_RESUBMIT','MD_RESUBMIT','PENDING_APPROVAL'].includes(r.status)){ %><form method="post" action="<%= base %>/pr/<%= r.id %>/submit-finance"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Submit to Finance for Review</button></form><% }else if(r.status==='PENDING_FINANCE'&&['admin','warehouse_accountant'].includes(user.role)){ %><form method="post" data-review-form action="<%= base %>/finance/<%= r.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(reviewError){ %><p role="alert" class="pu-warning"><%= reviewError %></p><% } %><label>Finance Review / Reason<textarea name="reason" maxlength="500" required placeholder="Required for resubmit or reject"><%= reasonValue %></textarea></label><div class="pu-actions"><button name="action" value="submit" formnovalidate>Submit to MD/CEO to Approve</button><button name="action" value="resubmit">Request Purchaser to Resubmit</button><button class="pu-reject" name="action" value="reject">Reject</button></div><p class="pu-note">Reject သည် PR ကို အပြီးပယ်ချပါမည်။</p></form><% }else{ %><p class="pu-note"><%= statusLabel(r.status) %><%= r.status==='PENDING_FINANCE'?' — Finance review permission required.':'' %></p><% } %></section><% } %><% if(page==='comparison'&&user.role==='admin'&&['FINANCE_CHECKED','PENDING_APPROVAL'].includes(r.status)){ %><section class="pu-card"><p class="pu-note">Select Vendor လုပ်ပြီးလျှင် Purchase Order အဆင့်သို့ ဆက်သွားပါမည်။</p><form method="post" action="<%= base %>/pr/<%= r.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(reviewError){ %><p role="alert" class="pu-warning"><%= reviewError %></p><% } %><label>MD/CEO Review / Reason<textarea name="reason" maxlength="500" required><%= reasonValue %></textarea></label><div class="pu-actions"><button name="action" value="resubmit">Request Purchaser to Resubmit</button><button class="pu-reject" name="action" value="reject">Reject</button></div><p class="pu-note">Reject သည် PR ကို အပြီးပယ်ချပါမည်။</p></form></section><% } %><% if(!options.length){ %><p class="pu-card">ဈေးနှုန်းပါသော Quote မရှိသေးပါ။</p><% } %><% }}else{ %><p class="pu-card">Purchase Requisition တင်ပြီးမှ Quote ထည့်နိုင်ပါသည်။</p><% } %>
<% }else if(['po-detail','pr-detail'].includes(page)){ %><div class="po-action-bar"><% if(buy){ %><a class="pu-button" href="<%= base %>/settled/<%= po.id %>">Payments / Settlement →</a><% } %><a class="pu-button outline" href="<%= base %>/po">← Back to PO List</a><span class="pu-badge"><%= statusLabel(po.status) %></span><a class="pu-button outline" href="<%= base %>/po/<%= po.id %>/print?autoprint=1" target="_blank" rel="noopener">Print PO</a><a class="pu-button" href="<%= base %>/po/<%= po.id %>/pdf">Download PDF</a><% if(['ISSUED','SENT','PARTIAL'].includes(po.status)){ %><a class="pu-button" href="<%= base %>/grn/new/<%= po.id %>">Receive Goods (GRN) →</a><% } %></div><div class="po-preview-wrap"><%- include('po-document',{po}) %></div><section class="pu-card"><h2>Receipt History</h2><p>Ordered: <%= fmt(po.qty) %> <%= po.unit %> · Accepted: <%= fmt(po.accepted_qty) %> · Remaining: <%= fmt(Number(po.qty)-Number(po.accepted_qty)) %></p><% for(const receipt of receipts){ %><article class="pu-history"><a href="<%= base %>/grn/<%= receipt.id %>"><strong><%= receipt.grn_no %></strong></a><span><%= receipt.received_name %> · <%= receipt.created_at %></span><p>Received: <%= fmt(receipt.received_qty) %> · Rejected: <%= fmt(receipt.rejected_qty) %> · Accepted: <%= fmt(receipt.accepted_qty) %> <%= po.unit %></p></article><% } %><% if(!receipts.length){ %><p class="muted">လက်ခံပြီး မှတ်တမ်းမရှိသေးပါ။</p><% } %></section>
<% }else if(page==='new-grn'){ %><form class="pu-card" method="post" data-grn-form><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= requestKey %>"><div class="pu-heading"><h2>Goods Received Note · <%= po.po_no %></h2><span class="pu-badge">Destination: Main Warehouse</span></div><p>Vendor: <strong><%= po.supplier_name %></strong> · PR: <%= po.request_no %></p><h3><%= po.item_name %> · <%= po.item_code %></h3><div class="pu-grid"><p>Ordered Qty<strong><%= fmt(po.qty) %> <%= po.unit %></strong></p><p>Remaining Qty<strong><%= fmt(Number(po.qty)-Number(po.accepted_qty)) %> <%= po.unit %></strong></p><label>Actual Received Qty<input data-grn-received type="number" name="received_qty" min="<%= po.unit==='pcs'?'1':'0.001' %>" max="<%= Number(po.qty)-Number(po.accepted_qty) %>" step="<%= po.unit==='pcs'?'1':'0.001' %>" required></label><label>Damaged / Reject Qty<input data-grn-rejected type="number" name="rejected_qty" min="0" step="<%= po.unit==='pcs'?'1':'0.001' %>" value="0" required></label></div><p class="pu-price">QC Passed / Accepted (Stock In): <strong data-grn-accepted>0 <%= po.unit %></strong></p><label>Receiving Remark / Reject Reason<textarea name="note" maxlength="500" rows="2"></textarea></label><p class="pu-note">Accepted Qty သာ Stock In ဖြစ်မည်။ Reject Qty ကို ကျန်ပစ္စည်းအဖြစ် ဆက်လက်လက်ခံနိုင်ပါသည်။ Confirm ပြီးသော GRN ကို ပြန်ပြင်မရပါ။</p><button <%= ['ISSUED','SENT','PARTIAL'].includes(po.status)?'':'disabled' %>>Confirm GRN & Update Main Warehouse Stock</button></form>
<% }else if(page==='grn-detail'){ %><section class="pu-card"><div class="pu-heading"><h2><%= grn.grn_no %></h2><span class="pu-badge">Confirmed</span></div><p><%= grn.po_no %> · <%= grn.request_no %> · <%= grn.supplier_name %></p><h3><%= grn.item_name %> · <%= grn.item_code %></h3><div class="pu-grid"><p>Received<strong><%= fmt(grn.received_qty) %> <%= grn.unit %></strong></p><p>Rejected<strong><%= fmt(grn.rejected_qty) %> <%= grn.unit %></strong></p><p>Accepted / Stock In<strong>+<%= fmt(grn.accepted_qty) %> <%= grn.unit %></strong></p><p>Received By<strong><%= grn.received_name %> · <%= grn.created_at %></strong></p></div><p class="pu-preserve"><%= grn.note||'—' %></p><a class="pu-button outline" href="<%= base %>/grn?tab=history">← Received History</a><% if(appScope==='inventory'){ %><a class="pu-button outline" href="<%= base %>/materials">Raw Materials Stock Balance →</a><% } %></section>
<% }else if(page==='materials'){ %><div class="pu-table"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Category</th><th>Unit</th><th>Opening</th><th>Closing</th><th>Reorder</th><th>Action</th></tr></thead><tbody><% for(const m of materials){ %><tr><td><%= m.code %></td><td><%= m.name %></td><td><span class="pu-badge"><%= m.category %></span></td><td><%= m.unit %></td><td><%= fmt(m.opening_qty) %> 🔒</td><td><strong><%= fmt(m.stock_qty) %></strong></td><td><%= fmt(m.reorder_qty) %></td><td><a href="<%= base %>/materials/<%= m.id %>/ledger">View Ledger →</a></td></tr><% } %></tbody></table></div><% if(appScope==='inventory'){ %><details class="pu-card"><summary>＋ Add Raw Material</summary><form method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="pu-grid"><label>Item Code<input name="code" maxlength="100" required></label><label>Item Name<input name="name" maxlength="255" required></label><label>Category<input name="category" maxlength="100" required></label><label>Unit<select name="unit"><option>pcs</option><option>g</option></select></label><label>One-Time Opening Qty<input type="number" name="opening" min="0" max="999999999.999" step="0.001" value="0" required></label><label>Reorder Qty<input type="number" name="reorder" min="0" max="999999999.999" step="0.001" value="0" required></label></div><button>Save Material & Opening</button></form></details><% } %>
<% }else if(page==='material-ledger'){ %><section class="pu-card"><h2><%= material.code %> · <%= material.name %></h2><p>Main Warehouse · Closing: <strong><%= fmt(material.stock_qty) %> <%= material.unit %></strong></p><% for(const l of rows){ %><article class="pu-history"><header><strong><%= l.type %> · <%= l.reference %></strong><small><%= l.created_at %> · <%= l.actor_name %></small></header><p><%= l.note %></p><p>Movement: +<%= fmt(l.qty) %> <%= material.unit %> · Running Balance: <strong><%= fmt(l.balance_after) %> <%= material.unit %></strong></p></article><% } %></section>
<% }else if(page==='suppliers'){ %><%- include('suppliers',{fmt}) %><% } %>
<footer class="inventory-footer"><span>INNOCREATION · PURCHASING</span><span>Main Warehouse · MMK</span></footer></main></div></body></html>
