<% const menus=[['pr','Purchase Requisition'],['rfq','RFQ & Quote Entry'],['comparison','Quote Comparison'],['po','Purchase Order (PO)'],['grn','Goods Receipt (GRN)']],fmt=v=>{if(v==null)return '—';const [a,b='']=String(v).split('.'),tail=b.replace(/0+$/,'');return a.replace(/\B(?=(\d{3})+(?!\d))/g,',')+(tail?'.'+tail:'');},active=page.startsWith('pr')||page==='new-pr'?'pr':page.startsWith('po')?'po':page.includes('grn')?'grn':page;const qs=n=>new URLSearchParams({...typeof f!=='undefined'?f:{},p:String(n)}).toString(); %>
<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Purchasing | INNOCREATION</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/workspace.css"><link rel="stylesheet" href="/inventory-navigation.css?v=3"><link rel="stylesheet" href="/purchasing.css?v=4"><script src="/purchasing.js?v=3" defer></script><% if(page==='po-detail'){ %><link rel="stylesheet" href="/purchase-order-form.css?v=1"><% } %></head><body class="app-home purchase-app"><header class="app-header"><a class="app-logo" href="/dashboard">INNOCREATION <span>/ ERP</span></a><div class="account-area"><a class="back-link" href="/dashboard">← Main Dashboard</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="logout">Logout</button></form></div></header><div class="inventory-shell"><aside class="inventory-sidebar"><p class="eyebrow"><%= buy?'PURCHASING':appScope.toUpperCase() %></p><nav><details class="nav-group" open><summary><span class="inventory-menu-label"><span class="inventory-menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 3h3l3 13h11l3-10H6M9 10h10"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg></span><span><%= buy?'Procurement (5-Step)':'Purchase Requests' %></span></span><svg class="nav-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 7 5 5 5-5"/></svg></summary><div class="nav-submenus"><% for(const [id,name] of menus){if(!buy&&!['pr','po','grn'].includes(id)||appScope==='packaging'&&id!=='pr')continue; %><% if(id==='rfq'){ %><span class="pu-nav-disabled <%= active===id?'active':'' %>" aria-disabled="true" title="Enter Vendor Quotes ကို PR မှ ရွေးပါ။">2. RFQ &amp; Quote Entry</span><% }else{ %><a class="<%= active===id?'active':'' %>" href="<%= base+'/'+id %>"><%= buy?(menus.findIndex(m=>m[0]===id)+1)+'. ':'' %><%= name %><% if(['pr','po','grn'].includes(id)){ %> <b class="pu-nav-count"><%= (id==='pr'?counts.active_pr:id==='po'?counts.open_po:counts.pending_grn)||0 %></b><% } %></a><% } %><% } %></div></details><% if(buy){ %><a class="pu-nav <%= page==='suppliers'?'active':'' %>" href="<%= base %>/suppliers">Suppliers</a><% } %><% if(appScope==='inventory'){ %><a class="pu-nav <%= page==='materials'?'active':'' %>" href="<%= base %>/materials">Raw Materials / Stock Balance</a><% } %><% if(!buy){ %><a class="pu-nav" href="/<%= appScope %>">← <%= appScope==='inventory'?'Inventory':'Packaging' %></a><% } %></nav></aside><main class="inventory-main"><nav class="breadcrumbs"><a href="/dashboard">Home</a><span>/</span><span><%= buy?'Purchasing':'Warehouse Purchase Requests' %></span><span>/</span><span><%= menus.find(m=>m[0]===active)?.[1]||page %></span></nav><div class="pu-heading"><div><h1><%= page==='new-pr'?'New Purchase Requisition':page==='suppliers'?'Suppliers':page==='materials'?'Raw Materials — Main Warehouse Stock Balance':page==='material-ledger'?'Material Movement Ledger':menus.find(m=>m[0]===active)?.[1]||'Purchasing' %></h1><p class="muted"><%= buy?'ဝယ်ယူတောင်းခံမှု၊ Supplier Quote၊ PO နှင့် ပစ္စည်းလက်ခံမှု စီမံရန်။':'Warehouse မှ ဝယ်ယူတောင်းခံခြင်းနှင့် ပစ္စည်းလက်ခံခြင်း။' %></p></div><% if(page==='pr'){ %><a class="pu-button" href="<%= base %>/pr/new">＋ New Purchase Requisition</a><% } %></div>
<% if(buy&&!['suppliers','materials','material-ledger'].includes(page)){ %><div class="pu-steps"><% for(const [id,name] of menus){ %><% if(id==='rfq'){ %><div class="pu-step-disabled <%= active===id?'active':'' %>" aria-disabled="true" title="Enter Vendor Quotes ကို PR မှ ရွေးပါ။"><% }else{ %><a class="<%= active===id?'active':'' %>" href="<%= base+'/'+id %>"><% } %><b><%= menus.findIndex(m=>m[0]===id)+1 %></b><span><strong><%= name %></strong><small><%= id==='pr'?(counts.active_pr||0)+' active PRs':id==='rfq'?'Log Vendor Quotes':id==='comparison'?'Side-by-Side Comparison':id==='po'?(counts.open_po||0)+' open POs':(counts.pending_grn||0)+' pending receipts' %></small></span><% if(id==='rfq'){ %></div><% }else{ %></a><% } %><% } %></div><% } %>
<% if(['pr','po','grn'].includes(page)){ %>
<% if(page==='grn'){ %><div class="pu-tabs"><a class="<%= receiptTab==='pending'?'active':'' %>" href="<%= base %>/grn">Pending Receipts (<%= pendingOrders.length %>)</a><a class="<%= receiptTab==='history'?'active':'' %>" href="<%= base %>/grn?tab=history">Received History</a></div><% } %>
<% if(page==='grn'&&receiptTab==='pending'){ %><div class="pu-table"><table><thead><tr><th>PO / Supplier</th><th>Material</th><th>Ordered</th><th>Accepted</th><th>Remaining</th><th>Action</th></tr></thead><tbody><% for(const p of pendingOrders){ %><tr><td><strong><%= p.po_no %></strong><small><%= p.supplier_name %></small></td><td><%= p.item_name %><small><%= p.item_code %></small></td><td><%= fmt(p.qty) %> <%= p.unit %></td><td><%= fmt(p.accepted_qty) %></td><td><%= fmt(Number(p.qty)-Number(p.accepted_qty)) %> <%= p.unit %></td><td><a class="pu-button" href="<%= base %>/grn/new/<%= p.id %>">Receive Goods (GRN) →</a></td></tr><% } %><% if(!pendingOrders.length){ %><tr><td colspan="6">လက်ခံရန် PO မရှိသေးပါ။</td></tr><% } %></tbody></table></div><% }else{ %>
<% if(page==='pr'){ %><div class="pu-tabs"><% for(const [s,t] of [['','All Requisitions'],['READY_RFQ','Ready for RFQ'],['RFQ_IN_PROGRESS','RFQ In Progress'],['PENDING_APPROVAL','Pending Approval'],['CONVERTED_PO','Converted to PO']]){ %><a class="<%= f.status===s?'active':'' %>" href="?<%= new URLSearchParams({...f,status:s,p:'1'}) %>"><%= t %></a><% } %></div><% } %>
<form class="pu-search" method="get"><div><input name="q" value="<%= f.q %>" placeholder="Search number / item / supplier…" aria-label="Search"><button>Search</button><details><summary aria-label="Search filters">▾</summary><section><% if(page!=='grn'){ %><label>Status<select name="status"><option value="">All Statuses</option><% for(const s of page==='pr'?['READY_RFQ','RFQ_IN_PROGRESS','PENDING_APPROVAL','CONVERTED_PO']:['ISSUED','SENT','PARTIAL','COMPLETED']){ %><option value="<%= s %>" <%= f.status===s?'selected':'' %>><%= statusLabel(s) %></option><% } %></select></label><% } %><label>From Date<input type="date" name="from" value="<%= f.from %>"></label><label>To Date<input type="date" name="to" value="<%= f.to %>"></label><button>Apply Filters</button></section></details></div><a class="pu-button outline" href="<%= base+'/'+page %>/export.xlsx?<%= new URLSearchParams(f) %>">↓ Download Excel</a><a href="<%= base+'/'+page %>">Reset</a></form>
<div class="pu-table"><table><thead><tr><% for(const title of page==='pr'?['PR Number & Date','Material & Item Code','Stock / Reorder','Requested Qty','Priority','Status','Action']:page==='po'?['PO Number','Supplier','Material','Qty × Unit Price','Total (MMK)','Status','Action']:['GRN Number','PO / Supplier','Material','Received / Rejected','Accepted','Received By & Time','Action']){ %><th><%= title %></th><% } %></tr></thead><tbody><% for(const row of rows){if(page==='pr'){ %><tr><td><a href="<%= base %>/pr/<%= row.id %>"><strong><%= row.request_no %></strong></a><small><%= row.created_at %> · <%= row.warehouse %></small><small><%= row.created_name %></small></td><td><strong><%= row.item_name %></strong><small><%= row.item_code %></small></td><td><strong><%= fmt(row.current_stock) %> <%= row.unit %></strong><small>Reorder: <%= fmt(row.current_reorder) %></small><small>Main Warehouse · live</small></td><td><strong><%= fmt(row.qty) %> <%= row.unit %></strong></td><td><span class="pu-badge <%= row.priority==='URGENT'?'urgent':'' %>"><%= row.priority %></span></td><td><span class="pu-badge"><%= statusLabel(row.status) %></span></td><td><% if(buy&&['READY_RFQ','RFQ_IN_PROGRESS'].includes(row.status)){ %><form method="post" action="<%= base %>/pr/<%= row.id %>/quotes"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Enter Vendor Quotes →</button></form><% if(Number(row.quote_count)>0){ %><a class="pu-button outline pu-compare-shortcut" href="<%= base %>/comparison?pr=<%= row.id %>">Proceed to Side-by-Side Comparison →</a><% } %><% }else{ %><a class="pu-button outline" href="<%= base %>/pr/<%= row.id %>">View PR →</a><% } %></td></tr>
<% }else if(page==='po'){ %><tr><td><strong><%= row.po_no %></strong><small>PR: <%= row.request_no %></small></td><td><%= row.supplier_name %></td><td><strong><%= row.item_name %></strong><small><%= row.item_code %></small></td><td><%= fmt(row.qty) %> <%= row.unit %> × <%= fmt(row.unit_price) %></td><td><strong><%= fmt(row.total) %></strong></td><td><span class="pu-badge"><%= statusLabel(row.status) %></span></td><td><a class="pu-button outline" href="<%= base %>/po/<%= row.id %>">View PO →</a><% if(['ISSUED','SENT','PARTIAL'].includes(row.status)){ %><a href="<%= base %>/grn/new/<%= row.id %>">Receive Goods →</a><% } %></td></tr>
<% }else{ %><tr><td><strong><%= row.grn_no %></strong></td><td><%= row.po_no %><small><%= row.supplier_name %></small></td><td><%= row.item_name %><small><%= row.item_code %></small></td><td><%= fmt(row.received_qty) %> / <%= fmt(row.rejected_qty) %> <%= row.unit %></td><td><strong>+<%= fmt(row.accepted_qty) %> <%= row.unit %></strong></td><td><%= row.received_name %><small><%= row.created_at %></small></td><td><a class="pu-button outline" href="<%= base %>/grn/<%= row.id %>">View GRN →</a></td></tr><% }} %><% if(!rows.length){ %><tr><td colspan="7">မှတ်တမ်း မရှိသေးပါ။</td></tr><% } %></tbody></table><footer><span><%= total %> records · Page <%= pageNo %></span><nav><% if(pageNo>1){ %><a href="?<%= qs(pageNo-1) %>">← Previous</a><% } %><% if(pageNo*50<total){ %><a href="?<%= qs(pageNo+1) %>">Next →</a><% } %></nav></footer></div>
<% } %>
<% }else if(page==='new-pr'){ %><form class="pu-card pu-form" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= requestKey %>"><div class="pu-grid"><label>Material / Item Code<select name="material_id" required><option value="">Select Material</option><% for(const m of materials){ %><option value="<%= m.id %>"><%= m.code %> · <%= m.name %> · <%= m.unit %> · Stock <%= fmt(m.stock_qty) %></option><% } %></select></label><label>Requested Qty<input name="qty" type="number" min="0.001" max="999999999.999" step="0.001" required></label><label>Priority<select name="priority"><option>NORMAL</option><option>HIGH</option><option>URGENT</option></select></label><label>Needed By<input name="needed_by" type="date" min="<%= today %>"></label><label class="wide">Remark<textarea name="remark" maxlength="500" rows="2"></textarea></label></div><p class="pu-note">Source: <%= appScope==='packaging'?'Packaging Warehouse':'Main Warehouse' %> · ဝယ်ယူပစ္စည်းများကို GRN အတည်ပြုပြီးမှ Main Warehouse Raw Materials Stock ထဲသို့ လက်ခံပါမည်။</p><% if(!materials.length){ %><p>Inventory တွင် Raw Material အရင်ထည့်ပါ။</p><% if(appScope==='inventory'){ %><a href="<%= base %>/materials">Raw Materials →</a><% } %><% }else{ %><button>Submit Purchase Requisition</button><% } %></form>
<% }else if(page==='pr-detail'){ %><section class="pu-card"><div class="pu-heading"><h2><%= r.request_no %></h2><span class="pu-badge"><%= statusLabel(r.status) %></span></div><h3><%= r.item_name %> · <%= r.item_code %></h3><div class="pu-grid"><p>Requested Qty<strong><%= fmt(r.qty) %> <%= r.unit %></strong></p><p>From<strong><%= r.warehouse %></strong></p><p>Priority<strong><%= r.priority %></strong></p><p>Needed By<strong><%= r.needed_by||'—' %></strong></p></div><p class="pu-preserve"><%= r.remark %></p><% if(r.selection_reason){ %><p>Selection Reason: <%= r.selection_reason %></p><% } %><% if(r.rejection_reason){ %><p class="pu-warning">Rejected: <%= r.rejection_reason %></p><% } %><% if(po&&appScope!=='packaging'){ %><a class="pu-button" href="<%= base %>/po/<%= po.id %>">View <%= po.po_no %> →</a><% }else if(buy&&['READY_RFQ','RFQ_IN_PROGRESS'].includes(r.status)){ %><form class="pu-inline" method="post" action="<%= base %>/pr/<%= r.id %>/quotes"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Enter Vendor Quotes →</button></form><% } %><% if(buy&&r.status==='PENDING_APPROVAL'){ %><a class="pu-button outline" href="<%= base %>/comparison?pr=<%= r.id %>">Review Selected Quote →</a><% if(user.role==='admin'){ %><form class="pu-inline" method="post" action="<%= base %>/pr/<%= r.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><button name="action" value="approve">Approve & Create PO</button></form><form class="pu-inline" method="post" action="<%= base %>/pr/<%= r.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="reason" maxlength="500" placeholder="Reject reason" required><button name="action" value="reject">Reject</button></form><% }else{ %><p class="pu-note">Admin approval စောင့်နေပါသည်။</p><% }} %><h3>History</h3><% for(const a of history){ %><div class="pu-history"><strong><%= a.action %></strong><span><%= a.actor_name %> · <%= a.created_at %></span><p><%= a.note %></p></div><% } %></section>
<% }else if(['rfq','comparison'].includes(page)){ %><% if(r){ %><div class="pu-card pu-target"><strong><%= r.request_no %> — <%= r.item_name %></strong><span>Target: <%= fmt(r.qty) %> <%= r.unit %> · <%= r.priority %> · <%= statusLabel(r.status) %></span></div><% if(page==='rfq'){ const editable=['READY_RFQ','RFQ_IN_PROGRESS'].includes(r.status);const cards=[0,1,2].map(n=>quotes[n]||null); %>
<div class="pu-rfq-actions"><a href="<%= base %>/pr/<%= r.id %>">← Back to Purchase Requisition</a><span class="pu-note">Quote card ၃ ခုအနက် အနည်းဆုံး ၁ ခု ပြည့်စုံစွာ ဖြည့်ပါ။</span><% if(options.length){ %><a class="pu-button" href="<%= base %>/comparison?pr=<%= r.id %>">Proceed to Side-by-Side Comparison →</a><% }else{ %><span class="pu-button pu-disabled" aria-disabled="true">Proceed to Side-by-Side Comparison →</span><% } %></div>
<div class="pu-rfq-three"><% cards.forEach((q,index)=>{ %><form class="pu-card pu-vendor <%= q?.unit_price!=null?'':'pu-dashed' %>" method="post" action="<%= base %>/rfq/<%= r.id %>" data-quote-card data-target-qty="<%= r.qty %>" data-unit="<%= r.unit %>"><header><h2>Supplier Quote <%= index+1 %> <small><%= index===0?'':'(Optional)' %></small></h2><span class="pu-badge"><%= q?.unit_price!=null?'✓ Quote Logged':'Awaiting Quote' %></span></header><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="quote_id" value="<%= q?.id||'' %>"><fieldset <%= editable?'':'disabled' %>><label>Supplier<select name="supplier_id" required data-supplier-picker><option value="">Select Supplier</option><% for(const sup of suppliers.filter(sup=>!quotes.some(other=>String(other.supplier_id)===String(sup.id)&&String(other.id)!==String(q?.id)))){ %><option value="<%= sup.id %>" <%= String(q?.supplier_id)===String(sup.id)?'selected':'' %>><%= sup.name %></option><% } %></select></label><div class="pu-grid pu-quote-fields"><label class="pu-quote-price-field">Unit Price · MMK<input data-quote-price type="number" name="unit_price" min="0.0001" max="999999999.9999" step="0.0001" value="<%= q?.unit_price??'' %>" placeholder="Blank = awaiting quote"></label><label>MOQ · <%= r.unit %><input data-quote-moq type="number" name="moq" min="<%= r.unit==='pcs'?'1':'0.001' %>" max="999999999.999" step="<%= r.unit==='pcs'?'1':'0.001' %>" value="<%= q?.moq||'' %>" required></label><label>Lead Time<input type="number" name="lead_days" min="0" max="365" value="<%= q?.lead_days??'' %>" required></label></div><label>Payment Terms<input name="payment_terms" maxlength="500" value="<%= q?.payment_terms||'' %>" required></label><label>QC / Warranty &amp; Notes<textarea name="note" maxlength="500" rows="2"><%= q?.note||'' %></textarea></label><div class="pu-price pu-quote-estimate"><span data-quote-order>Est. Total (MOQ applied)</span><strong data-quote-total><% if(q?.unit_price!=null){const o=options.find(o=>String(o.id)===String(q.id)); %><%= o?fmt(o.total)+' MMK':'—' %><% }else{ %>Awaiting Quote<% } %></strong></div><button><%= q?'✓ Update Supplier Quote':'＋ Save Supplier Quote' %></button></fieldset></form><% }); %></div><% if(quotes.length>3){ %><p class="pu-note">အရင်သိမ်းထားသော Quote <%= quotes.length-3 %> ခုကို Comparison မှာ ဆက်ကြည့်နိုင်ပါသည်။ အသစ်ထည့်ခြင်းကို ၃ ခုအထိသာ ခွင့်ပြုပါသည်။</p><% } %><p><a href="<%= base %>/suppliers">Manage Suppliers →</a></p>
<% }else{ %><p class="pu-note">Recommendation သည် Needed-by date၊ MOQ၊ Estimated Total နှင့် Lead Time အပေါ် အခြေခံပါသည်။ Business Days တွင် Mon–Fri သာတွက်ထားသည်။ Supplier rating history မရှိသေးပါ။ Currency: MMK.</p><div class="pu-vendors pu-comparison-three"><% for(const q of [...options,...Array(Math.max(0,3-options.length)).fill(null)]){if(!q){ %><article class="pu-card pu-vendor pu-empty-quote" aria-label="No Data"><header><strong>Vendor Quote Option</strong></header><div><h2>No Data</h2><p>Supplier Quote မထည့်ရသေးပါ။</p></div></article><% continue;} %><article class="pu-card pu-vendor <%= q.recommended?'recommended':'' %>"><header><strong><%= q.recommended?'★ Recommended Best Value':'Vendor Quote Option' %></strong><% if(String(r.selected_quote_id)===String(q.id)){ %><span class="pu-badge">Selected</span><% } %></header><h2><%= q.supplier_name %></h2><div class="pu-price"><div>Unit Price<strong><%= fmt(q.unit_price) %> MMK</strong></div><div>Est. Total<strong><%= fmt(q.total) %> MMK</strong></div></div><dl><div><dt>Order Qty</dt><dd><%= fmt(q.order_qty) %> <%= r.unit %></dd></div><div><dt>MOQ</dt><dd class="<%= q.exceeds?'pu-red':'' %>"><%= fmt(q.moq) %> <%= r.unit %> <%= q.exceeds?'(Exceeds Target)':'' %></dd></div><div><dt>Lead Time</dt><dd><%= q.lead_days %> business days</dd></div><div><dt>Estimated Delivery</dt><dd><%= q.delivery %></dd></div><div><dt>Payment</dt><dd><%= q.payment_terms %></dd></div></dl><p class="<%= q.late?'pu-warning':'pu-note' %>"><%= q.reason %></p><% if(['READY_RFQ','RFQ_IN_PROGRESS'].includes(r.status)){ %><form method="post" action="<%= base %>/comparison/<%= r.id %>/select"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="quote_id" value="<%= q.id %>"><label>Selection Reason<textarea name="reason" maxlength="500" required></textarea></label><button>Select Winner & Request Approval →</button></form><% } %></article><% } %></div><% if(!options.length){ %><p class="pu-card">ဈေးနှုန်းပါသော Quote မရှိသေးပါ။</p><% } %><% }}else{ %><p class="pu-card">Purchase Requisition တင်ပြီးမှ Quote ထည့်နိုင်ပါသည်။</p><% } %>
<% }else if(page==='po-detail'){ %><div class="po-action-bar"><a class="pu-button outline" href="<%= base %>/po">← Back to PO List</a><span class="pu-badge"><%= statusLabel(po.status) %></span><a class="pu-button outline" href="<%= base %>/po/<%= po.id %>/print?autoprint=1" target="_blank" rel="noopener">Print PO</a><a class="pu-button" href="<%= base %>/po/<%= po.id %>/pdf">Download PDF</a><% if(['ISSUED','SENT','PARTIAL'].includes(po.status)){ %><a class="pu-button" href="<%= base %>/grn/new/<%= po.id %>">Receive Goods (GRN) →</a><% } %></div><div class="po-preview-wrap"><%- include('po-document',{po}) %></div><section class="pu-card"><h2>Receipt History</h2><p>Ordered: <%= fmt(po.qty) %> <%= po.unit %> · Accepted: <%= fmt(po.accepted_qty) %> · Remaining: <%= fmt(Number(po.qty)-Number(po.accepted_qty)) %></p><% for(const receipt of receipts){ %><article class="pu-history"><a href="<%= base %>/grn/<%= receipt.id %>"><strong><%= receipt.grn_no %></strong></a><span><%= receipt.received_name %> · <%= receipt.created_at %></span><p>Received: <%= fmt(receipt.received_qty) %> · Rejected: <%= fmt(receipt.rejected_qty) %> · Accepted: <%= fmt(receipt.accepted_qty) %> <%= po.unit %></p></article><% } %><% if(!receipts.length){ %><p class="muted">လက်ခံပြီး မှတ်တမ်းမရှိသေးပါ။</p><% } %></section>
<% }else if(page==='new-grn'){ %><form class="pu-card" method="post" data-grn-form><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= requestKey %>"><div class="pu-heading"><h2>Goods Received Note · <%= po.po_no %></h2><span class="pu-badge">Destination: Main Warehouse</span></div><p>Vendor: <strong><%= po.supplier_name %></strong> · PR: <%= po.request_no %></p><h3><%= po.item_name %> · <%= po.item_code %></h3><div class="pu-grid"><p>Ordered Qty<strong><%= fmt(po.qty) %> <%= po.unit %></strong></p><p>Remaining Qty<strong><%= fmt(Number(po.qty)-Number(po.accepted_qty)) %> <%= po.unit %></strong></p><label>Actual Received Qty<input data-grn-received type="number" name="received_qty" min="<%= po.unit==='pcs'?'1':'0.001' %>" max="<%= Number(po.qty)-Number(po.accepted_qty) %>" step="<%= po.unit==='pcs'?'1':'0.001' %>" required></label><label>Damaged / Reject Qty<input data-grn-rejected type="number" name="rejected_qty" min="0" step="<%= po.unit==='pcs'?'1':'0.001' %>" value="0" required></label></div><p class="pu-price">QC Passed / Accepted (Stock In): <strong data-grn-accepted>0 <%= po.unit %></strong></p><label>Receiving Remark / Reject Reason<textarea name="note" maxlength="500" rows="2"></textarea></label><p class="pu-note">Accepted Qty သာ Stock In ဖြစ်မည်။ Reject Qty ကို ကျန်ပစ္စည်းအဖြစ် ဆက်လက်လက်ခံနိုင်ပါသည်။ Confirm ပြီးသော GRN ကို ပြန်ပြင်မရပါ။</p><button <%= ['ISSUED','SENT','PARTIAL'].includes(po.status)?'':'disabled' %>>Confirm GRN & Update Main Warehouse Stock</button></form>
<% }else if(page==='grn-detail'){ %><section class="pu-card"><div class="pu-heading"><h2><%= grn.grn_no %></h2><span class="pu-badge">Confirmed</span></div><p><%= grn.po_no %> · <%= grn.request_no %> · <%= grn.supplier_name %></p><h3><%= grn.item_name %> · <%= grn.item_code %></h3><div class="pu-grid"><p>Received<strong><%= fmt(grn.received_qty) %> <%= grn.unit %></strong></p><p>Rejected<strong><%= fmt(grn.rejected_qty) %> <%= grn.unit %></strong></p><p>Accepted / Stock In<strong>+<%= fmt(grn.accepted_qty) %> <%= grn.unit %></strong></p><p>Received By<strong><%= grn.received_name %> · <%= grn.created_at %></strong></p></div><p class="pu-preserve"><%= grn.note||'—' %></p><a class="pu-button outline" href="<%= base %>/grn?tab=history">← Received History</a><% if(appScope==='inventory'){ %><a class="pu-button outline" href="<%= base %>/materials">Raw Materials Stock Balance →</a><% } %></section>
<% }else if(page==='materials'){ %><div class="pu-table"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Category</th><th>Unit</th><th>Opening</th><th>Closing</th><th>Reorder</th><th>Action</th></tr></thead><tbody><% for(const m of materials){ %><tr><td><%= m.code %></td><td><%= m.name %></td><td><span class="pu-badge"><%= m.category %></span></td><td><%= m.unit %></td><td><%= fmt(m.opening_qty) %> 🔒</td><td><strong><%= fmt(m.stock_qty) %></strong></td><td><%= fmt(m.reorder_qty) %></td><td><a href="<%= base %>/materials/<%= m.id %>/ledger">View Ledger →</a></td></tr><% } %></tbody></table></div><% if(appScope==='inventory'){ %><details class="pu-card"><summary>＋ Add Raw Material</summary><form method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="pu-grid"><label>Item Code<input name="code" maxlength="100" required></label><label>Item Name<input name="name" maxlength="255" required></label><label>Category<input name="category" maxlength="100" required></label><label>Unit<select name="unit"><option>pcs</option><option>g</option></select></label><label>One-Time Opening Qty<input type="number" name="opening" min="0" max="999999999.999" step="0.001" value="0" required></label><label>Reorder Qty<input type="number" name="reorder" min="0" max="999999999.999" step="0.001" value="0" required></label></div><button>Save Material & Opening</button></form></details><% } %>
<% }else if(page==='material-ledger'){ %><section class="pu-card"><h2><%= material.code %> · <%= material.name %></h2><p>Main Warehouse · Closing: <strong><%= fmt(material.stock_qty) %> <%= material.unit %></strong></p><% for(const l of rows){ %><article class="pu-history"><header><strong><%= l.type %> · <%= l.reference %></strong><small><%= l.created_at %> · <%= l.actor_name %></small></header><p><%= l.note %></p><p>Movement: +<%= fmt(l.qty) %> <%= material.unit %> · Running Balance: <strong><%= fmt(l.balance_after) %> <%= material.unit %></strong></p></article><% } %></section>
<% }else if(page==='suppliers'){ %><div class="pu-table"><table><thead><tr><th>Supplier</th><th>Address</th><th>Contact</th></tr></thead><tbody><% for(const s of suppliers){ %><tr><td><strong><%= s.name %></strong></td><td><%= s.address %></td><td><%= s.contact %></td></tr><% } %></tbody></table></div><form class="pu-card" method="post"><h2>＋ Add Supplier</h2><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="pu-grid"><label>Supplier Name<input name="name" maxlength="255" required></label><label>Address<input name="address" maxlength="500"></label><label>Contact / Phone<input name="contact" maxlength="255"></label></div><button>Save Supplier</button></form><% } %>
<footer class="inventory-footer"><span>INNOCREATION · PURCHASING</span><span>Main Warehouse · MMK</span></footer></main></div></body></html>
