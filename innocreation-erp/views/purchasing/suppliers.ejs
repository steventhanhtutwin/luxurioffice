<% const statusName=s=>s==='VOID'?'Void':'Active';const statusClass=s=>s==='VOID'?'negative':'positive';const link=(sid,t)=>base+'/suppliers?'+new URLSearchParams({supplier:String(sid),tab:t,q:search,status:statusFilter}).toString(); const val=(k,fallback='')=>supplierValues[k]!==undefined?supplierValues[k]:fallback; %>
<div class="sd-toolbar"><form method="get" action="<%= base %>/suppliers"><input name="q" value="<%= search %>" placeholder="Search supplier name or phone…" aria-label="Search suppliers"><button>Search</button><details class="sd-search-filter" <%= statusFilter!=='ALL'?'open':'' %>><summary>Filter ▾</summary><label>Status<select name="status"><% for(const [key,title] of [['ALL','All'],['ACTIVE','Active'],['VOID','Void']]){ %><option value="<%= key %>" <%= statusFilter===key?'selected':'' %>><%= title %></option><% } %></select></label></details><a href="<%= base %>/suppliers" class="sd-reset">Reset</a></form><div class="sd-toolbar-actions"><a class="pu-button outline sd-download" href="<%= base %>/suppliers/export.xlsx?<%= new URLSearchParams({q:search,status:statusFilter}).toString() %>"><%- include('supplier-icon',{name:'download'}) %>Download Supplier List</a><button type="button" data-sd-open="sd-add-dialog">＋ Add Supplier</button></div></div>
<% if(supplierError){ %><p class="pu-warning" role="alert"><%= supplierError %></p><% } %>
<div class="sd-layout"><aside class="sd-list"><div class="sd-list-title">SUPPLIER DIRECTORY <span><%= suppliers.length %></span></div><% for(const s of suppliers){ %><a class="sd-supplier <%= selected&&String(selected.id)===String(s.id)?'active':'' %>" href="<%= link(s.id,tab) %>"><div class="sd-supplier-top"><small>SUP-<%= String(s.id).padStart(5,'0') %></small><span class="sd-status <%= statusClass(s.supplier_status) %>"><i aria-hidden="true"></i><%= statusName(s.supplier_status) %></span></div><strong><%= s.name %></strong><span class="sd-supplier-subtitle"><%= [s.category,s.country].filter(Boolean).join(' • ')||s.contact||'No contact added' %></span><div class="sd-supplier-bottom"><b class="sd-bank-count" aria-label="<%= s.bank_count %> Active Bank Accounts"><%- include('supplier-icon',{name:'bank'}) %><%= s.bank_count %> Bank Accounts</b><div class="sd-currencies"><% for(const currency of s.currencies){ %><span class="sd-currency <%= ['MMK','THB','SGD','USD'].includes(currency)?currency.toLowerCase():'other' %>"><%= currency %></span><% } %></div></div></a><% } %><% if(!suppliers.length){ %><p class="sd-empty">No matching suppliers.</p><% } %></aside>
<section class="sd-detail"><% if(selected){ %><header class="sd-detail-head"><div class="sd-head-actions"><button type="button" class="outline" data-sd-open="sd-edit-dialog">✎ Edit Supplier</button><form method="post" action="<%= base %>/suppliers/<%= selected.id %>/void" data-supplier-void><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="confirmed" value="0"><button type="submit" class="sd-delete" <%= registrationInfo.status==='VOID'?'disabled':'' %>><%- include('supplier-icon',{name:'trash'}) %> Delete</button></form></div><div class="sd-supplier-badges"><strong class="sd-code-badge">SUP-<%= String(selected.id).padStart(5,'0') %></strong><% if(registrationInfo.category){ %><span class="sd-category-badge"><%= registrationInfo.category %></span><% } %><span class="sd-status <%= statusClass(registrationInfo.status) %>"><i aria-hidden="true"></i><%= statusName(registrationInfo.status) %></span></div><h2><%= selected.name %></h2><div class="sd-header-meta"><span><%- include('supplier-icon',{name:'globe'}) %><%= profile.country||'Country not specified' %></span><i aria-hidden="true">•</i><span><%- include('supplier-icon',{name:'clock'}) %>Payment Terms: <strong><%= profile.payment_terms||'Not specified' %></strong></span></div></header><nav class="sd-tabs" aria-label="Supplier details"><% for(const [key,title] of [['banks','Bank Accounts'],['company','Company & Contacts'],['quotes','Quotation History']]){ %><a class="<%= tab===key?'active':'' %>" href="<%= link(selected.id,key) %>"><%- include('supplier-icon',{name:{banks:'bank',company:'company',quotes:'history'}[key]}) %><span><%= title %><%= key==='banks'?' ('+banks.filter(b=>b.is_active).length+')':'' %></span></a><% } %></nav><div class="sd-content">
<% if(tab==='company'){ %>

<div class="sd-contacts"><% for(const c of contacts){ const initials=c.contact_name.trim().split(/\s+/).slice(0,2).map(n=>n[0]||'').join('').toUpperCase(); %>
<article class="sd-contact"><div class="sd-contact-top"><span class="sd-contact-type"><%= c.contact_type %></span><span class="sd-avatar"><%= initials %></span></div><h3><%= c.contact_name %></h3><p class="muted"><%= c.position||'Position not specified' %><%= c.is_active?'':' · Inactive' %></p><div class="sd-contact-lines"><% for(const [label,value] of [['Email',c.email],['Phone',c.phone]]){ %><div><span><small class="sd-visually-hidden"><%= label %></small><strong><%= value||'Not added' %></strong></span><% if(value){ %><button type="button" class="sd-copy" data-sd-copy="<%= value %>" aria-label="Copy <%= label %>"><%- include('supplier-icon',{name:'copy'}) %></button><% } %></div><% } %></div><% if(c.note){ %><p class="pu-preserve"><%= c.note %></p><% } %></article>
<% } %></div><% if(!contacts.length){ %><p class="sd-empty">Contact မထည့်ရသေးပါ။</p><% } %>
<section class="sd-company"><h4>CORPORATE INFORMATION & PAYMENT TERMS</h4><div><span>Tax Registration ID</span><div class="sd-company-value"><strong class="sd-tax-number"><%= profile.tax_id||'Not specified' %></strong><% if(profile.tax_id){ %><button type="button" class="sd-copy" data-sd-copy="<%= profile.tax_id %>" aria-label="Copy Tax ID"><%- include('supplier-icon',{name:'copy'}) %></button><% } %></div></div><div><span>Standard Payment Terms</span><strong><%= profile.payment_terms||'Not specified' %></strong></div><div><span>Country</span><strong><%= profile.country||'Not specified' %></strong></div><div class="sd-company-address"><span>Registered Business Address</span><strong class="pu-preserve"><%= selected.address||'Not specified' %></strong></div><% if(profile.note){ %><div class="sd-company-address"><span>Notes</span><strong class="pu-preserve"><%= profile.note %></strong></div><% } %></section>
<% }else if(tab==='banks'){ %><div class="sd-banks"><% for(const b of banks){ %><article class="sd-bank <%= b.is_primary?'primary':'' %>"><div class="pu-heading"><span class="pu-badge"><%= b.is_active?(b.is_primary?'★ Primary Account':'Active Account'):'Inactive' %></span><strong><%= b.currency %></strong></div><h3><%= b.bank_name %></h3><div class="sd-account"><small>ACCOUNT HOLDER</small><strong><%= b.account_holder %></strong></div><div class="sd-account"><small>ACCOUNT NUMBER</small><strong><%= b.account_number %></strong></div><% if(b.swift){ %><div class="sd-account"><small>SWIFT / BIC</small><strong><%= b.swift %></strong></div><% } %><% if(b.note){ %><p class="pu-preserve"><%= b.note %></p><% } %></article><% } %></div><% if(!banks.length){ %><p class="sd-empty">Bank Account မထည့်ရသေးပါ။</p><% } %>
<% }else{ %><h3>Quotation History</h3><p class="muted">Latest 100 saved quotations · Total includes MOQ, discount and tax.</p><div class="pu-table"><table><thead><tr><th>Date / PR</th><th>Item / Qty</th><th>Unit Price</th><th>Discount / Tax</th><th>Total (MMK)</th><th>Selection</th></tr></thead><tbody><% for(const q of history){ %><tr><td><%= String(q.updated_at).slice(0,19) %><small><a href="<%= base %>/pr/<%= q.pr_id %>"><%= q.request_no %></a></small></td><td><strong><%= q.item_name %></strong><small><%= fmt(q.order_qty) %> <%= q.unit %></small></td><td><%= q.unit_price===null?'Awaiting Quote':fmt(q.unit_price) %></td><td><%= fmt(q.discount_amount) %> MMK<small>Tax <%= fmt(q.tax_percent) %>%</small></td><td><strong><%= q.pricing?fmt(q.pricing.total):'—' %></strong></td><td><span class="pu-badge"><%= String(q.selected_quote_id)===String(q.id)?'Selected':'Not Selected' %></span></td></tr><% } %><% if(!history.length){ %><tr><td colspan="6">Quotation မရှိသေးပါ။</td></tr><% } %></tbody></table></div><p class="muted">Saved quote တစ်ခု၏ လက်ရှိအချက်အလက်ကို ပြထားခြင်းဖြစ်သည်။ ပြင်ဆင်ခဲ့သမျှ version history မဟုတ်ပါ။</p><% } %>
</div><% }else{ %><p class="sd-empty">Supplier တစ်ဦးရွေးပါ သို့မဟုတ် Supplier အသစ်ထည့်ပါ။</p><% } %></section></div>
<%- include('supplier-dialogs') %>
<script src="/purchasing-suppliers.js?v=5" defer></script>
