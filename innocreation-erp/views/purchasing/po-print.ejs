<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= po.po_no %></title><% if(pdfMode){ %><style><%- css %></style><% }else{ %><link rel="stylesheet" href="/fg-print.css"><script src="/fg-print.js" defer></script><% } %><% if(typeof downloadMode!=='undefined'&&downloadMode){ %><%- include('../partials/pdf-download-assets') %><% } %></head><body><% if(typeof downloadMode!=='undefined'&&downloadMode){ %><%- include('../partials/pdf-download-panel',{fileName:po.po_no+'.pdf'}) %><% } %><% if(!pdfMode){ %><nav class="print-controls"><a href="<%= base %>/po/<%= po.id %>">← Back to PO</a><button id="print-document">Print / Save as PDF</button><a href="<%= base %>/po/<%= po.id %>/pdf">Download PDF</a></nav><% } %><main class="print-sheet"><header class="report-heading"><div><p class="brand">INNOCREATION</p><h1>Purchase Order</h1></div><div class="report-ref"><strong><%= po.po_no %></strong><span><%= po.request_no %></span><span><%= po.approved_at %></span></div></header><section class="report-facts"><div><span>SUPPLIER</span><strong><%= po.supplier_name %></strong><small><%= po.supplier_address %></small></div><div><span>DESTINATION</span><strong>Main Warehouse</strong></div><div><span>PAYMENT TERMS</span><strong><%= po.payment_terms %></strong></div><div><span>LEAD TIME</span><strong><%= po.lead_days %> business days</strong></div></section><table class="report-items"><thead><tr><th>Item Code</th><th>Item Name</th><th>Qty</th><th>Unit Price · MMK</th><th>Total · MMK</th></tr></thead><tbody><tr><td><%= po.item_code %></td><td><%= po.item_name %></td><td><%= po.qty %> <%= po.unit %></td><td><%= po.unit_price %></td><td><%= po.total %></td></tr></tbody></table><section class="report-approvals"><article><span>APPROVED BY</span><strong><%= po.approved_name %></strong><small><%= po.approved_at %></small></article></section></main></body></html>
