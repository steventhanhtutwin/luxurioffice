<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= po.po_no %></title><% if(pdfMode){ %><style><%- css %></style><% }else{ %><link rel="stylesheet" href="/fg-print.css"><link rel="stylesheet" href="/purchase-order-form.css?v=1"><script src="/fg-print.js" defer></script><% } %><% if(typeof downloadMode!=='undefined'&&downloadMode){ %><%- include('../partials/pdf-download-assets') %><% } %></head><body class="po-print-page"><% if(typeof downloadMode!=='undefined'&&downloadMode){ %><%- include('../partials/pdf-download-panel',{fileName:po.po_no+'.pdf'}) %><% } %><% if(!pdfMode){ %><nav class="print-controls"><a href="<%= base %>/po/<%= po.id %>">← Back to PO</a><button id="print-document">Print / Save as PDF</button><a href="<%= base %>/po/<%= po.id %>/pdf">Download PDF</a></nav><% } %><%- include('po-document',{po}) %></body></html>
