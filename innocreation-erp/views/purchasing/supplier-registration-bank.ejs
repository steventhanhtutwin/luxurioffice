<% const field=k=>'bank_'+index+'_'+k;const entry=k=>typeof values[field(k)]==='string'?values[field(k)]:''; %>
<article class="sd-registration-bank <%= primary?'primary':'' %>" data-registration-bank><div class="sd-registration-bank-top"><strong data-bank-number>Bank #<%= typeof index==='number'?index+1:'__NUMBER__' %></strong><label class="sd-primary-choice"><input type="radio" name="primary_bank" value="<%= index %>" <%= primary?'checked':'' %> required> Primary Payout Account</label><button type="button" class="outline" data-remove-registration-bank aria-label="Remove bank account">Remove</button></div><input type="hidden" data-bank-field="id" name="<%= field('id') %>" value="<%= entry('id') %>"><% if(editMode){ %><label class="sd-primary-choice"><input type="checkbox" data-bank-field="active" name="<%= field('active') %>" value="1" <%= entry('active')==='1'||!entry('id')?'checked':'' %>> Active Account</label><% } %><div class="sd-entry-grid">
<label>Account Label / Purpose <em>*</em><input data-bank-field="label" name="<%= field('label') %>" maxlength="255" value="<%= entry('label')||(primary?'Primary Settlement Account':'') %>" placeholder="e.g. Deposit payment account" required></label><label>Currency <em>*</em><select data-bank-field="currency" name="<%= field('currency') %>" required><% for(const currency of [...(editMode&&entry('currency')&&!CURRENCIES.includes(entry('currency'))?[entry('currency')]:[]),...CURRENCIES]){ %><option <%= (entry('currency')||'MMK')===currency?'selected':'' %>><%= currency %></option><% } %></select></label>
<label>Bank Name <em>*</em><select data-bank-field="name" name="<%= field('name') %>" required><option value="">Select Bank / Wallet</option><% for(const bank of [...(editMode&&entry('name')&&!BANKS.includes(entry('name'))?[entry('name')]:[]),...BANKS]){ %><option <%= entry('name')===bank?'selected':'' %>><%= bank %></option><% } %></select></label><label>Branch Name & City <small>(Optional)</small><input data-bank-field="branch" name="<%= field('branch') %>" maxlength="255" value="<%= entry('branch') %>" placeholder="Branch / city, if available"></label>
<label class="sd-span-all">Beneficiary / Account Holder Name <em>*</em><input data-bank-field="holder" name="<%= field('holder') %>" maxlength="255" value="<%= entry('holder') %>" required placeholder="Exact account holder name"></label><label>Account Number / IBAN <em>*</em><input data-bank-field="number" name="<%= field('number') %>" maxlength="100" value="<%= entry('number') %>" required placeholder="Account number / wallet phone"></label><label>SWIFT / BIC <small>(Optional)</small><input data-bank-field="swift" name="<%= field('swift') %>" maxlength="50" value="<%= entry('swift') %>" placeholder="If available"></label><label class="sd-span-all">Payment Notes <small>(Optional)</small><input data-bank-field="note" name="<%= field('note') %>" maxlength="500" value="<%= entry('note') %>" placeholder="Routing instructions or payment notes"></label></div></article>
