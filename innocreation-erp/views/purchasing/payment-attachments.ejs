<section class="pu-invoice-upload" data-invoice-upload data-endpoint="<%= base %>/settled/<%= p.id %>/attachments" data-download="<%= base %>/payment-attachments/"><div class="pu-invoice-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 16 8-8a3 3 0 0 0-4-4L3 13a5 5 0 0 0 7 7L20 10M6 14l8-8"/></svg><strong>Supplier Invoices &amp; Receipts Attachments <em>*</em></strong></div><input type="hidden" name="invoice_tokens" value="<%= JSON.stringify(paymentAttachmentDraft.map(r=>r.token)) %>"><textarea data-invoice-initial hidden><%= JSON.stringify(paymentAttachmentDraft) %></textarea><label class="pu-invoice-drop" data-invoice-drop><span class="pu-upload-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18H6a4 4 0 0 1-1-8 7 7 0 0 1 13-2 5 5 0 0 1 0 10h-1M12 21V9m-4 4 4-4 4 4"/></svg></span><strong>Click to upload or drag &amp; drop invoice files here</strong><small>Commercial Invoice, Tax Invoice or Delivery Receipt · PDF, JPG, PNG up to 10MB each · Max 5 files</small><input type="file" accept="application/pdf,image/jpeg,image/png" multiple data-invoice-files aria-label="Upload supplier invoices and receipts"></label><ul data-invoice-list></ul><p data-invoice-feedback role="status" aria-live="polite"></p></section>
