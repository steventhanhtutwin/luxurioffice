<% const qty=v=>{const [a,b='']=String(v??0).split('.'),t=b.replace(/0+$/,'');return a.replace(/\B(?=(\d{3})+(?!\d))/g,',')+(t?'.'+t:'');}; %>
<article class="po-paper pr-paper print-sheet" aria-label="Purchase Requisition Form"><header class="po-letterhead"><div class="po-company"><div class="po-monogram" aria-hidden="true">IN</div><strong>INNOCREATION</strong></div><h2>Purchase Requisition Form</h2></header><div class="pr-reference"><strong>PR: <%= r.request_no %></strong><span>Date: <%= r.created_at %></span></div>
<h3 class="pr-section-title">1. REQUISITION INFORMATION</h3><table class="po-facts pr-facts"><colgroup><col style="width:22%"><col style="width:26%"><col style="width:17%"><col style="width:35%"></colgroup><tbody><tr><th>Request By — Name</th><td><%= r.requested_name||'—' %></td><th>Department</th><td><%= r.warehouse %></td></tr><tr><th>Position</th><td><%= r.requested_position %></td><th>Purchase Type</th><td><%= r.priority==='NORMAL'?'☒':'☐' %> Normal &nbsp; <%= r.priority==='HIGH'?'☒':'☐' %> High &nbsp; <%= r.priority==='URGENT'?'☒':'☐' %> Urgent</td></tr><tr><th>Required Date</th><td><%= r.needed_by||'—' %></td><th rowspan="2">Attachments</th><td rowspan="2">☐ Specification<br>☐ Photo<br>☐ Other</td></tr><tr><th>Suggested Supplier<br>(optional)</th><td><% r.suggested_suppliers.forEach((name,i)=>{ %><div>[<%= ['A','B','C'][i] %>] <%= name %></div><% }); %></td></tr></tbody></table>
<h3 class="pr-section-title">2. ITEM DETAILS</h3><table class="po-items pr-items"><colgroup><col style="width:4%"><col style="width:13%"><col style="width:29%"><col style="width:7%"><col style="width:11%"><col style="width:12%"><col style="width:12%"><col style="width:12%"></colgroup><thead><tr><th>No.</th><th>Item Code</th><th>Item Description &amp; Specification</th><th>Unit</th><th>Requested Qty</th><th>Estimated Unit Price</th><th>Estimated Amount</th><th>Reason</th></tr></thead><tbody><tr><td class="po-number">1</td><td><%= r.item_code %></td><td><%= r.item_name %></td><td><%= r.unit %></td><td class="po-number"><%= qty(r.qty) %></td><td class="po-number"><%= r.estimated_price ? qty(r.estimated_price) : '' %></td><td class="po-number"><%= r.estimated_amount ? qty(r.estimated_amount) : '' %></td><td></td></tr><% for(let n=2;n<=12;n++){ %><tr class="po-blank-row"><td class="po-number"><%= n %></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr><% } %></tbody></table><div class="pr-summary"><p>Order Qty: <%= qty(r.display_order_qty??r.qty) %> <%= r.unit %></p><% if(r.estimated_qty&&Number(r.estimated_qty)>Number(r.display_order_qty??r.qty)){ %><p>Quote Order Qty: <%= qty(r.estimated_qty) %> <%= r.unit %></p><% } %><table class="po-totals"><tbody><tr><th>Subtotal:</th><td><%= r.estimated_amount?qty(r.estimated_amount):'' %></td></tr><tr><th>Discount (MMK):</th><td><%= r.estimate_pricing?qty(r.estimate_pricing.discount_amount):'' %></td></tr><tr><th>Tax (<%= r.estimate_pricing?qty(r.estimate_pricing.tax_percent):'0' %>%):</th><td><%= r.estimate_pricing?qty(r.estimate_pricing.tax_amount):'' %></td></tr><tr><th>Delivery Charges:</th><td>—</td></tr><tr class="po-grand-total"><th>Total Amt (MMK):</th><td><%= r.estimated_total?qty(r.estimated_total):'' %></td></tr></tbody></table></div>
<h3 class="pr-section-title">3. REMARKS / ADDITIONAL INFORMATION</h3><section class="po-reason pr-remarks"><p><%= r.remark||'' %></p></section>
<h3 class="pr-section-title">4. APPROVALS</h3><div class="po-signatures pr-signatures"><section><h3>Requested By</h3><div><p>Signature: __________________</p><p>Name: <%= r.requested_name||'' %></p><p>Position: <%= r.requested_position||'__________________' %></p><p>Date: <%= r.created_at %></p></div></section><section><h3>Budget Verified By<br>(Accountant Supervisor)</h3><div><p>Signature: __________________</p><p>Name: <%= r.finance_name||'__________________' %></p><p>Position: <%= r.finance_position||'__________________' %></p><p>Date: <%= r.finance_at||'__________________' %></p></div></section><section><h3>Approved By<br>(Authorized Person)</h3><div><p>Signature: __________________</p><p>Name: <%= r.approved_name||'__________________' %></p><p>Position: <%= r.approved_position||'__________________' %></p><p>Date: <%= r.approved_at||'__________________' %></p></div></section></div><footer class="po-form-footer">INNOCREATION · Purchase Requisition · <%= r.request_no %></footer></article>
