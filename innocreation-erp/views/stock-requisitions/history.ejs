<% const qs=n=>new URLSearchParams({...sr.filters,p:String(n)}).toString(); %>
<section class="sr-workspace"><div class="sr-title"><h1>Stock Requisitions History</h1></div><%- include('../partials/history-search',{action:'/inventory/stock-requisitions/history',f:sr.filters,showStatus:true,label:sr.label}) %>
<div class="sr-history-table sr-table-wrap"><table><thead><tr><th>Dispatch No.</th><th>Request No.</th><th>Prepared By &amp; Time</th><th>Dispatched By &amp; Time</th><th>Received By &amp; Time</th><th>Items / Qty</th><th>Status</th><th>Action</th></tr></thead><tbody><% for(const d of sr.rows){ %><tr data-row-href="/inventory/stock-requisitions/history/<%= d.requisition_id %>"><td><strong>DSP-<%= String(d.id).padStart(6,'0') %></strong></td><td><a href="/inventory/stock-requisitions/history/<%= d.requisition_id %>"><%= d.request_no %></a></td><td><%= d.created_name %><small><%= d.created_at %></small></td><td><%= d.approved_name||'—' %><small><%= d.approved_at||'—' %></small></td><td><%= d.received_name||'—' %><small><%= d.received_at||'—' %></small></td><td><strong><%= d.total_qty||0 %> pcs</strong><small><%= d.item_count %> items</small></td><td><span class="sr-badge"><%= sr.label(d.status) %></span></td><td><a class="sr-button secondary" href="/inventory/stock-requisitions/history/<%= d.requisition_id %>">View Request</a><% if(d.fg_document_id){ %><a href="/inventory/finished-goods/documents/<%= d.fg_document_id %>">FG Stock Out →</a><% } %></td></tr><% } %><% if(!sr.rows.length){ %><tr><td colspan="8">History မရှိသေးပါ။</td></tr><% } %></tbody></table><footer class="sr-history-pagination"><span><%= sr.total %> dispatch records · Page <%= sr.pageNo %></span><nav><% if(sr.pageNo>1){ %><a href="?<%= qs(sr.pageNo-1) %>">← Previous</a><% } %><% if(sr.pageNo*50<sr.total){ %><a href="?<%= qs(sr.pageNo+1) %>">Next →</a><% } %></nav></footer></div></section>
