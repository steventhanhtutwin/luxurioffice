<% const fmt=v=>{const [w,f='']=String(v??'0').split('.');const t=f.replace(/0+$/,'');return w.replace(/\B(?=(\d{3})+(?!\d))/g,',')+(t?'.'+t:'');}; %>
<section class="sr-workspace <%= sr.archived?'sr-archived':'' %>" data-sr-root data-csrf="<%= csrf %>"><div class="sr-title"><h1>Stock Requisitions</h1><span>Packaging → Main Warehouse</span></div>
<% if(!sr.print){ %><form class="sr-filter" method="get" action="/inventory/stock-requisitions"><input name="q" value="<%= sr.q %>" placeholder="Request No. / Requested By" aria-label="Search requisitions"><select name="status" aria-label="Filter status"><option value="">All Statuses</option><% for(const status of ['PENDING_WAREHOUSE_ISSUE','PENDING_SUPERVISOR_APPROVAL','PARTIALLY_DISPATCHED']){ %><option value="<%= status %>" <%= sr.status===status?'selected':'' %>><%= sr.label(status) %></option><% } %></select><button>Search</button><a href="/inventory/stock-requisitions">Reset</a></form><% } %>
<div class="sr-layout"><% if(!sr.print&&!sr.archived){ %><aside class="sr-queue"><header><strong>REQUISITION QUEUE</strong><small>Urgent first</small></header><% for(const r of sr.queue){ %><a class="sr-queue-card <%= String(sr.selected?.id)===String(r.id)?'active':'' %>" href="/inventory/stock-requisitions/<%= r.id %>?<%= new URLSearchParams({q:sr.q,status:sr.status,p:String(sr.pageNo)}).toString() %>"><strong><%= r.request_no %></strong><span class="sr-badge <%= r.priority==='URGENT'?'urgent':'' %>"><%= r.priority==='URGENT'?'Urgent':'Normal' %></span><span>From: Packaging Team</span><span><%= sr.label(r.status) %></span><footer><small><%= r.created_at %></small><b><%= r.item_count %> items</b></footer></a><% } %><% if(!sr.queue.length){ %><p>Request မရှိသေးပါ။</p><% } %><nav class="sr-pagination"><% if(sr.pageNo>1){ %><a href="/inventory/stock-requisitions?<%= new URLSearchParams({q:sr.q,status:sr.status,p:String(sr.pageNo-1)}).toString() %>">← Previous</a><% } %><% if(sr.queue.length===50){ %><a href="/inventory/stock-requisitions?<%= new URLSearchParams({q:sr.q,status:sr.status,p:String(sr.pageNo+1)}).toString() %>">Next →</a><% } %></nav></aside><% } %>
<div class="sr-main"><% if(sr.selected){ const r=sr.selected,pending=sr.history.find(d=>d.status==='PENDING'); %>
<header class="sr-detail-header"><div><h2><%= r.request_no %></h2><span class="sr-badge"><%= sr.label(r.status) %></span><span class="sr-badge <%= r.priority==='URGENT'?'urgent':'' %>"><%= r.priority==='URGENT'?'Urgent':'Normal' %></span><p>Requested By: <strong><%= r.requested_by %></strong> · <%= r.created_at %></p><p>Needed By: <%= r.needed_by||'—' %></p><% if(r.remark){ %><p class="sr-preserve">Remark: <%= r.remark %></p><% } %></div><% if(!sr.print){ %><div><a class="sr-button secondary" target="_blank" rel="noopener" href="/inventory/stock-requisitions/<%= r.id %>/print">Print Stock Requisitions</a></div><% } %></header>
<form data-sr-dispatch data-request="<%= r.id %>" data-key="<%= sr.requestKey %>"><div class="sr-table-wrap"><table><thead><tr><th>Item / Code</th><th>WH Stock</th><th>Requested</th><th>Dispatched</th><th>Received</th><th>Remaining</th><% if(!sr.print){ %><th>Dispatch Qty</th><th>Picked</th><% } %></tr></thead><tbody><% for(const l of sr.lines){const remaining=BigInt(l.remaining.split('.')[0]),stock=l.main_stock===null?null:BigInt(String(l.main_stock).split('.')[0]),stockError=stock===null?'Opening Stock ကို အရင်သတ်မှတ်ပါ။':stock<=0n?'Warehouse တွင် Stock မရှိသဖြင့် Dispatch လုပ်၍မရပါ။':'',editable=sr.canWrite&&!pending&&remaining>0n&&stock!==null&&stock>0n&&l.fg_item_id&&l.current_code===l.item_code; %><tr data-line-id="<%= l.id %>" data-main-stock="<%= stock===null?'':stock %>" data-remaining="<%= remaining %>"><td><strong><%= l.item_name %></strong><small><%= l.item_code||'Item Code မချိတ်ရသေးပါ' %></small><% if(!l.fg_item_id||l.current_code!==l.item_code){ %><small class="sr-error">Inventory Item Code ချိတ်ဆက်မှုကို စစ်ပါ။</small><% } %></td><td><%= l.main_stock===null?'—':fmt(l.main_stock) %><small data-stock-error class="sr-error" role="status" <%= stockError?'':'hidden' %>><%= stockError %></small></td><td><%= fmt(l.requested_qty) %></td><td><%= fmt(l.dispatched) %><small>In Transit: <%= fmt(l.in_transit) %></small></td><td><%= fmt(l.received) %></td><td><%= fmt(l.remaining) %></td><% if(!sr.print){ %><td><input type="number" data-qty min="0" max="<%= stock!==null&&stock<remaining?(stock>0n?stock:0n):remaining %>" step="1" value="0" aria-label="Dispatch Qty for <%= l.item_name %>" <%= editable?'':'disabled' %>></td><td><input data-picked type="checkbox" aria-label="Picked <%= l.item_name %>" <%= editable?'':'disabled' %>></td><% } %></tr><% } %></tbody></table></div>
<% if(!sr.print&&sr.canWrite&&!pending&&r.status!=='DISPATCHED'){ %><div class="sr-dispatch-footer"><label>Warehouse Handover / Shortage Notes<textarea data-note maxlength="500" rows="2"></textarea></label><div><strong data-dispatch-total>Total Dispatch Qty: 0 pcs</strong><button type="submit" disabled><%= sr.supervisor?'Dispatch Stock':'Submit for Supervisor Approval' %></button></div></div><% } %></form>
<% if(pending&&!sr.print){ %><p class="sr-info">Dispatch #<%= pending.id %> · Warehouse Supervisor approval စောင့်နေပါသည်။</p><% } %>
<section class="sr-history"><h2>Dispatch &amp; Receipt History</h2><% for(const d of sr.history){ %><article class="sr-history-card"><header><strong>DSP-<%= String(d.id).padStart(6,'0') %></strong><span class="sr-badge"><%= sr.label(d.status) %></span></header><p>Prepared: <%= d.created_name %> · <%= d.created_at %></p><% if(d.approved_at){ %><p>Approved: <%= d.approved_name %> · <%= d.approved_at %></p><% } %><% if(d.received_at){ %><p>Received: <%= d.received_name %> · <%= d.received_at %></p><% } %><ul><% for(const l of d.lines){ %><li><%= l.item_code %> · <%= l.item_name %> — <strong><%= fmt(l.qty) %> pcs</strong></li><% } %></ul><% if(d.note){ %><p class="sr-preserve">Handover: <%= d.note %></p><% } %><% if(d.rejection_reason){ %><p class="sr-error sr-preserve">Rejected: <%= d.rejection_reason %></p><% } %><% if(d.receipt_note){ %><p class="sr-preserve">Receipt note: <%= d.receipt_note %></p><% } %><% if(d.fg_document_id&&!sr.print){ %><a href="/inventory/finished-goods/documents/<%= d.fg_document_id %>">FG Stock Out Document →</a><% } %>
<% if(d.status==='PENDING'&&sr.supervisor&&!sr.print){ %><div class="sr-decision" data-dispatch-id="<%= d.id %>"><label>Reject reason (if rejecting)<input data-reason maxlength="500"></label><button type="button" data-decision="approve"><%= String(d.created_by)===sr.actorId?'Dispatch Now':'Approve & Dispatch Stock' %></button><button class="secondary" type="button" data-decision="reject">Reject</button></div><% } %></article><% } %><% if(!sr.history.length){ %><p>Dispatch မရှိသေးပါ။</p><% } %></section>
<% }else{ %><p class="sr-info">လက်ခံထားသော Request မရှိသေးပါ။</p><% } %></div></div><p data-sr-message class="sr-error" role="status" hidden></p></section>
