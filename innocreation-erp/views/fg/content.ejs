<% const f=fg,fgDirection=d=>Number(d.to_id)===Number(f.mainId)?'Stock In':Number(d.from_id)===Number(f.mainId)?'Stock Out':d.kind==='IN'?'Stock In':d.kind==='OUT'?'Stock Out':'Transfer',fmt=v=>v==null?'—':Number(v).toLocaleString('en-US',{maximumFractionDigits:0});const navLink=n=>{const qs=new URLSearchParams();for(const [k,v]of Object.entries(f.filters||{}))if(['q','category','status','kind','from','to'].includes(k)&&v)qs.set(k,v);qs.set('p',n);return '?'+qs;}; %>
<div class="fg-title"><div><p class="eyebrow">FINISHED GOODS / WAREHOUSE</p><h1><%= page.name %></h1><p class="muted">ကုန်ချောပစ္စည်းများ · Stock Qty ကို pcs ဖြင့် တွက်ချက်ပါသည်။</p></div><span class="fg-badge">STANDARD UNIT · pcs</span></div>
<% if(f.error){ %><div class="error" role="alert"><%= f.error %></div><% } %><% if(f.saved){ %><div class="fg-success" role="status">သိမ်းဆည်းပြီးပါပြီ။</div><% } %>
<% if(f.type==='stock'){const v=f.filters; %>
<div class="fg-stats"><article><small>Opening · pcs</small><strong><%= Number(f.totals.pending)?'စစ်ဆေးရန်ကျန်':fmt(f.totals.opening) %></strong></article><article><small>Stock In · pcs</small><strong><%= fmt(f.totals.stock_in) %></strong></article><article><small>Stock Out · pcs</small><strong><%= fmt(f.totals.stock_out) %></strong></article><article><small>Closing · pcs</small><strong><%= Number(f.totals.pending)?'စစ်ဆေးရန်ကျန်':fmt(f.totals.closing) %></strong></article></div><p class="fg-note">Closing = Opening + Stock In − Stock Out။ Transfer များကို Final Approval ပြီးမှ တွက်ချက်ပါသည်။ ဤစာရင်းတွင် Main Warehouse အတွက်သာ တွက်ချက်ထားပါသည်။</p><% if(Number(f.totals.pending)){ %><div class="fg-pending"><%= f.totals.pending %> item / warehouse အတွဲအတွက် Opening Qty နှင့် စတင်ရက် ဖြည့်ရန်ကျန်ပါသည်။</div><% } %>
<form class="fg-filters" method="get"><input name="q" value="<%= v.q %>" placeholder="Item Code / Name" aria-label="Search items"><select name="category" aria-label="Category"><option value="">All categories</option><% f.categories.forEach(c=>{ %><option <%= v.category===c.category?'selected':'' %>><%= c.category %></option><% }); %></select><span class="fg-badge">Main Warehouse</span><button>Filter</button><button class="fg-secondary" formaction="/inventory/finished-goods/list/export.xlsx">↓ Download Excel</button><a href="/inventory/finished-goods/<%= page.id %>">Reset</a></form>
<div class="fg-table-wrap"><table><thead><tr><th>Warehouse</th><th>Item Code</th><th>Item Name</th><th>Category</th><th>Size</th><th>Opening · pcs</th><th>Stock In · pcs</th><th>Stock Out · pcs</th><th>Closing · pcs</th><th>Start Date</th></tr></thead><tbody><% f.rows.forEach(i=>{ %><tr><td><%= i.warehouse %></td><td class="fg-code"><%= i.code %></td><td><%= i.name %></td><td><%= i.category %></td><td><%= i.size_label||'—' %></td><td><%= fmt(i.opening_qty) %></td><td><%= fmt(i.stock_in) %></td><td><%= fmt(i.stock_out) %></td><td><%= i.closing_qty===null?'Opening ဖြည့်ရန်':fmt(i.closing_qty) %></td><td><%= i.opening_date||'—' %></td></tr><% }); %><% if(!f.rows.length){ %><tr><td colspan="10">စာရင်းမတွေ့ပါ။ Location Setup ကို စစ်ပါ။</td></tr><% } %></tbody></table></div>
<% }else if(f.type==='entry'){const v=f.values; %>
<div class="fg-pending"><%= f.kind==='TRANSFER'?'Transfer တင်ပြီး → Warehouse Supervisor Approval → Warehouse Accountant Final Approval → Main Warehouse လက်ကျန်သာ ပြောင်းလဲမည်။':'ဤစာမျက်နှာသည် External နေရာနှင့် Warehouse အကြား အဝင်/အထွက်အတွက် ဖြစ်ပါသည်။ Warehouse အချင်းချင်းကို Transfer ဖြင့် လုပ်ပါ။' %></div>
<% if((f.kind==='TRANSFER'&&f.locations.filter(l=>['INTERNAL','EXTERNAL'].includes(l.type)).length<2)||(f.kind!=='TRANSFER'&&!f.locations.some(l=>l.type==='EXTERNAL'))){ %><div class="fg-pending">Admin မှ FG Locations ထဲတွင် Warehouse / Shop များကို INTERNAL၊ ပြင်ပနေရာများကို EXTERNAL အဖြစ် အရင်သတ်မှတ်ပါ။</div><% } %><form class="fg-form" method="post" id="fg-entry" data-kind="<%= f.kind %>" data-main-id="<%= f.mainId %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= v.request_key %>"><input type="hidden" name="lines" id="fg-lines" value="<%= v.lines||'[]' %>"><div class="fg-grid"><div><label for="doc-date">Date</label><input id="doc-date" type="date" name="date" value="<%= v.date %>" required></div><div><label for="reference">Vr No / Reference</label><input id="reference" name="reference" value="<%= v.reference||'' %>" maxlength="100" required></div><div><label for="from-location">From</label><select id="from-location" name="from_id" required><option value="">နေရာရွေးပါ</option><% f.locations.filter(l=>['INTERNAL','EXTERNAL'].includes(l.type)).forEach(l=>{ %><option value="<%= l.id %>" <%= String(v.from_id)===String(l.id)?'selected':'' %>><%= l.name %></option><% }); %></select></div><div><label for="to-location">To</label><select id="to-location" name="to_id" required><option value="">နေရာရွေးပါ</option><% f.locations.filter(l=>['INTERNAL','EXTERNAL'].includes(l.type)).forEach(l=>{ %><option value="<%= l.id %>" <%= String(v.to_id)===String(l.id)?'selected':'' %>><%= l.name %></option><% }); %></select></div><div class="fg-wide"><label for="doc-remark">Remark <%= f.kind==='TRANSFER'?'*':'' %></label><input id="doc-remark" name="remark" value="<%= v.remark||'' %>" maxlength="500" <%= f.kind==='TRANSFER'?'required':'' %>></div></div>
<p class="fg-note" id="fg-direction" role="status">Main Warehouse ကို ဝင်ရင် Stock In၊ ထွက်ရင် Stock Out ဖြစ်ပါသည်။</p><section class="fg-add-line"><h2>Add Items</h2><div class="fg-grid"><div><label for="fg-scan">Scan Item Code</label><input id="fg-scan" autocomplete="off" placeholder="FG-000253" maxlength="100"></div><div><label for="fg-item-name">Item Name / Size</label><input id="fg-item-name" autocomplete="off" placeholder="Type Item Name to search" maxlength="200"></div><div><label for="fg-qty">Qty · pcs</label><input id="fg-qty" type="number" min="1" max="999999999999" step="1"></div><div class="fg-add-button"><button id="fg-add" type="button" disabled>+ Add to List</button></div></div><p class="fg-note" id="fg-scan-status" role="status" aria-live="polite">Item Code scan ဖတ်ပါ သို့မဟုတ် Code / Item Name ဖြင့် ရှာပြီး ရွေးပါ။</p></section><div class="fg-table-wrap"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Qty · pcs</th><th>Action</th></tr></thead><tbody id="fg-line-body"></tbody></table></div><div class="fg-form-footer"><span id="fg-line-count">0 items</span><button type="submit" id="fg-submit"><%= f.kind==='TRANSFER'?'Submit Transfer':'Save Stock '+f.kind %></button></div></form><script src="/fg.js" defer></script>
<% }else if(f.type==='documents'){const v=f.filters; %>
<form class="fg-filters" method="get"><input name="q" value="<%= v.q %>" placeholder="Reference / From / To" aria-label="Search documents"><select name="status" aria-label="Status"><option value="">All statuses</option><% ['REQUESTED','SUPERVISOR_APPROVED','POSTED','REJECTED'].forEach(s=>{ %><option value="<%= s %>" <%= v.status===s?'selected':'' %>><%= statusLabel(s) %></option><% }); %></select><% if(!f.transfer){ %><select name="kind" aria-label="Type"><option value="">All types</option><% ['IN','OUT'].forEach(k=>{ %><option value="<%= k %>" <%= v.kind===k?'selected':'' %>><%= k==='IN'?'Stock In':'Stock Out' %></option><% }); %></select><% } %><label>From date<input type="date" name="from" value="<%= v.from %>"></label><label>To date<input type="date" name="to" value="<%= v.to %>"></label><button>Filter</button><button class="fg-secondary" type="submit" formaction="/inventory/finished-goods/<%= f.transfer?'transfers':'transactions' %>/export.xlsx">↓ Download Excel</button><a href="/inventory/finished-goods/<%= page.id %>">Reset</a></form><div class="fg-table-wrap"><table><thead><tr><th>ID</th><th>Date</th><th>Type</th><th>Reference</th><th>From</th><th>To</th><th>Status</th><th>Created By</th><th>Action</th></tr></thead><tbody><% f.rows.forEach(d=>{ %><tr><td>#<%= d.id %></td><td><%= d.day %></td><td><%= fgDirection(d) %></td><td><%= d.reference %></td><td><%= d.from_name %></td><td><%= d.to_name %></td><td><span class="fg-status fg-status-<%= d.status %>"><%= statusLabel(d.status) %></span></td><td><%= d.created_name %></td><td><a href="/inventory/finished-goods/documents/<%= d.id %>">View</a></td></tr><% }); %><% if(!f.rows.length){ %><tr><td colspan="9">မှတ်တမ်းမရှိသေးပါ။</td></tr><% } %></tbody></table></div>
<% }else if(f.type==='document'){const d=f.doc;const canSuper=user.role==='warehouse_supervisor'&&d.status==='REQUESTED';const canFinal=user.role==='warehouse_accountant'&&d.status==='SUPERVISOR_APPROVED'; %>
<section class="fg-form"><div class="fg-document-tools"><a href="/inventory/finished-goods/documents/<%= d.id %>/print?autoprint=1" target="_blank" rel="noopener">Print</a><a href="/inventory/finished-goods/documents/<%= d.id %>/pdf">↓ Download PDF</a></div><div class="fg-document-heading"><h2><%= fgDirection(d) %> #<%= d.id %></h2><span class="fg-status fg-status-<%= d.status %>"><%= statusLabel(d.status) %></span></div><div class="fg-facts"><p><small>Reference</small><strong><%= d.reference %></strong></p><p><small>Date</small><strong><%= d.day %></strong></p><p><small>From</small><strong><%= d.from_name %></strong></p><p><small>To</small><strong><%= d.to_name %></strong></p><p><small>Created By</small><strong><%= d.created_name %></strong></p><p><small>Remark</small><strong><%= d.remark||'—' %></strong></p></div>
<% if(d.kind==='TRANSFER'){ %><div class="fg-steps"><article><small>01 · SUBMITTED</small><strong><%= d.created_name %></strong><span><%= d.created_at %></span></article><article><small>02 · SUPERVISOR</small><strong><%= d.supervisor_name||'Waiting' %></strong><span><%= d.supervisor_at||'Warehouse Supervisor Approval' %></span></article><article><small>03 · FINAL APPROVAL</small><strong><%= d.final_name||'Waiting' %></strong><span><%= d.final_at||'Warehouse Accountant Approval' %></span></article></div><p class="fg-note"><%= d.status==='POSTED'?'Final Approval ပြီးပါပြီ။ Main Warehouse လက်ကျန်တွင် ပေါင်း/နှုတ်ပြီးပါပြီ။':'Final Approval မပြီးသေးသဖြင့် လက်ကျန်တွင် ပေါင်း/နှုတ်ခြင်း မရှိသေးပါ။' %></p><% } %>
<div class="fg-table-wrap"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Category</th><th>Size</th><th>Qty · pcs</th></tr></thead><tbody><% f.lines.forEach(l=>{ %><tr><td><%= l.code %></td><td><%= l.name %></td><td><%= l.category %></td><td><%= l.size_label||'—' %></td><td><%= fmt(l.qty) %></td></tr><% }); %></tbody></table></div>
<% if(d.status==='REJECTED'){ %><div class="fg-pending">Rejected by <%= d.rejected_name %> · <%= d.rejection_reason %></div><% } %>
<% if(canSuper||canFinal){ %><div class="fg-approval"><form method="post" action="/inventory/finished-goods/documents/<%= d.id %>/<%= canSuper?'supervisor':'final' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button><%= canSuper?'Supervisor Approved':'Final Approval & Post Stock' %></button></form><details><summary>Reject Transfer</summary><form method="post" action="/inventory/finished-goods/documents/<%= d.id %>/reject"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="reject-reason">Reject reason *</label><input id="reject-reason" name="reason" maxlength="500" required><button class="fg-secondary">Reject</button></form></details></div><% } %></section>
<% }else if(f.type==='opening'){const v=f.values; %><p class="fg-note">Main Warehouse စာရင်းစတင်ရက် မတိုင်မီရှိသော လက်ကျန်အမှန်ကို ဖြည့်ပါ။ Posted Transaction ရှိပြီးပါက ပြင်မရပါ။</p><form class="fg-form" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="fg-grid"><div><label for="opening-code">Item Code</label><input id="opening-code" name="code" value="<%= v.code||'' %>" maxlength="100" required></div><div><label for="opening-warehouse">Warehouse</label><select id="opening-warehouse" name="location_id" required><option value="">Warehouse ရွေးပါ</option><% f.locations.filter(l=>l.type==='INTERNAL').forEach(l=>{ %><option value="<%= l.id %>" <%= String(v.location_id)===String(l.id)?'selected':'' %>><%= l.name %></option><% }); %></select></div><div><label for="opening-qty">Opening Qty · pcs</label><input id="opening-qty" name="qty" type="number" min="0" max="999999999999" step="1" value="<%= v.qty||'' %>" required></div><div><label for="opening-date">စာရင်းစတင်ရက်</label><input id="opening-date" name="date" type="date" value="<%= v.date||'' %>" required></div><div class="fg-wide"><label for="opening-remark">Remark *</label><input id="opening-remark" name="remark" value="<%= v.remark||'' %>" maxlength="500" required></div></div><button>Save Opening</button></form>
<% }else if(f.type==='locations'){ %><p class="fg-note">INTERNAL = လက်ကျန်တွက်မည့် Warehouse / Shop။ EXTERNAL = ပြင်ပအဝင် / အထွက် နေရာ။ UNASSIGNED = မသတ်မှတ်ရသေးပါ။ အသုံးပြုပြီးသော Type ကို ပြောင်းမရပါ။</p><form class="fg-form fg-location-add" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="new-place">နေရာအသစ်</label><input id="new-place" name="name" maxlength="120" required><label for="new-type">Type</label><select id="new-type" name="type" required><option value="INTERNAL">INTERNAL</option><option value="EXTERNAL">EXTERNAL</option><option value="UNASSIGNED">UNASSIGNED</option></select><button>Add Location</button></form><div class="fg-location-list"><% f.locations.forEach(l=>{ %><form method="post" class="fg-location-row"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= l.id %>"><label><span>Location</span><input name="name" maxlength="120" value="<%= l.name %>" required></label><label><span>Type</span><select name="type"><% ['INTERNAL','EXTERNAL','UNASSIGNED'].forEach(t=>{ %><option <%= t===l.type?'selected':'' %>><%= t %></option><% }); %></select></label><button>Save</button></form><% }); %></div><% } %>
<% if(['stock','documents'].includes(f.type)){ %><div class="fg-pagination"><span><%= f.total %> rows · Page <%= f.pageNo %></span><div><% if(f.pageNo>1){ %><a href="<%= navLink(f.pageNo-1) %>">← Previous</a><% } %><% if(f.pageNo*50<f.total){ %><a href="<%= navLink(f.pageNo+1) %>">Next →</a><% } %></div></div><% } %>
