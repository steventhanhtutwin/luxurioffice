<% const f=fg,fgDirection=d=>Number(d.to_id)===Number(f.mainId)?'Stock In':Number(d.from_id)===Number(f.mainId)?'Stock Out':d.kind==='IN'?'Stock In':d.kind==='OUT'?'Stock Out':'Transfer',fmt=v=>v==null?'—':Number(v).toLocaleString('en-US',{maximumFractionDigits:0});const navLink=n=>{const qs=new URLSearchParams();for(const [k,v]of Object.entries(f.filters||{}))if(['q','category','status','kind','from','to'].includes(k)&&v)qs.set(k,v);qs.set('p',n);return '?'+qs;}; %>
<div class="fg-title"><div><h1><%= page.name %></h1><p class="muted">ကုန်ချောပစ္စည်းများ · Stock Qty ကို pcs ဖြင့် တွက်ချက်ပါသည်။</p></div><div class="fg-title-actions"><% if(f.type==='documents'&&page.id==='transactions'){ %><button type="submit" class="fg-header-export" form="fg-document-filters" formaction="/inventory/finished-goods/transactions/export.xlsx">↓ Download Excel</button><% if(['admin','inventory','warehouse_supervisor'].includes(user.role)){ %><a href="/inventory/finished-goods/transfer" class="fg-new-transfer">＋ New Transfer</a><% } %><% } %><span class="fg-badge"><%= f.type==='stock'?'One-Time Opening Lock':'STANDARD UNIT · pcs' %></span></div></div>
<% if(f.error){ %><div class="error" role="alert"><%= f.error %></div><% } %><% if(f.saved){ %><div class="fg-success" role="status">သိမ်းဆည်းပြီးပါပြီ။</div><% } %>
<% if(f.type==='stock'){const v=f.filters; %>
<%- include('stock-list',{f,v,user,csrf,fmt}) %>
<% }else if(f.type==='entry'){const v=f.values; %>
<div class="fg-pending"><%= f.kind==='TRANSFER'?'Transfer တင်ပြီး → Warehouse Supervisor Approval → Warehouse Accountant Final Approval → Main Warehouse လက်ကျန်သာ ပြောင်းလဲမည်။':'ဤစာမျက်နှာသည် External နေရာနှင့် Warehouse အကြား အဝင်/အထွက်အတွက် ဖြစ်ပါသည်။ Warehouse အချင်းချင်းကို Transfer ဖြင့် လုပ်ပါ။' %></div>
<% if((f.kind==='TRANSFER'&&f.locations.filter(l=>['INTERNAL','EXTERNAL'].includes(l.type)).length<2)||(f.kind!=='TRANSFER'&&!f.locations.some(l=>l.type==='EXTERNAL'))){ %><div class="fg-pending">Admin မှ Configuration → Warehouses ထဲတွင် Warehouse စာရင်းကို စစ်ဆေးပါ။</div><% } %><form class="fg-form" method="post" id="fg-entry" data-kind="<%= f.kind %>" data-main-id="<%= f.mainId %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_key" value="<%= v.request_key %>"><input type="hidden" name="lines" id="fg-lines" value="<%= v.lines||'[]' %>"><div class="fg-grid"><div><label for="doc-date">Date</label><input id="doc-date" type="date" name="date" value="<%= v.date %>" required></div><div><label for="reference">Vr No / Reference</label><input id="reference" name="reference" value="<%= v.reference||'' %>" maxlength="100" required></div><div><label for="from-location">From</label><select id="from-location" name="from_id" required><option value="">နေရာရွေးပါ</option><% f.locations.filter(l=>['INTERNAL','EXTERNAL'].includes(l.type)).forEach(l=>{ %><option value="<%= l.id %>" <%= String(v.from_id)===String(l.id)?'selected':'' %>><%= l.name %></option><% }); %></select></div><div><label for="to-location">To</label><select id="to-location" name="to_id" required><option value="">နေရာရွေးပါ</option><% f.locations.filter(l=>['INTERNAL','EXTERNAL'].includes(l.type)).forEach(l=>{ %><option value="<%= l.id %>" <%= String(v.to_id)===String(l.id)?'selected':'' %>><%= l.name %></option><% }); %></select></div><div class="fg-wide"><label for="doc-remark">Remark <%= f.kind==='TRANSFER'?'*':'' %></label><input id="doc-remark" name="remark" value="<%= v.remark||'' %>" maxlength="500" <%= f.kind==='TRANSFER'?'required':'' %>></div></div>
<p class="fg-note" id="fg-direction" role="status">Main Warehouse ကို ဝင်ရင် Stock In၊ ထွက်ရင် Stock Out ဖြစ်ပါသည်။</p><section class="fg-add-line"><h2>Add Items</h2><div class="fg-grid"><div><label for="fg-scan">Scan Item Code</label><input id="fg-scan" value="<%= v.prefill_code||'' %>" autocomplete="off" placeholder="FG-000253" maxlength="100"></div><div><label for="fg-item-name">Item Name / Size</label><input id="fg-item-name" autocomplete="off" placeholder="Type Item Name to search" maxlength="200"></div><div><label for="fg-qty">Qty · pcs</label><input id="fg-qty" type="number" min="1" max="999999999999" step="1"></div><div class="fg-add-button"><button id="fg-add" type="button" disabled>+ Add to List</button></div></div><p class="fg-note" id="fg-scan-status" role="status" aria-live="polite">Item Code scan ဖတ်ပါ သို့မဟုတ် Code / Item Name ဖြင့် ရှာပြီး ရွေးပါ။</p></section><div class="fg-table-wrap"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Qty · pcs</th><th>Action</th></tr></thead><tbody id="fg-line-body"></tbody></table></div><div class="fg-form-footer"><span id="fg-line-count">0 items</span><button type="submit" id="fg-submit"><%= f.kind==='TRANSFER'?'Submit Transfer':'Save Stock '+f.kind %></button></div></form><script src="/fg.js?v=inventory-live-1" defer></script>
<% }else if(f.type==='documents'){const v=f.filters; %>
<form id="fg-document-filters" class="fg-document-filters <%= f.transfer?'is-approval':'' %>" method="get"><label class="fg-filter-search">Search<input name="q" value="<%= v.q %>" placeholder="Reference / From / To" aria-label="Search documents"></label><label>Status<select name="status" aria-label="Status"><option value="">All statuses</option><% ['REQUESTED','SUPERVISOR_APPROVED','POSTED','REJECTED'].forEach(s=>{ %><option value="<%= s %>" <%= v.status===s?'selected':'' %>><%= statusLabel(s) %></option><% }); %></select></label><% if(!f.transfer){ %><label>Type<select name="kind" aria-label="Type"><option value="">All types</option><% ['IN','OUT'].forEach(k=>{ %><option value="<%= k %>" <%= v.kind===k?'selected':'' %>><%= k==='IN'?'Stock In':'Stock Out' %></option><% }); %></select></label><% } %><label>From date<input type="date" name="from" value="<%= v.from %>"></label><label>To date<input type="date" name="to" value="<%= v.to %>"></label><div class="fg-filter-actions"><button type="submit" class="fg-filter-search-button">Search</button><% if(f.transfer){ %><button class="fg-filter-export" type="submit" formaction="/inventory/finished-goods/transfers/export.xlsx">↓ Download Excel</button><% } %><a href="/inventory/finished-goods/<%= page.id %>">Reset</a></div></form><div class="fg-table-wrap"><table><thead><tr><th>ID</th><th>Date</th><th>Type</th><th>Reference</th><th>From</th><th>To</th><th>Status</th><th>Created By</th><th>Action</th></tr></thead><tbody><% f.rows.forEach(d=>{ %><tr><td>#<%= d.id %></td><td><%= d.day %></td><td><%= fgDirection(d) %></td><td><%= d.reference %></td><td><%= d.from_name %></td><td><%= d.to_name %></td><td><span class="fg-status fg-status-<%= d.status %>"><%= statusLabel(d.status) %></span></td><td><%= d.created_name %></td><td><a href="/inventory/finished-goods/documents/<%= d.id %>">View</a></td></tr><% }); %><% if(!f.rows.length){ %><tr><td colspan="9">မှတ်တမ်းမရှိသေးပါ။</td></tr><% } %></tbody></table></div>
<% }else if(f.type==='document'){const d=f.doc;const canSuper=user.role==='warehouse_supervisor'&&d.status==='REQUESTED';const canFinal=user.role==='warehouse_accountant'&&d.status==='SUPERVISOR_APPROVED'; %>
<section class="fg-form"><div class="fg-document-tools"><a href="/inventory/finished-goods/documents/<%= d.id %>/print?autoprint=1" target="_blank" rel="noopener">Print</a><a href="/inventory/finished-goods/documents/<%= d.id %>/pdf">↓ Download PDF</a></div><div class="fg-document-heading"><h2><%= fgDirection(d) %> #<%= d.id %></h2><span class="fg-status fg-status-<%= d.status %>"><%= statusLabel(d.status) %></span></div><div class="fg-facts"><p><small>Reference</small><strong><%= d.reference %></strong></p><p><small>Date</small><strong><%= d.day %></strong></p><p><small>From</small><strong><%= d.from_name %></strong></p><p><small>To</small><strong><%= d.to_name %></strong></p><p><small>Created By</small><strong><%= d.created_name %></strong></p><p><small>Remark</small><strong><%= d.remark||'—' %></strong></p></div>
<% if(d.kind==='TRANSFER'){ %><div class="fg-steps"><article><small>01 · SUBMITTED</small><strong><%= d.created_name %></strong><span><%= d.created_at %></span></article><article><small>02 · SUPERVISOR</small><strong><%= d.supervisor_name||'Waiting' %></strong><span><%= d.supervisor_at||'Warehouse Supervisor Approval' %></span></article><article><small>03 · FINAL APPROVAL</small><strong><%= d.final_name||'Waiting' %></strong><span><%= d.final_at||'Warehouse Accountant Approval' %></span></article></div><p class="fg-note"><%= d.status==='POSTED'?'Final Approval ပြီးပါပြီ။ Main Warehouse လက်ကျန်တွင် ပေါင်း/နှုတ်ပြီးပါပြီ။':'Final Approval မပြီးသေးသဖြင့် လက်ကျန်တွင် ပေါင်း/နှုတ်ခြင်း မရှိသေးပါ။' %></p><% } %>
<div class="fg-table-wrap"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Category</th><th>Size</th><th>Qty · pcs</th></tr></thead><tbody><% f.lines.forEach(l=>{ %><tr><td><%= l.code %></td><td><%= l.name %></td><td><%= l.category %></td><td><%= l.size_label||'—' %></td><td><%= fmt(l.qty) %></td></tr><% }); %></tbody></table></div>
<% if(d.status==='REJECTED'){ %><div class="fg-pending">Rejected by <%= d.rejected_name %> · <%= d.rejection_reason %></div><% } %>
<% if(canSuper||canFinal){ %><div class="fg-approval"><form method="post" action="/inventory/finished-goods/documents/<%= d.id %>/<%= canSuper?'supervisor':'final' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button><%= canSuper?'Supervisor Approved':'Final Approval & Post Stock' %></button></form><details><summary>Reject Transfer</summary><form method="post" action="/inventory/finished-goods/documents/<%= d.id %>/reject"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="reject-reason">Reject reason *</label><input id="reject-reason" name="reason" maxlength="500" required><button class="fg-secondary">Reject</button></form></details></div><% } %></section>
<% } %>
