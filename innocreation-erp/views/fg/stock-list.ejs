<section class="fg-stock-screen"><p class="fg-stock-equation">Opening + Stock In − Stock Out = Closing · Main Warehouse</p>
<form class="fg-stock-toolbar" method="get" action="/inventory/finished-goods/list"><div class="fg-stock-search"><span aria-hidden="true">⌕</span><input name="q" value="<%= v.q %>" placeholder="Search Item Code / Item Name…" aria-label="Search items"><button>Search</button><details><summary aria-label="Custom Filter">▾</summary><div class="fg-stock-options"><label>Category<select name="category"><option value="">All Categories</option><% for(const c of f.categories){ %><option <%= v.category===c.category?'selected':'' %>><%= c.category %></option><% } %></select></label><button>Apply Filter</button></div></details></div><button class="fg-stock-export" formaction="/inventory/finished-goods/list/export.xlsx">↓ Download Excel</button><a href="/inventory/finished-goods/list">Reset</a><small><%= f.total %> items</small></form>
<div class="fg-table-wrap fg-stock-table"><table><thead><tr><th>Item Code</th><th>Item Name</th><th>Category</th><th>Size</th><th>Opening <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/></svg></th><th>Stock In</th><th>Stock Out</th><th>Closing</th><th>Action</th></tr></thead><tbody><% for(const i of f.rows){ %><tr><td class="fg-code"><%= i.code %></td><td><%= i.name %></td><td><span class="fg-category-chip"><%= i.category %></span></td><td><%= i.size_label||'—' %></td><td><% if(i.opening_qty===null){if(['admin','warehouse_supervisor','warehouse_accountant'].includes(user.role)){ %><button type="button" class="fg-opening-trigger" data-fg-opening="<%= i.code %>" data-item-name="<%= i.name %>">＋ Set Opening</button><% }else{ %><span class="muted">Opening ဖြည့်ရန်</span><% }}else{ %><span class="fg-opening-locked"><strong><%= fmt(i.opening_qty) %></strong><span title="Opening locked" aria-label="Opening locked"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/></svg></span></span><% } %></td><td><span class="fg-stock-in">+<%= fmt(i.stock_in) %></span></td><td><span class="fg-stock-out">−<%= fmt(i.stock_out) %></span></td><td><strong><%= fmt(i.closing_qty) %></strong></td><td><button type="button" class="fg-ledger-trigger" data-ledger-id="<%= i.id %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="6" y="5" width="13" height="16" rx="2"/><rect x="9" y="2" width="7" height="5" rx="2" fill="white"/></svg><span>View Ledger</span></button></td></tr><% } %><% if(!f.rows.length){ %><tr><td colspan="9">စာရင်းမတွေ့ပါ။</td></tr><% } %></tbody></table></div>
<dialog id="fg-opening-dialog" aria-labelledby="fg-opening-dialog-title"><form method="post" action="/inventory/finished-goods/opening"><header><h2 id="fg-opening-dialog-title">Set Opening</h2><button type="button" data-fg-opening-close aria-label="Close opening form">×</button></header><p data-fg-opening-name></p><p class="fg-opening-warning">Opening ကို တစ်ကြိမ်သာ သိမ်းနိုင်ပါသည်။ Save ပြီးပါက ပြန်ပြင်၍ မရပါ။</p><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="return_list" value="1"><input type="hidden" name="location_id" value="<%= f.mainId %>"><input type="hidden" name="code"><label>Opening Qty · pcs<input type="number" name="qty" min="0" max="999999999999" step="1" required></label><label>Remark *<input name="remark" maxlength="500" required></label><small>ရက်စွဲနှင့်အချိန်ကို အလိုအလျောက် သတ်မှတ်မည်။</small><footer><button type="button" data-fg-opening-close>Cancel</button><button>Save Opening</button></footer></form></dialog>
<dialog id="stock-ledger" aria-labelledby="stock-ledger-title"><header><div id="stock-ledger-meta"></div><button type="button" data-ledger-close aria-label="Close ledger">×</button><h2 id="stock-ledger-title">Item Ledger</h2></header><div id="stock-ledger-totals"></div><nav class="stock-ledger-tabs" aria-label="Ledger filters"><strong>Movement Ledger</strong><button type="button" data-ledger-type="ALL">All</button><button type="button" data-ledger-type="IN">Stock In</button><button type="button" data-ledger-type="OUT">Stock Out</button></nav><div id="stock-ledger-rows" aria-live="polite"></div></dialog>
</section>