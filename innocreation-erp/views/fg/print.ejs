<!doctype html><html lang="my"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FG Transfer <%= doc.reference %> - <%= doc.id %></title><% if(pdfMode){ %><style><%- css %></style><% }else{ %><link rel="stylesheet" href="/fg-print.css"><script src="/fg-print.js" defer></script><% } %></head><body><% if(!pdfMode){ %><nav class="print-controls"><a href="/inventory/finished-goods/documents/<%= doc.id %>">← Back to document</a><button id="print-document" type="button">Print / Save as PDF</button><a class="pdf-download" href="/inventory/finished-goods/documents/<%= doc.id %>/pdf">Download PDF</a></nav><% } %><main class="print-sheet"><header class="report-heading"><div><p class="brand">INNOCREATION</p><p class="report-label">FG STOCK TRANSFER</p><h1><%= direction %></h1></div><div class="report-ref"><strong><%= doc.reference %></strong><span>Document #<%= doc.id %></span><span><%= doc.day %></span><span class="report-status"><%= statusLabel(doc.status) %></span></div></header><section class="report-facts"><div><span>FROM</span><strong><%= doc.from_name %></strong></div><div><span>TO</span><strong><%= doc.to_name %></strong></div><div><span>CREATED BY</span><strong><%= doc.created_name %></strong></div><div><span>CREATED AT</span><strong><%= doc.created_at||'—' %></strong></div></section><section class="report-remark"><span>REMARK</span><p><%= doc.remark||'—' %></p></section><p class="posting-note"><%= doc.status==='POSTED'?'Posted document.':doc.status==='REJECTED'?'Rejected document. No stock posted.':'Pending approval. No stock posted.' %> · Stock unit: pcs</p><table class="report-items"><colgroup><col class="col-number"><col class="col-code"><col class="col-name"><col class="col-category"><col class="col-size"><col class="col-qty"></colgroup><thead><tr><th>No.</th><th>Item Code</th><th>Item Name</th><th>Category</th><th>Size</th><th class="qty">Qty · pcs</th></tr></thead><tbody><% lines.forEach((line,index)=>{ %><tr><td><%= index+1 %></td><td class="item-code"><%= line.code %></td><td><%= line.name %></td><td><%= line.category %></td><td><%= line.size_label||'—' %></td><td class="qty"><%= Number(line.qty).toLocaleString('en-US') %></td></tr><% }); %></tbody><tfoot><tr><td colspan="5">Total · <%= lines.length %> items</td><td class="qty"><%= lines.reduce((sum,l)=>sum+BigInt(l.qty),0n).toLocaleString('en-US') %></td></tr></tfoot></table><section class="report-approvals"><article><span>PREPARED BY</span><strong><%= doc.created_name %></strong><small><%= doc.created_at||'—' %></small></article><article><span>WAREHOUSE SUPERVISOR</span><strong><%= doc.supervisor_name||'Pending' %></strong><small><%= doc.supervisor_at||'—' %></small></article><article><span>WAREHOUSE ACCOUNTANT</span><strong><%= doc.final_name||'Pending' %></strong><small><%= doc.final_at||'—' %></small></article></section><% if(doc.status==='REJECTED'){ %><section class="report-rejection"><strong>Rejected by <%= doc.rejected_name||'—' %></strong><p><%= doc.rejection_reason||'—' %></p><small><%= doc.rejected_at||'' %></small></section><% } %><footer class="report-footer">Generated from Innocreation ERP · Recorded approvals shown above.</footer></main></body></html>
